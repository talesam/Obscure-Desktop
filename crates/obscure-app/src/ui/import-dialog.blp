using Gtk 4.0;
using Adw 1;

template $ObscureImportDialog: Adw.Dialog {
  title: _("Add Server");
  content-width: 480;
  content-height: 420;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button {
        label: _("Cancel");
        action-name: "window.close";
      }

      [end]
      Button import_button {
        label: _("Add");
        sensitive: false;
        clicked => $on_import_clicked() swapped;

        styles [
          "suggested-action",
        ]
      }
    }

    content: Box {
      orientation: vertical;
      spacing: 12;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;

      Label {
        label: _("Paste server links (one per line) or the address of your subscription.");
        wrap: true;
        xalign: 0;

        styles [
          "dim-label",
        ]
      }

      ScrolledWindow {
        vexpand: true;
        hscrollbar-policy: never;

        styles [
          "card",
        ]

        TextView text_view {
          wrap-mode: char;
          top-margin: 8;
          bottom-margin: 8;
          left-margin: 8;
          right-margin: 8;
          monospace: true;
        }
      }

      Box {
        orientation: horizontal;
        spacing: 6;
        halign: center;

        Button paste_button {
          clicked => $on_paste_clicked() swapped;

          Adw.ButtonContent {
            icon-name: "edit-paste-symbolic";
            label: _("Paste");
          }
        }

        Button qr_image_button {
          tooltip-text: _("Read a QR code from an image file");
          clicked => $on_qr_image_clicked() swapped;

          Adw.ButtonContent {
            icon-name: "image-x-generic-symbolic";
            label: _("QR from Image");
          }
        }

        Button qr_screen_button {
          tooltip-text: _("Take a screenshot and read the QR code in it");
          clicked => $on_qr_screen_clicked() swapped;

          Adw.ButtonContent {
            icon-name: "camera-photo-symbolic";
            label: _("QR from Screen");
          }
        }
      }

      Label hint_label {
        wrap: true;
        xalign: 0;
        visible: false;

        styles [
          "caption",
          "dim-label",
        ]
      }
    };
  };
}
