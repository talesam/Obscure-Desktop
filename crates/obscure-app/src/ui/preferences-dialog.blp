using Gtk 4.0;
using Adw 1;

Adw.PreferencesDialog preferences_dialog {
  title: _("Preferences");
  content-width: 560;
  content-height: 480;

  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Connection");
      description: _("Connection options will be available in the next stage of the project.");
    }
  }
}
