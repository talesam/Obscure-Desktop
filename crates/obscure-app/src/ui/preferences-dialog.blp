using Gtk 4.0;
using Adw 1;

template $ObscurePreferencesDialog: Adw.PreferencesDialog {
  title: _("Preferences");
  content-width: 560;
  content-height: 520;

  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Behavior");

      Adw.SwitchRow background_row {
        title: _("Keep running in the background");
        subtitle: _("Closing the window leaves Obscure in the tray, still connected.");
      }

      Adw.SwitchRow autostart_row {
        title: _("Start with the session");
        subtitle: _("Obscure opens in the tray when you log in.");
      }

      Adw.SwitchRow connect_on_start_row {
        title: _("Connect when Obscure starts");
      }
    }

    Adw.PreferencesGroup {
      title: _("Connection");
      description: _("Changes apply the next time you connect. If you are connected now, Obscure reconnects.");

      Adw.SpinRow port_row {
        title: _("Local port");
        subtitle: _("Where programs on this computer reach the connection.");
        numeric: true;

        adjustment: Adjustment {
          lower: 1025;
          upper: 65535;
          step-increment: 1;
          page-increment: 100;
        };
      }

      Adw.EntryRow dns_row {
        title: _("DNS server (DNS over HTTPS)");
        show-apply-button: true;
      }

      Adw.SwitchRow prerelease_row {
        title: _("Try pre-release versions of the engine");
        subtitle: _("Newer features, but less tested. Off is the safe choice.");
      }
    }
  }

  Adw.PreferencesPage {
    title: _("Advanced");
    icon-name: "applications-engineering-symbolic";

    Adw.PreferencesGroup {
      title: _("Shortcut");

      Adw.SwitchRow shortcut_row {
        title: _("System-wide shortcut to connect or disconnect");
        subtitle: _("Works even when Obscure is hidden. The system lets you choose the keys.");
      }
    }

    Adw.PreferencesGroup rules_group {
      title: _("Route rules");
      description: _("Your rules win over the preset. Use a domain (example.com), an address (10.0.0.0/8) or a category (geosite:netflix).");

      [header-suffix]
      Button add_rule_button {
        valign: center;
        tooltip-text: _("Add rule");
        icon-name: "list-add-symbolic";
        clicked => $on_add_rule_clicked() swapped;

        styles [
          "flat",
        ]
      }

      ListBox rules_list {
        selection-mode: none;

        styles [
          "boxed-list",
        ]
      }
    }

    Adw.PreferencesGroup {
      title: _("Engine configuration");

      Adw.ActionRow json_row {
        title: _("Edit the engine configuration");
        subtitle: _("See or replace the JSON that Obscure sends to Xray.");
        activatable: true;
        activated => $on_json_activated() swapped;

        [suffix]
        Image {
          icon-name: "go-next-symbolic";
        }
      }
    }
  }
}
