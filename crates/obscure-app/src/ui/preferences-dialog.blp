using Gtk 4.0;
using Adw 1;

template $ObscurePreferencesDialog: Adw.PreferencesDialog {
  title: _("Preferences");
  content-width: 560;
  content-height: 520;

  Adw.PreferencesPage {
    title: _("General");
    icon-name: "preferences-system-symbolic";

    Adw.PreferencesGroup {
      title: _("Behavior");

      Adw.SwitchRow background_row {
        title: _("Keep running in the background");
        subtitle: _("Closing the window leaves Obscure in the tray, still connected.");
      }

      Adw.SwitchRow autostart_row {
        title: _("Start with the session");
        subtitle: _("Obscure opens in the tray when you log in.");
      }

      Adw.SwitchRow connect_on_start_row {
        title: _("Connect when Obscure starts");
      }
    }

    Adw.PreferencesGroup {
      title: _("Connection");
      description: _("Changes apply the next time you connect. If you are connected now, Obscure reconnects.");

      Adw.SpinRow port_row {
        title: _("Local port");
        subtitle: _("Where programs on this computer reach the connection.");
        numeric: true;

        adjustment: Adjustment {
          lower: 1025;
          upper: 65535;
          step-increment: 1;
          page-increment: 100;
        };
      }

      Adw.EntryRow dns_row {
        title: _("DNS server (DNS over HTTPS)");
        show-apply-button: true;
      }

      Adw.SwitchRow prerelease_row {
        title: _("Try pre-release versions of the engine");
        subtitle: _("Newer features, but less tested. Off is the safe choice.");
      }
    }
  }
}
