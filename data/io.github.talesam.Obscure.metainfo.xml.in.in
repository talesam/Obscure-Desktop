<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 Tales A. Mendonça -->
<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Obscure</name>
  <summary>Connect to your proxy with one button</summary>
  <description>
    <p>
      Obscure is a simple client for the Xray-core engine. Paste a link or a
      subscription, tap Connect and you are done.
    </p>
    <p>Features:</p>
    <ul>
      <li>One Connect button, no technical terms on the main screen</li>
      <li>Imports vless, vmess, trojan and shadowsocks links, as well as subscriptions</li>
      <li>Applies the system proxy on GNOME and KDE, no root required</li>
      <li>Downloads and updates Xray-core automatically, with integrity checks</li>
    </ul>
  </description>
  <developer id="io.github.talesam">
    <name translate="no">Tales A. Mendonça</name>
  </developer>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
  <translation type="gettext">@gettext-package@</translation>
  <url type="homepage">https://github.com/talesam/Obscure-Desktop</url>
  <url type="bugtracker">https://github.com/talesam/Obscure-Desktop/issues</url>
  <url type="vcs-browser">https://github.com/talesam/Obscure-Desktop</url>
  <content_rating type="oars-1.1" />
  <branding>
    <color type="primary" scheme_preference="light">#a99bff</color>
    <color type="primary" scheme_preference="dark">#4b3fbf</color>
  </branding>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <provides>
    <binary>obscure</binary>
  </provides>
  <releases>
    <release version="0.1.0" date="2026-09-19" type="development">
      <description>
        <p>Initial project skeleton.</p>
      </description>
    </release>
  </releases>
</component>
