<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="@gettext-package@">
  <schema id="@app-id@" path="@app-path@">
    <key name="window-width" type="i">
      <default>480</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>640</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Whether the window is maximized</summary>
    </key>
    <key name="run-in-background" type="b">
      <default>true</default>
      <summary>Keep running in the tray when the window is closed</summary>
    </key>
    <key name="autostart" type="b">
      <default>false</default>
      <summary>Start with the session (via the Background portal)</summary>
    </key>
    <key name="connect-on-start" type="b">
      <default>false</default>
      <summary>Connect automatically when the app starts</summary>
    </key>
  </schema>
</schemalist>
