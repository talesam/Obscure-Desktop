<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

  <vendor>Obscure</vendor>
  <vendor_url>https://github.com/talesam/Obscure-Desktop</vendor_url>
  <icon_name>@app-id@</icon_name>

  <action id="io.github.talesam.Obscure.grant-tun">
    <description>Allow Obscure to route all traffic (tunnel mode)</description>
    <description xml:lang="pt_BR">Permitir que o Obscure direcione todo o tráfego (modo túnel)</description>
    <message>Authentication is required to let Obscure's connection engine create a network tunnel.</message>
    <message xml:lang="pt_BR">É preciso autenticar para que o motor de conexão do Obscure crie um túnel de rede.</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@helper@</annotate>
  </action>

</policyconfig>
