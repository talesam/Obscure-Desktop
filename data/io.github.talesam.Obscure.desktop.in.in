[Desktop Entry]
Name=Obscure
# Translators: the slogan of the app
Comment=Connect. That's it.
GenericName=Proxy Client
Exec=obscure %U
Icon=@app-id@
Terminal=false
Type=Application
Categories=Network;
MimeType=x-scheme-handler/vless;x-scheme-handler/vmess;x-scheme-handler/trojan;x-scheme-handler/ss;
# Translators: search terms, keep the trailing semicolon
Keywords=proxy;vpn;xray;vless;vmess;trojan;shadowsocks;
StartupNotify=true
X-GNOME-UsesNotifications=true
