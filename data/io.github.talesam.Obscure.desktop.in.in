[Desktop Entry]
Name=Obscure
# Translators: the slogan of the app
Comment=Conecte-se. Só isso.
GenericName=Cliente de proxy
Exec=obscure %U
Icon=@app-id@
Terminal=false
Type=Application
Categories=Network;
