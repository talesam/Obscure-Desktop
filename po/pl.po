msgid "Connection Log"
msgstr "Dziennik połączenia"

#: crates/obscure-app/src/ui/log-dialog.blp:15
msgid "Copy log"
msgstr "Kopiuj dziennik"

#: crates/obscure-app/src/ui/log-dialog.blp:22
msgid "Clear log"
msgstr "Wyczyść dziennik"

#: crates/obscure-app/src/ui/server-dialog.blp:5
msgid "Server"
msgstr "Serwer"

#: crates/obscure-app/src/ui/server-dialog.blp:44
msgid "Name"
msgstr "Nazwa"

#: crates/obscure-app/src/ui/server-dialog.blp:50
msgid "Address"
msgstr "Adres"

#: crates/obscure-app/src/ui/server-dialog.blp:69
msgid "Copy Link"
msgstr "Kopiuj link"

#: crates/obscure-app/src/log_dialog.rs:85
msgid "Nothing logged yet. Connect to see what the engine reports."
msgstr "Jeszcze nic nie zapisano. Połącz się, aby zobaczyć, co zgłasza silnik."

#: crates/obscure-app/src/server_dialog.rs:61
msgid "Link copied."
msgstr "Link skopiowany."
