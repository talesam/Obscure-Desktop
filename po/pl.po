#: data/io.github.talesam.Obscure.desktop.in.in:2
#: data/io.github.talesam.Obscure.metainfo.xml.in.in:7
#: crates/obscure-app/src/ui/window.blp:5
msgid "Obscure"
msgstr "Obscure"

#. Translators: the slogan of the app
#: data/io.github.talesam.Obscure.desktop.in.in:4
#: crates/obscure-app/src/ui/window.blp:38
#: crates/obscure-app/src/application.rs:210
msgid "Connect. That's it."
msgstr "Połącz się. To wszystko."

#: data/io.github.talesam.Obscure.desktop.in.in:5
msgid "Proxy Client"
msgstr "Klient proxy"

#. Translators: search terms, keep the trailing semicolon
#: data/io.github.talesam.Obscure.desktop.in.in:12
msgid "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;"
msgstr "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:8
msgid "Connect to your proxy with one button"
msgstr "Połącz się ze swoim proxy jednym przyciskiem"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:10
msgid "Obscure is a simple client for the Xray-core engine. Paste a link or a subscription, tap Connect and you are done."
msgstr "Obscure to prosty klient silnika Xray-core. Wklej link lub subskrypcję, naciśnij Połącz i gotowe."

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:14
msgid "Features:"
msgstr "Funkcje:"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:16
msgid "One Connect button, no technical terms on the main screen"
msgstr "Jeden przycisk Połącz, bez technicznych terminów na ekranie głównym"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:17
msgid "Imports vless, vmess, trojan and shadowsocks links, as well as subscriptions"
msgstr "Importuje linki vless, vmess, trojan i shadowsocks oraz subskrypcje"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:18
msgid "Applies the system proxy on GNOME and KDE, no root required"
msgstr "Ustawia proxy systemowe w GNOME i KDE, bez uprawnień roota"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:19
msgid "Downloads and updates Xray-core automatically, with integrity checks"
msgstr "Automatycznie pobiera i aktualizuje Xray-core, z weryfikacją integralności"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:49
msgid "Initial project skeleton."
msgstr "Początkowy szkielet projektu."

#: data/io.github.talesam.Obscure.gschema.xml.in:6
msgid "Window width"
msgstr "Szerokość okna"

#: data/io.github.talesam.Obscure.gschema.xml.in:10
msgid "Window height"
msgstr "Wysokość okna"

#: data/io.github.talesam.Obscure.gschema.xml.in:14
msgid "Whether the window is maximized"
msgstr "Czy okno jest zmaksymalizowane"

#: crates/obscure-app/src/ui/window.blp:17
#: crates/obscure-app/src/ui/window.blp:51
#: crates/obscure-app/src/ui/import-dialog.blp:5
msgid "Add Server"
msgstr "Dodaj serwer"

#: crates/obscure-app/src/ui/window.blp:24
msgid "Main Menu"
msgstr "Menu główne"

#: crates/obscure-app/src/ui/window.blp:39
msgid "Paste a link or a subscription to get started."
msgstr "Wklej link lub subskrypcję, aby zacząć."

#: crates/obscure-app/src/ui/window.blp:137
#: crates/obscure-app/src/window.rs:310
msgid "Connect"
msgstr "Połącz"

#: crates/obscure-app/src/ui/window.blp:149
msgid "How to apply"
msgstr "Sposób zastosowania"

#: crates/obscure-app/src/ui/window.blp:157
msgid "System proxy"
msgstr "Proxy systemowe"

#: crates/obscure-app/src/ui/window.blp:158
msgid "Browsers and most apps use the connection. No administrator password needed."
msgstr "Przeglądarki i większość aplikacji użyją połączenia. Hasło administratora nie jest potrzebne."

#: crates/obscure-app/src/ui/window.blp:163
msgid "Local proxy only"
msgstr "Tylko lokalne proxy"

#: crates/obscure-app/src/ui/window.blp:164
msgid "Nothing changes on the system. Point the programs you want at 127.0.0.1:2080."
msgstr "W systemie nic się nie zmienia. Skieruj wybrane programy na 127.0.0.1:2080."

#: crates/obscure-app/src/ui/window.blp:169
msgid "Tunnel"
msgstr "Tunel"

#: crates/obscure-app/src/ui/window.blp:171
msgid "All traffic from this computer. Coming in a future version."
msgstr "Cały ruch z tego komputera. Dostępne w przyszłej wersji."

#: crates/obscure-app/src/ui/window.blp:177
msgid "Servers"
msgstr "Serwery"

#: crates/obscure-app/src/ui/window.blp:200
msgid "_Copy Environment Variables"
msgstr "_Kopiuj zmienne środowiskowe"

#: crates/obscure-app/src/ui/window.blp:207
msgid "_Preferences"
msgstr "_Preferencje"

#: crates/obscure-app/src/ui/window.blp:212
msgid "_Keyboard Shortcuts"
msgstr "_Skróty klawiszowe"

#: crates/obscure-app/src/ui/window.blp:217
msgid "_About Obscure"
msgstr "_O programie Obscure"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:6
#: crates/obscure-app/src/ui/preferences-dialog.blp:10
msgid "General"
msgstr "Ogólne"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:9
#: crates/obscure-app/src/ui/preferences-dialog.blp:5
msgid "Preferences"
msgstr "Preferencje"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:14
msgid "Keyboard Shortcuts"
msgstr "Skróty klawiszowe"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:19
msgid "Close Window"
msgstr "Zamknij okno"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:24
msgid "Quit"
msgstr "Zakończ"

#: crates/obscure-app/src/ui/preferences-dialog.blp:14
msgid "Connection"
msgstr "Połączenie"

#: crates/obscure-app/src/ui/preferences-dialog.blp:15
msgid "Connection options will be available in the next stage of the project."
msgstr "Opcje połączenia będą dostępne w następnym etapie projektu."

#: crates/obscure-app/src/ui/import-dialog.blp:17
#: crates/obscure-app/src/window.rs:302 crates/obscure-app/src/window.rs:372
msgid "Cancel"
msgstr "Anuluj"

#: crates/obscure-app/src/ui/import-dialog.blp:23
msgid "Add"
msgstr "Dodaj"

#: crates/obscure-app/src/ui/import-dialog.blp:42
msgid "Paste the server link below, or the links from your subscription, one per line."
msgstr "Wklej poniżej link serwera lub linki z subskrypcji, po jednym w wierszu."

#: crates/obscure-app/src/ui/import-dialog.blp:75
msgid "Paste from Clipboard"
msgstr "Wklej ze schowka"

#: crates/obscure-app/src/application.rs:57
msgid "The system proxy settings from a previous session were restored."
msgstr "Przywrócono ustawienia proxy systemowego z poprzedniej sesji."

#. Translators: replace with your name and, optionally, e-mail.
#: crates/obscure-app/src/application.rs:207
msgid "translator-credits"
msgstr ""

#: crates/obscure-app/src/application.rs:211
msgid "Obscure uses Xray-core, downloaded separately on first run."
msgstr "Obscure używa Xray-core, pobieranego osobno przy pierwszym uruchomieniu."

#: crates/obscure-app/src/application.rs:217
msgid "Project plan"
msgstr "Plan projektu"

#: crates/obscure-app/src/window.rs:185
msgid "The clipboard does not contain a server link."
msgstr "Schowek nie zawiera linku serwera."

#: crates/obscure-app/src/window.rs:216
msgid "Environment variables copied. Paste them in a terminal."
msgstr "Skopiowano zmienne środowiskowe. Wklej je w terminalu."

#: crates/obscure-app/src/window.rs:294
msgid "Disconnect"
msgstr "Rozłącz"

#: crates/obscure-app/src/window.rs:350
msgid "Remove server"
msgstr "Usuń serwer"

#: crates/obscure-app/src/window.rs:368
msgid "Remove “%s”?"
msgstr "Usunąć „%s”?"

#: crates/obscure-app/src/window.rs:369
msgid "You can add it again later by pasting its link."
msgstr "Możesz dodać go ponownie później, wklejając jego link."

#: crates/obscure-app/src/window.rs:373
msgid "Remove"
msgstr "Usuń"

#: crates/obscure-app/src/window.rs:393
msgid "These servers were already added."
msgstr "Te serwery były już dodane."

#: crates/obscure-app/src/window.rs:395
msgid "%n server added."
msgid_plural "%n servers added."
msgstr[0] "Dodano %n serwer."
msgstr[1] "Dodano %n serwery."
msgstr[2] "Dodano %n serwerów."

#: crates/obscure-app/src/connection.rs:147
#: crates/obscure-app/src/connection.rs:441
msgid "Disconnected"
msgstr "Rozłączono"

#: crates/obscure-app/src/connection.rs:314
msgid "Choose a server to connect"
msgstr "Wybierz serwer, aby się połączyć"

#: crates/obscure-app/src/connection.rs:329
#: crates/obscure-app/src/connection.rs:417
msgid "Connecting…"
msgstr "Łączenie…"

#: crates/obscure-app/src/connection.rs:361
msgid "Disconnecting…"
msgstr "Rozłączanie…"

#: crates/obscure-app/src/connection.rs:384
msgid "Preparing the connection engine…"
msgstr "Przygotowywanie silnika połączenia…"

#: crates/obscure-app/src/connection.rs:395
msgid "Downloading the connection engine: %a of %b MB"
msgstr "Pobieranie silnika połączenia: %a z %b MB"

#: crates/obscure-app/src/connection.rs:398
msgid "Downloading the connection engine: %a MB"
msgstr "Pobieranie silnika połączenia: %a MB"

#: crates/obscure-app/src/connection.rs:403
msgid "Verifying the download…"
msgstr "Weryfikowanie pobranego pliku…"

#: crates/obscure-app/src/connection.rs:405
msgid "Installing the connection engine…"
msgstr "Instalowanie silnika połączenia…"

#: crates/obscure-app/src/connection.rs:434
msgid "Connected · system proxy active"
msgstr "Połączono · proxy systemowe aktywne"

#: crates/obscure-app/src/connection.rs:435
msgid "Connected · local proxy only"
msgstr "Połączono · tylko lokalne proxy"

#: crates/obscure-app/src/connection.rs:436
msgid "Connected"
msgstr "Połączono"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "Ten rodzaj linku nie jest jeszcze obsługiwany: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "Link wygląda na niekompletny lub nieprawidłowy."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "Połączenie z internetem trwało zbyt długo."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "Nie można połączyć się z internetem, aby pobrać silnik połączenia."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "Nie można pobrać silnika połączenia. Spróbuj ponownie później."

#: crates/obscure-app/src/humanize.rs:20
msgid "The downloaded file is corrupted. It will be downloaded again on the next attempt."
msgstr "Pobrany plik jest uszkodzony. Zostanie pobrany ponownie przy następnej próbie."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "Nie można rozpakować silnika połączenia."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "Silnik połączenia nie został jeszcze pobrany."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "Sprawdź klucz publiczny serwera."

#: crates/obscure-app/src/humanize.rs:28
msgid "The server identifier is not valid."
msgstr "Identyfikator serwera jest nieprawidłowy."

#: crates/obscure-app/src/humanize.rs:30
msgid "Check the server details."
msgstr "Sprawdź dane serwera."

#: crates/obscure-app/src/humanize.rs:34
msgid "This server has a configuration the engine did not accept."
msgstr "Ten serwer ma konfigurację, której silnik nie zaakceptował."

#: crates/obscure-app/src/humanize.rs:41
msgid "The local port is already in use by another program. Change it in Preferences."
msgstr "Lokalny port jest już używany przez inny program. Zmień go w Preferencjach."

#: crates/obscure-app/src/humanize.rs:44
msgid "The connection engine stopped unexpectedly."
msgstr "Silnik połączenia nieoczekiwanie się zatrzymał."

#: crates/obscure-app/src/humanize.rs:47
msgid "The connection engine did not respond in time."
msgstr "Silnik połączenia nie odpowiedział na czas."

#: crates/obscure-app/src/humanize.rs:49
msgid "Could not change the system proxy. The local connection is still available."
msgstr "Nie można zmienić proxy systemowego. Lokalne połączenie jest nadal dostępne."

#: crates/obscure-app/src/humanize.rs:51
msgid "Could not notify the system about the new proxy."
msgstr "Nie można powiadomić systemu o nowym proxy."

#: crates/obscure-app/src/humanize.rs:52
msgid "Could not read or write Obscure's files."
msgstr "Nie można odczytać ani zapisać plików Obscure."

#: crates/obscure-app/src/humanize.rs:53
msgid "Could not read traffic statistics."
msgstr "Nie można odczytać statystyk ruchu."

#: crates/obscure-app/src/humanize.rs:54
msgid "The server did not respond to the latency test."
msgstr "Serwer nie odpowiedział na test opóźnienia."

#: crates/obscure-app/src/humanize.rs:55
msgid "The subscription could not be read. Check the address."
msgstr "Nie można odczytać subskrypcji. Sprawdź adres."

#: crates/obscure-app/src/humanize.rs:57
msgid "This subscription is in Clash format, which Obscure does not support yet."
msgstr "Ta subskrypcja jest w formacie Clash, którego Obscure jeszcze nie obsługuje."

#: crates/obscure-app/src/import_dialog.rs:49
#: crates/obscure-app/src/import_dialog.rs:159
msgid "No valid link found."
msgstr "Nie znaleziono prawidłowego linku."

#: crates/obscure-app/src/import_dialog.rs:162
msgid "%n server ready to add."
msgid_plural "%n servers ready to add."
msgstr[0] "%n serwer gotowy do dodania."
msgstr[1] "%n serwery gotowe do dodania."
msgstr[2] "%n serwerów gotowych do dodania."

#: crates/obscure-app/src/import_dialog.rs:172
msgid "%n link could not be read."
msgid_plural "%n links could not be read."
msgstr[0] "Nie można odczytać %n linku."
msgstr[1] "Nie można odczytać %n linków."
msgstr[2] "Nie można odczytać %n linków."
