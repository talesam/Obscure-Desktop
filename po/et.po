msgstr "Pildid"

#: crates/obscure-app/src/import_dialog.rs:79
msgid "Choose an image with a QR code"
msgstr "Vali pilt, millel on QR-kood"

#: crates/obscure-app/src/import_dialog.rs:97
#: crates/obscure-app/src/import_dialog.rs:149
msgid "No QR code was found in that image."
msgstr "Sellelt pildilt QR-koodi ei leitud."

#: crates/obscure-app/src/import_dialog.rs:119
msgid "No QR code was found on the screen. Make sure it is fully visible and try again."
msgstr "Ekraanilt QR-koodi ei leitud. Veendu, et see on täielikult nähtav, ja proovi uuesti."

#: crates/obscure-app/src/import_dialog.rs:246
msgid "Subscription address: the servers will be downloaded and kept up to date."
msgstr "Tellimuse aadress: serverid laaditakse alla ja hoitakse ajakohasena."

#: crates/obscure-app/src/import_dialog.rs:256
msgid "%n server ready to add."
msgid_plural "%n servers ready to add."
msgstr[0] "%n server on lisamiseks valmis."
msgstr[1] "%n serverit on lisamiseks valmis."

#: crates/obscure-app/src/import_dialog.rs:266
msgid "%n link could not be read."
msgid_plural "%n links could not be read."
msgstr[0] "%n linki ei õnnestunud lugeda."
msgstr[1] "%n linki ei õnnestunud lugeda."

#: crates/obscure-app/src/tray.rs:87
msgid "Show Obscure"
