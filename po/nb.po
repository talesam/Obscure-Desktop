#: data/io.github.talesam.Obscure.metainfo.xml.in.in:7
#: crates/obscure-app/src/ui/window.blp:5
msgid "Obscure"
msgstr "Obscure"

#. Translators: the slogan of the app
#: data/io.github.talesam.Obscure.desktop.in.in:4
#: crates/obscure-app/src/ui/window.blp:38
#: crates/obscure-app/src/application.rs:183
msgid "Connect. That's it."
msgstr "Koble til. Det er alt."

#: data/io.github.talesam.Obscure.desktop.in.in:5
msgid "Proxy Client"
msgstr "Proxyklient"

#. Translators: search terms, keep the trailing semicolon
#: data/io.github.talesam.Obscure.desktop.in.in:12
msgid "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;"
msgstr "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:8
msgid "Connect to your proxy with one button"
msgstr "Koble til proxyen din med én knapp"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:10
msgid "Obscure is a simple client for the Xray-core engine. Paste a link or a subscription, tap Connect and you are done."
msgstr "Obscure er en enkel klient for Xray-core-motoren. Lim inn en lenke eller et abonnement, trykk Koble til, og du er ferdig."

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:14
msgid "Features:"
msgstr "Funksjoner:"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:16
msgid "One Connect button, no technical terms on the main screen"
msgstr "Én Koble til-knapp, ingen tekniske begreper på hovedskjermen"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:17
msgid "Imports vless, vmess, trojan and shadowsocks links, as well as subscriptions"
msgstr "Importerer vless-, vmess-, trojan- og shadowsocks-lenker samt abonnementer"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:18
msgid "Applies the system proxy on GNOME and KDE, no root required"
msgstr "Bruker systemproxyen på GNOME og KDE uten root"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:19
msgid "Downloads and updates Xray-core automatically, with integrity checks"
msgstr "Laster ned og oppdaterer Xray-core automatisk med integritetskontroll"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:49
msgid "Initial project skeleton."
msgstr "Prosjektets første skjelett."

#: data/io.github.talesam.Obscure.gschema.xml.in:6
msgid "Window width"
msgstr "Vindusbredde"

#: data/io.github.talesam.Obscure.gschema.xml.in:10
msgid "Window height"
msgstr "Vindushøyde"

#: data/io.github.talesam.Obscure.gschema.xml.in:14
msgid "Whether the window is maximized"
msgstr "Om vinduet er maksimert"

#: crates/obscure-app/src/ui/window.blp:17
#: crates/obscure-app/src/ui/window.blp:51
#: crates/obscure-app/src/ui/import-dialog.blp:5
msgid "Add Server"
msgstr "Legg til server"

#: crates/obscure-app/src/ui/window.blp:24
msgid "Main Menu"
msgstr "Hovedmeny"

#: crates/obscure-app/src/ui/window.blp:39
msgid "Paste a link or a subscription to get started."
msgstr "Lim inn en lenke eller et abonnement for å komme i gang."

#: crates/obscure-app/src/ui/window.blp:127
#: crates/obscure-app/src/window.rs:301
msgid "Connect"
msgstr "Koble til"

#: crates/obscure-app/src/ui/window.blp:139
msgid "How to apply"
msgstr "Slik brukes det"

#: crates/obscure-app/src/ui/window.blp:147
msgid "System proxy"
msgstr "Systemproxy"

#: crates/obscure-app/src/ui/window.blp:148
msgid "Browsers and most apps use the connection. No administrator password needed."
msgstr "Nettlesere og de fleste apper bruker tilkoblingen. Ingen administratorpassord kreves."

#: crates/obscure-app/src/ui/window.blp:153
msgid "Local proxy only"
msgstr "Kun lokal proxy"

#: crates/obscure-app/src/ui/window.blp:154
msgid "Nothing changes on the system. Point the programs you want at 127.0.0.1:2080."
msgstr "Ingenting endres på systemet. Pek programmene du vil bruke mot 127.0.0.1:2080."

#: crates/obscure-app/src/ui/window.blp:159
msgid "Tunnel"
msgstr "Tunnel"

#: crates/obscure-app/src/ui/window.blp:161
msgid "All traffic from this computer. Coming in a future version."
msgstr "All trafikk fra denne datamaskinen. Kommer i en fremtidig versjon."

#: crates/obscure-app/src/ui/window.blp:167
msgid "Servers"
msgstr "Servere"

#: crates/obscure-app/src/ui/window.blp:190
msgid "_Copy Environment Variables"
msgstr "_Kopier miljøvariabler"

#: crates/obscure-app/src/ui/window.blp:197
msgid "_Preferences"
msgstr "_Innstillinger"

#: crates/obscure-app/src/ui/window.blp:202
msgid "_Keyboard Shortcuts"
msgstr "_Tastatursnarveier"

#: crates/obscure-app/src/ui/window.blp:207
msgid "_About Obscure"
msgstr "_Om Obscure"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:6
#: crates/obscure-app/src/ui/preferences-dialog.blp:10
msgid "General"
msgstr "Generelt"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:9
#: crates/obscure-app/src/ui/preferences-dialog.blp:5
msgid "Preferences"
msgstr "Innstillinger"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:14
msgid "Keyboard Shortcuts"
msgstr "Tastatursnarveier"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:19
msgid "Close Window"
msgstr "Lukk vindu"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:24
msgid "Quit"
msgstr "Avslutt"

#: crates/obscure-app/src/ui/preferences-dialog.blp:14
msgid "Connection"
msgstr "Tilkobling"

#: crates/obscure-app/src/ui/preferences-dialog.blp:15
msgid "Connection options will be available in the next stage of the project."
msgstr "Tilkoblingsvalg blir tilgjengelige i neste fase av prosjektet."

#: crates/obscure-app/src/ui/import-dialog.blp:17
#: crates/obscure-app/src/window.rs:293 crates/obscure-app/src/window.rs:363
msgid "Cancel"
msgstr "Avbryt"

#: crates/obscure-app/src/ui/import-dialog.blp:23
msgid "Add"
msgstr "Legg til"

#: crates/obscure-app/src/ui/import-dialog.blp:42
msgid "Paste the server link below, or the links from your subscription, one per line."
msgstr "Lim inn serverlenken nedenfor, eller lenkene fra abonnementet ditt, én per linje."

#: crates/obscure-app/src/ui/import-dialog.blp:75
msgid "Paste from Clipboard"
msgstr "Lim inn fra utklippstavlen"

#: crates/obscure-app/src/application.rs:56
msgid "The system proxy settings from a previous session were restored."
msgstr "Systemproxy-innstillingene fra en tidligere sesjon ble gjenopprettet."

#. Translators: replace with your name and, optionally, e-mail.
#: crates/obscure-app/src/application.rs:180
msgid "translator-credits"
msgstr ""

#: crates/obscure-app/src/application.rs:184
msgid "Obscure uses Xray-core, downloaded separately on first run."
msgstr "Obscure bruker Xray-core, som lastes ned separat ved første oppstart."

#: crates/obscure-app/src/application.rs:190
msgid "Project plan"
msgstr "Prosjektplan"

#: crates/obscure-app/src/window.rs:183
msgid "The clipboard does not contain a server link."
msgstr "Utklippstavlen inneholder ikke en serverlenke."

#: crates/obscure-app/src/window.rs:214
msgid "Environment variables copied. Paste them in a terminal."
msgstr "Miljøvariabler kopiert. Lim dem inn i en terminal."

#: crates/obscure-app/src/window.rs:285
msgid "Disconnect"
msgstr "Koble fra"

#: crates/obscure-app/src/window.rs:341
msgid "Remove server"
msgstr "Fjern server"

#: crates/obscure-app/src/window.rs:359
msgid "Remove “%s”?"
msgstr "Fjerne «%s»?"

#: crates/obscure-app/src/window.rs:360
msgid "You can add it again later by pasting its link."
msgstr "Du kan legge den til igjen senere ved å lime inn lenken."

#: crates/obscure-app/src/window.rs:364
msgid "Remove"
msgstr "Fjern"

#: crates/obscure-app/src/window.rs:384
msgid "These servers were already added."
msgstr "Disse serverne var allerede lagt til."

#: crates/obscure-app/src/window.rs:386
msgid "%n server added."
msgid_plural "%n servers added."
msgstr[0] "%n server lagt til."
msgstr[1] "%n servere lagt til."

#: crates/obscure-app/src/connection.rs:129
#: crates/obscure-app/src/connection.rs:410
msgid "Disconnected"
msgstr "Frakoblet"

#: crates/obscure-app/src/connection.rs:296
msgid "Choose a server to connect"
msgstr "Velg en server å koble til"

#: crates/obscure-app/src/connection.rs:311
msgid "Connecting…"
msgstr "Kobler til…"

#: crates/obscure-app/src/connection.rs:345
msgid "Disconnecting…"
msgstr "Kobler fra…"

#: crates/obscure-app/src/connection.rs:368
msgid "Preparing the connection engine…"
msgstr "Forbereder tilkoblingsmotoren…"

#: crates/obscure-app/src/connection.rs:379
msgid "Downloading the connection engine: %a of %b MB"
msgstr "Laster ned tilkoblingsmotoren: %a av %b MB"

#: crates/obscure-app/src/connection.rs:382
msgid "Downloading the connection engine: %a MB"
msgstr "Laster ned tilkoblingsmotoren: %a MB"

#: crates/obscure-app/src/connection.rs:387
msgid "Verifying the download…"
msgstr "Verifiserer nedlastingen…"

#: crates/obscure-app/src/connection.rs:389
msgid "Installing the connection engine…"
msgstr "Installerer tilkoblingsmotoren…"

#: crates/obscure-app/src/connection.rs:403
msgid "Connected · system proxy active"
msgstr "Tilkoblet · systemproxy aktiv"

#: crates/obscure-app/src/connection.rs:404
msgid "Connected · local proxy only"
msgstr "Tilkoblet · kun lokal proxy"

#: crates/obscure-app/src/connection.rs:405
msgid "Connected"
msgstr "Tilkoblet"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "Denne typen lenke støttes ikke ennå: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "Lenken ser ufullstendig eller ugyldig ut."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "Internettforbindelsen tok for lang tid."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "Kunne ikke nå internett for å laste ned tilkoblingsmotoren."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "Kunne ikke laste ned tilkoblingsmotoren. Prøv igjen senere."

#: crates/obscure-app/src/humanize.rs:20
msgid "The downloaded file is corrupted. It will be downloaded again on the next attempt."
msgstr "Den nedlastede filen er skadet. Den lastes ned igjen ved neste forsøk."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "Kunne ikke pakke ut tilkoblingsmotoren."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "Tilkoblingsmotoren er ikke lastet ned ennå."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "Kontroller serverens offentlige nøkkel."

#: crates/obscure-app/src/humanize.rs:28
msgid "The server identifier is not valid."
msgstr "Serverens identifikator er ikke gyldig."

#: crates/obscure-app/src/humanize.rs:30
msgid "Check the server details."
msgstr "Kontroller serverdetaljene."

#: crates/obscure-app/src/humanize.rs:34
msgid "This server has a configuration the engine did not accept."
msgstr "Denne serveren har en konfigurasjon som motoren ikke godtok."

#: crates/obscure-app/src/humanize.rs:41
msgid "The local port is already in use by another program. Change it in Preferences."
msgstr "Den lokale porten brukes allerede av et annet program. Endre den i Innstillinger."

#: crates/obscure-app/src/humanize.rs:44
msgid "The connection engine stopped unexpectedly."
msgstr "Tilkoblingsmotoren stoppet uventet."

#: crates/obscure-app/src/humanize.rs:47
msgid "The connection engine did not respond in time."
msgstr "Tilkoblingsmotoren svarte ikke i tide."

#: crates/obscure-app/src/humanize.rs:49
msgid "Could not change the system proxy. The local connection is still available."
msgstr "Kunne ikke endre systemproxyen. Den lokale tilkoblingen er fortsatt tilgjengelig."

#: crates/obscure-app/src/humanize.rs:51
msgid "Could not notify the system about the new proxy."
msgstr "Kunne ikke varsle systemet om den nye proxyen."

#: crates/obscure-app/src/humanize.rs:52
msgid "Could not read or write Obscure's files."
msgstr "Kunne ikke lese eller skrive Obscures filer."

#: crates/obscure-app/src/import_dialog.rs:49
#: crates/obscure-app/src/import_dialog.rs:159
msgid "No valid link found."
msgstr "Ingen gyldig lenke funnet."

#: crates/obscure-app/src/import_dialog.rs:162
msgid "%n server ready to add."
msgid_plural "%n servers ready to add."
msgstr[0] "%n server klar til å legges til."
msgstr[1] "%n servere klare til å legges til."

#: crates/obscure-app/src/import_dialog.rs:172
msgid "%n link could not be read."
msgid_plural "%n links could not be read."
msgstr[0] "%n lenke kunne ikke leses."
msgstr[1] "%n lenker kunne ikke leses."
