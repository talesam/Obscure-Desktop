#: data/io.github.talesam.Obscure.desktop.in.in:2 data/io.github.talesam.Obscure.metainfo.xml.in.in:7 crates/obscure-app/src/ui/window.blp:5
msgid "Obscure"
msgstr "Obscure"

#. Translators: short description shown next to the app name in menus
#: data/io.github.talesam.Obscure.desktop.in.in:4
msgid "Proxy Client"
msgstr "Proxy klijent"

#. Translators: the slogan of the app
#: data/io.github.talesam.Obscure.desktop.in.in:6 crates/obscure-app/src/ui/window.blp:38 crates/obscure-app/src/application.rs:435
msgid "Connect. That's it."
msgstr "Povežite se. To je sve."

#. Translators: search terms, keep the trailing semicolon and add local words
#: data/io.github.talesam.Obscure.desktop.in.in:16
msgid "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;wireguard;privacy;censorship;"
msgstr "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;wireguard;privatnost;cenzura;veza;"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:8
msgid "Connect to your proxy with one button"
msgstr "Povežite se sa svojim proxyjem jednim gumbom"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:10
msgid "Obscure is a simple client for the Xray-core engine. Paste a link or a subscription, tap Connect and you are done."
msgstr "Obscure je jednostavan klijent za Xray-core. Zalijepite poveznicu ili pretplatu, dodirnite Poveži i gotovo."

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:14
msgid "Features:"
msgstr "Značajke:"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:16
msgid "One Connect button, no technical terms on the main screen"
msgstr "Jedan gumb Poveži, bez tehničkih pojmova na glavnom zaslonu"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:17
msgid "Imports vless, vmess, trojan and shadowsocks links, as well as subscriptions"
msgstr "Uvozi vless, vmess, trojan i shadowsocks poveznice te pretplate"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:18
msgid "Applies the system proxy on GNOME and KDE, no root required"
msgstr "Postavlja proxy sustava na GNOME-u i KDE-u bez root prava"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:19
msgid "Downloads and updates Xray-core automatically, with integrity checks"
msgstr "Automatski preuzima i ažurira Xray-core s provjerom cjelovitosti"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:49
msgid "Initial project skeleton."
msgstr "Početni kostur projekta."

#: data/io.github.talesam.Obscure.gschema.xml.in:6
msgid "Window width"
msgstr "Širina prozora"

#: data/io.github.talesam.Obscure.gschema.xml.in:10
msgid "Window height"
msgstr "Visina prozora"

#: data/io.github.talesam.Obscure.gschema.xml.in:14
msgid "Whether the window is maximized"
msgstr "Je li prozor maksimiziran"

#: data/io.github.talesam.Obscure.gschema.xml.in:18
msgid "Keep running in the tray when the window is closed"
msgstr "Ostani u traci sustava kad se prozor zatvori"

#: data/io.github.talesam.Obscure.gschema.xml.in:22
msgid "Start with the session (via the Background portal)"
msgstr "Pokreni sa sesijom (putem portala Background)"

#: data/io.github.talesam.Obscure.gschema.xml.in:26
msgid "Register a system-wide shortcut through the GlobalShortcuts portal"
msgstr "Registriraj prečac na razini sustava putem portala GlobalShortcuts"

#: data/io.github.talesam.Obscure.gschema.xml.in:30
msgid "Connect automatically when the app starts"
msgstr "Automatski se poveži pri pokretanju aplikacije"

#: crates/obscure-app/src/ui/window.blp:17 crates/obscure-app/src/ui/window.blp:51 crates/obscure-app/src/ui/import-dialog.blp:5
msgid "Add Server"
msgstr "Dodaj poslužitelj"

#: crates/obscure-app/src/ui/window.blp:24
msgid "Main Menu"
msgstr "Glavni izbornik"

#: crates/obscure-app/src/ui/window.blp:39
msgid "Paste a link or a subscription to get started."
msgstr "Zalijepite poveznicu ili pretplatu za početak."

#: crates/obscure-app/src/ui/window.blp:152 crates/obscure-app/src/window.rs:587 crates/obscure-app/src/tray.rs:83
msgid "Connect"
msgstr "Poveži"

#: crates/obscure-app/src/ui/window.blp:164
msgid "How to apply"
msgstr "Način primjene"

#: crates/obscure-app/src/ui/window.blp:172
msgid "System proxy"
msgstr "Proxy sustava"

#: crates/obscure-app/src/ui/window.blp:173
msgid "Browsers and most apps use the connection. No administrator password needed."
msgstr "Preglednici i većina aplikacija koristit će vezu. Nije potrebna administratorska lozinka."

#: crates/obscure-app/src/ui/window.blp:178
msgid "Local proxy only"
msgstr "Samo lokalni proxy"

#: crates/obscure-app/src/ui/window.blp:179
msgid "Nothing changes on the system. Point the programs you want at 127.0.0.1:2080."
msgstr "Ništa se u sustavu ne mijenja. Usmjerite željene programe na 127.0.0.1:2080."

#: crates/obscure-app/src/ui/window.blp:184
msgid "Tunnel"
msgstr "Tunel"

#: crates/obscure-app/src/ui/window.blp:185
msgid "All traffic from this computer, every app. Asks for your password once."
msgstr "Sav promet ovog računala, svaka aplikacija. Jednom traži vašu lozinku."

#: crates/obscure-app/src/ui/window.blp:191
msgid "What goes through the connection"
msgstr "Što ide kroz vezu"

#: crates/obscure-app/src/ui/window.blp:199
msgid "Smart"
msgstr "Pametno"

#: crates/obscure-app/src/ui/window.blp:200
msgid "Everything, except local network addresses. Ads are blocked."
msgstr "Sve, osim adresa lokalne mreže. Oglasi su blokirani."

#: crates/obscure-app/src/ui/window.blp:205
msgid "Everything"
msgstr "Sve"

#: crates/obscure-app/src/ui/window.blp:206
msgid "All traffic goes through the connection, except local network addresses."
msgstr "Sav promet ide kroz vezu, osim adresa lokalne mreže."

#: crates/obscure-app/src/ui/window.blp:212
msgid "Subscriptions"
msgstr "Pretplate"

#: crates/obscure-app/src/ui/window.blp:225
msgid "Servers"
msgstr "Poslužitelji"

#: crates/obscure-app/src/ui/window.blp:234
msgid "Automatic"
msgstr "Automatski"

#: crates/obscure-app/src/ui/window.blp:235
msgid "Tests all servers when you connect and picks the quickest one."
msgstr "Pri povezivanju testira sve poslužitelje i bira najbrži."

#: crates/obscure-app/src/ui/window.blp:245
msgid "Automatic: fastest server"
msgstr "Automatski: najbrži poslužitelj"

#: crates/obscure-app/src/ui/window.blp:251
msgid "Measure the response time of every server"
msgstr "Izmjeri vrijeme odziva svakog poslužitelja"

#: crates/obscure-app/src/ui/window.blp:256
msgid "Test All"
msgstr "Testiraj sve"

#: crates/obscure-app/src/ui/window.blp:286
msgid "_Import from File…"
msgstr "_Uvezi iz datoteke…"

#: crates/obscure-app/src/ui/window.blp:291
msgid "_Live Connections"
msgstr "_Veze uživo"

#: crates/obscure-app/src/ui/window.blp:296
msgid "_Connection Log"
msgstr "_Zapisnik veze"

#: crates/obscure-app/src/ui/window.blp:301
msgid "_Copy Environment Variables"
msgstr "_Kopiraj varijable okruženja"

#: crates/obscure-app/src/ui/window.blp:308
msgid "_Preferences"
msgstr "_Postavke"

#: crates/obscure-app/src/ui/window.blp:313
msgid "_Keyboard Shortcuts"
msgstr "_Tipkovnički prečaci"

#: crates/obscure-app/src/ui/window.blp:318
msgid "_About Obscure"
msgstr "_O programu Obscure"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:6 crates/obscure-app/src/ui/preferences-dialog.blp:10
msgid "General"
msgstr "Općenito"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:9 crates/obscure-app/src/ui/preferences-dialog.blp:5
msgid "Preferences"
msgstr "Postavke"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:14
msgid "Keyboard Shortcuts"
msgstr "Tipkovnički prečaci"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:19 crates/obscure-app/src/ui/connections-dialog.blp:5
msgid "Live Connections"
msgstr "Veze uživo"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:24
msgid "Close Window"
msgstr "Zatvori prozor"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:29 crates/obscure-app/src/tray.rs:101
msgid "Quit"
msgstr "Izađi"

#: crates/obscure-app/src/ui/preferences-dialog.blp:14
msgid "Behavior"
msgstr "Ponašanje"

#: crates/obscure-app/src/ui/preferences-dialog.blp:17
msgid "Keep running in the background"
msgstr "Nastavi raditi u pozadini"

#: crates/obscure-app/src/ui/preferences-dialog.blp:18
msgid "Closing the window leaves Obscure in the tray, still connected."
msgstr "Zatvaranje prozora ostavlja Obscure u traci sustava, i dalje povezan."

#: crates/obscure-app/src/ui/preferences-dialog.blp:22
msgid "Start with the session"
msgstr "Pokreni sa sesijom"

#: crates/obscure-app/src/ui/preferences-dialog.blp:23
msgid "Obscure opens in the tray when you log in."
msgstr "Obscure se otvara u traci sustava pri prijavi."

#: crates/obscure-app/src/ui/preferences-dialog.blp:27
msgid "Connect when Obscure starts"
msgstr "Poveži se kad se Obscure pokrene"

#: crates/obscure-app/src/ui/preferences-dialog.blp:32
msgid "Connection"
msgstr "Veza"

#: crates/obscure-app/src/ui/preferences-dialog.blp:33
msgid "Changes apply the next time you connect. If you are connected now, Obscure reconnects."
msgstr "Promjene vrijede od sljedećeg povezivanja. Ako ste sada povezani, Obscure se ponovno povezuje."

#: crates/obscure-app/src/ui/preferences-dialog.blp:36
msgid "Local port"
msgstr "Lokalni port"

#: crates/obscure-app/src/ui/preferences-dialog.blp:37
msgid "Where programs on this computer reach the connection."
msgstr "Gdje programi na ovom računalu pronalaze vezu."

#: crates/obscure-app/src/ui/preferences-dialog.blp:49
msgid "DNS server (DNS over HTTPS)"
msgstr "DNS poslužitelj (DNS preko HTTPS-a)"

#: crates/obscure-app/src/ui/preferences-dialog.blp:54
msgid "Try pre-release versions of the engine"
msgstr "Probaj predizdanja pogona"

#: crates/obscure-app/src/ui/preferences-dialog.blp:55
msgid "Newer features, but less tested. Off is the safe choice."
msgstr "Novije značajke, ali manje testirane. Isključeno je siguran izbor."

#: crates/obscure-app/src/ui/preferences-dialog.blp:61
msgid "Advanced"
msgstr "Napredno"

#: crates/obscure-app/src/ui/preferences-dialog.blp:65
msgid "Shortcut"
msgstr "Prečac"

#: crates/obscure-app/src/ui/preferences-dialog.blp:68
msgid "System-wide shortcut to connect or disconnect"
msgstr "Prečac na razini sustava za povezivanje ili odspajanje"

#: crates/obscure-app/src/ui/preferences-dialog.blp:69
msgid "Works even when Obscure is hidden. The system lets you choose the keys."
msgstr "Radi i kad je Obscure skriven. Sustav vam daje odabrati tipke."

#: crates/obscure-app/src/ui/preferences-dialog.blp:74
msgid "Route rules"
msgstr "Pravila usmjeravanja"

#: crates/obscure-app/src/ui/preferences-dialog.blp:75
msgid "Your rules win over the preset. Use a domain (example.com), an address (10.0.0.0/8) or a category (geosite:netflix)."
msgstr "Vaša pravila imaju prednost pred predloškom. Koristite domenu (example.com), adresu (10.0.0.0/8) ili kategoriju (geosite:netflix)."

#: crates/obscure-app/src/ui/preferences-dialog.blp:80
msgid "Add rule"
msgstr "Dodaj pravilo"

#: crates/obscure-app/src/ui/preferences-dialog.blp:99
msgid "Engine configuration"
msgstr "Konfiguracija pogona"

#: crates/obscure-app/src/ui/preferences-dialog.blp:102
msgid "Edit the engine configuration"
msgstr "Uredi konfiguraciju pogona"

#: crates/obscure-app/src/ui/preferences-dialog.blp:103
msgid "See or replace the JSON that Obscure sends to Xray."
msgstr "Pogledajte ili zamijenite JSON koji Obscure šalje Xrayu."

#: crates/obscure-app/src/ui/import-dialog.blp:17 crates/obscure-app/src/window.rs:550 crates/obscure-app/src/window.rs:579 crates/obscure-app/src/window.rs:691 crates/obscure-app/src/preferences_dialog.rs:242
msgid "Cancel"
msgstr "Odustani"

#: crates/obscure-app/src/ui/import-dialog.blp:23 crates/obscure-app/src/preferences_dialog.rs:242
msgid "Add"
msgstr "Dodaj"

#: crates/obscure-app/src/ui/import-dialog.blp:42
msgid "Paste server links (one per line) or the address of your subscription."
msgstr "Zalijepite poveznice poslužitelja (jednu po retku) ili adresu svoje pretplate."

#: crates/obscure-app/src/ui/import-dialog.blp:79
msgid "Paste"
msgstr "Zalijepi"

#: crates/obscure-app/src/ui/import-dialog.blp:84
msgid "Read a QR code from an image file"
msgstr "Pročitaj QR kod iz slikovne datoteke"

#: crates/obscure-app/src/ui/import-dialog.blp:89
msgid "QR from Image"
msgstr "QR iz slike"

#: crates/obscure-app/src/ui/import-dialog.blp:94
msgid "Take a screenshot and read the QR code in it"
msgstr "Snimi zaslon i pročitaj QR kod na njemu"

#: crates/obscure-app/src/ui/import-dialog.blp:99
msgid "QR from Screen"
msgstr "QR sa zaslona"

#: crates/obscure-app/src/application.rs:98
msgid "The system proxy settings from a previous session were restored."
msgstr "Postavke proxyja sustava iz prethodne sesije su vraćene."

#. Translators: replace with your name and, optionally, e-mail.
#: crates/obscure-app/src/application.rs:432
msgid "translator-credits"
msgstr ""

#: crates/obscure-app/src/application.rs:436
msgid "Obscure uses Xray-core, downloaded separately on first run."
msgstr "Obscure koristi Xray-core, koji se zasebno preuzima pri prvom pokretanju."

#: crates/obscure-app/src/application.rs:442
msgid "Project plan"
msgstr "Plan projekta"

#: crates/obscure-app/src/window.rs:223
msgid "The clipboard does not contain a server link."
msgstr "Međuspremnik ne sadrži poveznicu poslužitelja."

#: crates/obscure-app/src/window.rs:245
msgid "Text files"
msgstr "Tekstualne datoteke"

#: crates/obscure-app/src/window.rs:252
msgid "Import servers from a file"
msgstr "Uvezi poslužitelje iz datoteke"

#: crates/obscure-app/src/window.rs:272
msgid "Could not read that file."
msgstr "Nije moguće pročitati tu datoteku."

#: crates/obscure-app/src/window.rs:360
msgid "Environment variables copied. Paste them in a terminal."
msgstr "Varijable okruženja kopirane. Zalijepite ih u terminal."

#: crates/obscure-app/src/window.rs:497
msgid "Update now"
msgstr "Ažuriraj sada"

#: crates/obscure-app/src/window.rs:527
msgid "Remove subscription"
msgstr "Ukloni pretplatu"

#: crates/obscure-app/src/window.rs:544
msgid "Remove “%s” and all its servers?"
msgstr "Ukloniti „%s” i sve njegove poslužitelje?"

#: crates/obscure-app/src/window.rs:546
msgid "You can add the subscription again later by pasting its address."
msgstr "Pretplatu možete kasnije ponovno dodati lijepljenjem njezine adrese."

#: crates/obscure-app/src/window.rs:551 crates/obscure-app/src/window.rs:692 crates/obscure-app/src/ui/server-dialog.blp:82
msgid "Remove"
msgstr "Ukloni"

#: crates/obscure-app/src/window.rs:571 crates/obscure-app/src/tray.rs:81
msgid "Disconnect"
msgstr "Odspoji"

#: crates/obscure-app/src/window.rs:670
msgid "Server details"
msgstr "Detalji poslužitelja"

#: crates/obscure-app/src/window.rs:687
msgid "Remove “%s”?"
msgstr "Ukloniti „%s”?"

#: crates/obscure-app/src/window.rs:688
msgid "You can add it again later by pasting its link."
msgstr "Kasnije ga možete ponovno dodati lijepljenjem poveznice."

#: crates/obscure-app/src/window.rs:712
msgid "These servers were already added."
msgstr "Ovi poslužitelji već su bili dodani."

#: crates/obscure-app/src/window.rs:714
msgid "%n server added."
msgid_plural "%n servers added."
msgstr[0] "Dodan %n poslužitelj."
msgstr[1] "Dodana %n poslužitelja."
msgstr[2] "Dodano %n poslužitelja."

#: crates/obscure-app/src/window.rs:720
msgid "Downloading the subscription…"
msgstr "Preuzimanje pretplate…"

#: crates/obscure-app/src/window.rs:725
msgid "Subscription updated: %n server."
msgid_plural "Subscription updated: %n servers."
msgstr[0] "Pretplata ažurirana: %n poslužitelj."
msgstr[1] "Pretplata ažurirana: %n poslužitelja."
msgstr[2] "Pretplata ažurirana: %n poslužitelja."

#: crates/obscure-app/src/connection.rs:206 crates/obscure-app/src/connection.rs:994
msgid "Disconnected"
msgstr "Odspojeno"

#: crates/obscure-app/src/connection.rs:820
msgid "Finding the fastest server…"
msgstr "Traženje najbržeg poslužitelja…"

#: crates/obscure-app/src/connection.rs:846
msgid "Choose a server to connect"
msgstr "Odaberite poslužitelj za povezivanje"

#: crates/obscure-app/src/connection.rs:874 crates/obscure-app/src/connection.rs:966
msgid "Connecting…"
msgstr "Povezivanje…"

#: crates/obscure-app/src/connection.rs:910
msgid "Disconnecting…"
msgstr "Odspajanje…"

#: crates/obscure-app/src/connection.rs:933
msgid "Preparing the connection engine…"
msgstr "Priprema pogona veze…"

#: crates/obscure-app/src/connection.rs:944
msgid "Downloading the connection engine: %a of %b MB"
msgstr "Preuzimanje pogona veze: %a od %b MB"

#: crates/obscure-app/src/connection.rs:947
msgid "Downloading the connection engine: %a MB"
msgstr "Preuzimanje pogona veze: %a MB"

#: crates/obscure-app/src/connection.rs:952
msgid "Verifying the download…"
msgstr "Provjera preuzimanja…"

#: crates/obscure-app/src/connection.rs:954
msgid "Installing the connection engine…"
msgstr "Instalacija pogona veze…"

#: crates/obscure-app/src/connection.rs:983
msgid "Connected · system proxy active"
msgstr "Povezano · proxy sustava aktivan"

#: crates/obscure-app/src/connection.rs:984
msgid "Connected · local proxy only"
msgstr "Povezano · samo lokalni proxy"

#: crates/obscure-app/src/connection.rs:985
msgid "Connected · all traffic through the tunnel"
msgstr "Povezano · sav promet kroz tunel"

#: crates/obscure-app/src/connection.rs:989
msgid "Connected"
msgstr "Povezano"

#: crates/obscure-app/src/connection.rs:1006
msgid "Connection failed"
msgstr "Povezivanje nije uspjelo"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "Ova vrsta poveznice još nije podržana: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "Poveznica izgleda nepotpuno ili nevažeće."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "Internetska veza je predugo trajala."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "Nije moguće pristupiti internetu za preuzimanje pogona veze."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "Nije moguće preuzeti pogon veze. Pokušajte ponovno kasnije."

#: crates/obscure-app/src/humanize.rs:20
msgid "The downloaded file is corrupted. It will be downloaded again on the next attempt."
msgstr "Preuzeta datoteka je oštećena. Bit će ponovno preuzeta pri sljedećem pokušaju."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "Nije moguće raspakirati pogon veze."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "Pogon veze još nije preuzet."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "Provjerite javni ključ poslužitelja."

#: crates/obscure-app/src/humanize.rs:28
msgid "The server identifier is not valid."
msgstr "Identifikator poslužitelja nije valjan."

#: crates/obscure-app/src/humanize.rs:30
msgid "Check the server details."
msgstr "Provjerite podatke poslužitelja."

#: crates/obscure-app/src/humanize.rs:34
msgid "This server has a configuration the engine did not accept."
msgstr "Ovaj poslužitelj ima konfiguraciju koju pogon nije prihvatio."

#: crates/obscure-app/src/humanize.rs:41
msgid "The local port is already in use by another program. Change it in Preferences."
msgstr "Lokalni port već koristi drugi program. Promijenite ga u Postavkama."

#: crates/obscure-app/src/humanize.rs:44
msgid "The connection engine stopped unexpectedly."
msgstr "Pogon veze se neočekivano zaustavio."

#: crates/obscure-app/src/humanize.rs:47
msgid "The connection engine did not respond in time."
msgstr "Pogon veze nije odgovorio na vrijeme."

#: crates/obscure-app/src/humanize.rs:49
msgid "Could not change the system proxy. The local connection is still available."
msgstr "Nije moguće promijeniti proxy sustava. Lokalna veza i dalje je dostupna."

#: crates/obscure-app/src/humanize.rs:51
msgid "Could not notify the system about the new proxy."
msgstr "Nije moguće obavijestiti sustav o novom proxyju."

#: crates/obscure-app/src/humanize.rs:52
msgid "Could not read or write Obscure's files."
msgstr "Nije moguće čitati ili pisati datoteke programa Obscure."

