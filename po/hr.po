msgstr "Zalijepite poveznice poslužitelja (jednu po retku) ili adresu svoje pretplate."

#: crates/obscure-app/src/ui/import-dialog.blp:79
msgid "Paste"
msgstr "Zalijepi"

#: crates/obscure-app/src/ui/import-dialog.blp:84
msgid "Read a QR code from an image file"
msgstr "Pročitaj QR kod iz slikovne datoteke"

#: crates/obscure-app/src/ui/import-dialog.blp:89
msgid "QR from Image"
msgstr "QR iz slike"

#: crates/obscure-app/src/ui/import-dialog.blp:94
msgid "Take a screenshot and read the QR code in it"
msgstr "Snimi zaslon i pročitaj QR kod na njemu"

#: crates/obscure-app/src/ui/import-dialog.blp:99
msgid "QR from Screen"
msgstr "QR sa zaslona"

#: crates/obscure-app/src/application.rs:96
msgid "The system proxy settings from a previous session were restored."
msgstr "Postavke proxyja sustava iz prethodne sesije su vraćene."

#. Translators: replace with your name and, optionally, e-mail.
#: crates/obscure-app/src/application.rs:396
msgid "translator-credits"
msgstr ""

#: crates/obscure-app/src/application.rs:400
msgid "Obscure uses Xray-core, downloaded separately on first run."
msgstr "Obscure koristi Xray-core, koji se zasebno preuzima pri prvom pokretanju."

#: crates/obscure-app/src/application.rs:406
msgid "Project plan"
msgstr "Plan projekta"

#: crates/obscure-app/src/window.rs:221
msgid "The clipboard does not contain a server link."
msgstr "Međuspremnik ne sadrži poveznicu poslužitelja."

#: crates/obscure-app/src/window.rs:243
msgid "Text files"
msgstr "Tekstualne datoteke"

#: crates/obscure-app/src/window.rs:250
msgid "Import servers from a file"
msgstr "Uvezi poslužitelje iz datoteke"

#: crates/obscure-app/src/window.rs:270
msgid "Could not read that file."
msgstr "Nije moguće pročitati tu datoteku."

#: crates/obscure-app/src/window.rs:358
msgid "Environment variables copied. Paste them in a terminal."
msgstr "Varijable okruženja kopirane. Zalijepite ih u terminal."

#: crates/obscure-app/src/window.rs:488
msgid "Update now"
msgstr "Ažuriraj sada"

#: crates/obscure-app/src/window.rs:518
msgid "Remove subscription"
msgstr "Ukloni pretplatu"

#: crates/obscure-app/src/window.rs:535
msgid "Remove “%s” and all its servers?"
msgstr "Ukloniti „%s” i sve njegove poslužitelje?"

#: crates/obscure-app/src/window.rs:537
msgid "You can add the subscription again later by pasting its address."
msgstr "Pretplatu možete kasnije ponovno dodati lijepljenjem njezine adrese."

#: crates/obscure-app/src/window.rs:542 crates/obscure-app/src/window.rs:663
#: crates/obscure-app/src/ui/server-dialog.blp:82
msgid "Remove"
msgstr "Ukloni"

#: crates/obscure-app/src/window.rs:562 crates/obscure-app/src/tray.rs:81
msgid "Disconnect"
msgstr "Odspoji"

#: crates/obscure-app/src/window.rs:641
msgid "Server details"
msgstr "Detalji poslužitelja"

#: crates/obscure-app/src/window.rs:658
msgid "Remove “%s”?"
msgstr "Ukloniti „%s”?"

#: crates/obscure-app/src/window.rs:659
msgid "You can add it again later by pasting its link."
msgstr "Kasnije ga možete ponovno dodati lijepljenjem poveznice."

#: crates/obscure-app/src/window.rs:683
msgid "These servers were already added."
msgstr "Ovi poslužitelji već su bili dodani."

#: crates/obscure-app/src/window.rs:685
msgid "%n server added."
msgid_plural "%n servers added."
msgstr[0] "Dodan %n poslužitelj."
msgstr[1] "Dodana %n poslužitelja."
msgstr[2] "Dodano %n poslužitelja."

#: crates/obscure-app/src/window.rs:691
msgid "Downloading the subscription…"
msgstr "Preuzimanje pretplate…"

#: crates/obscure-app/src/window.rs:696
msgid "Subscription updated: %n server."
msgid_plural "Subscription updated: %n servers."
msgstr[0] "Pretplata ažurirana: %n poslužitelj."
msgstr[1] "Pretplata ažurirana: %n poslužitelja."
msgstr[2] "Pretplata ažurirana: %n poslužitelja."

#: crates/obscure-app/src/connection.rs:199
#: crates/obscure-app/src/connection.rs:855
msgid "Disconnected"
msgstr "Odspojeno"

#: crates/obscure-app/src/connection.rs:694
msgid "Finding the fastest server…"
msgstr "Traženje najbržeg poslužitelja…"

#: crates/obscure-app/src/connection.rs:720
msgid "Choose a server to connect"
msgstr "Odaberite poslužitelj za povezivanje"

#: crates/obscure-app/src/connection.rs:737
#: crates/obscure-app/src/connection.rs:827
msgid "Connecting…"
msgstr "Povezivanje…"

#: crates/obscure-app/src/connection.rs:771
msgid "Disconnecting…"
msgstr "Odspajanje…"

#: crates/obscure-app/src/connection.rs:794
msgid "Preparing the connection engine…"
msgstr "Priprema pogona veze…"

#: crates/obscure-app/src/connection.rs:805
msgid "Downloading the connection engine: %a of %b MB"
msgstr "Preuzimanje pogona veze: %a od %b MB"

#: crates/obscure-app/src/connection.rs:808
msgid "Downloading the connection engine: %a MB"
msgstr "Preuzimanje pogona veze: %a MB"

#: crates/obscure-app/src/connection.rs:813
msgid "Verifying the download…"
msgstr "Provjera preuzimanja…"

#: crates/obscure-app/src/connection.rs:815
msgid "Installing the connection engine…"
msgstr "Instalacija pogona veze…"

#: crates/obscure-app/src/connection.rs:844
msgid "Connected · system proxy active"
msgstr "Povezano · proxy sustava aktivan"

#: crates/obscure-app/src/connection.rs:845
msgid "Connected · local proxy only"
msgstr "Povezano · samo lokalni proxy"

#: crates/obscure-app/src/connection.rs:846
#: crates/obscure-app/src/connection.rs:850
msgid "Connected"
msgstr "Povezano"

#: crates/obscure-app/src/connection.rs:867
msgid "Connection failed"
msgstr "Povezivanje nije uspjelo"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "Ova vrsta poveznice još nije podržana: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "Poveznica izgleda nepotpuno ili nevažeće."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "Internetska veza je predugo trajala."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "Nije moguće pristupiti internetu za preuzimanje pogona veze."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "Nije moguće preuzeti pogon veze. Pokušajte ponovno kasnije."

#: crates/obscure-app/src/humanize.rs:20
msgid "The downloaded file is corrupted. It will be downloaded again on the next attempt."
msgstr "Preuzeta datoteka je oštećena. Bit će ponovno preuzeta pri sljedećem pokušaju."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "Nije moguće raspakirati pogon veze."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "Pogon veze još nije preuzet."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "Provjerite javni ključ poslužitelja."

#: crates/obscure-app/src/humanize.rs:28
msgid "The server identifier is not valid."
msgstr "Identifikator poslužitelja nije valjan."

#: crates/obscure-app/src/humanize.rs:30
msgid "Check the server details."
msgstr "Provjerite podatke poslužitelja."

#: crates/obscure-app/src/humanize.rs:34
msgid "This server has a configuration the engine did not accept."
msgstr "Ovaj poslužitelj ima konfiguraciju koju pogon nije prihvatio."

#: crates/obscure-app/src/humanize.rs:41
msgid "The local port is already in use by another program. Change it in Preferences."
msgstr "Lokalni port već koristi drugi program. Promijenite ga u Postavkama."

#: crates/obscure-app/src/humanize.rs:44
msgid "The connection engine stopped unexpectedly."
msgstr "Pogon veze se neočekivano zaustavio."

#: crates/obscure-app/src/humanize.rs:47
msgid "The connection engine did not respond in time."
msgstr "Pogon veze nije odgovorio na vrijeme."

#: crates/obscure-app/src/humanize.rs:49
msgid "Could not change the system proxy. The local connection is still available."
msgstr "Nije moguće promijeniti proxy sustava. Lokalna veza i dalje je dostupna."

#: crates/obscure-app/src/humanize.rs:51
msgid "Could not notify the system about the new proxy."
msgstr "Nije moguće obavijestiti sustav o novom proxyju."

#: crates/obscure-app/src/humanize.rs:52
msgid "Could not read or write Obscure's files."
msgstr "Nije moguće čitati ili pisati datoteke programa Obscure."

#: crates/obscure-app/src/humanize.rs:53
msgid "Could not read traffic statistics."
msgstr "Nije moguće pročitati statistiku prometa."

#: crates/obscure-app/src/humanize.rs:54
msgid "The server did not respond to the latency test."
msgstr "Poslužitelj nije odgovorio na test latencije."

#: crates/obscure-app/src/humanize.rs:55
msgid "The subscription could not be read. Check the address."
msgstr "Pretplatu nije moguće pročitati. Provjerite adresu."

#: crates/obscure-app/src/humanize.rs:57
msgid "This subscription is in Clash format, which Obscure does not support yet."
msgstr "Ova pretplata je u Clash formatu, koji Obscure još ne podržava."

#: crates/obscure-app/src/import_dialog.rs:60
#: crates/obscure-app/src/import_dialog.rs:253
msgid "No valid link found."
msgstr "Nije pronađena valjana poveznica."

#: crates/obscure-app/src/import_dialog.rs:74
msgid "Images"
msgstr "Slike"

#: crates/obscure-app/src/import_dialog.rs:79
msgid "Choose an image with a QR code"
msgstr "Odaberite sliku s QR kodom"

#: crates/obscure-app/src/import_dialog.rs:97
#: crates/obscure-app/src/import_dialog.rs:149
msgid "No QR code was found in that image."
msgstr "Na toj slici nije pronađen QR kod."

#: crates/obscure-app/src/import_dialog.rs:119
msgid "No QR code was found on the screen. Make sure it is fully visible and try again."
msgstr "Na zaslonu nije pronađen QR kod. Provjerite je li potpuno vidljiv i pokušajte ponovno."

#: crates/obscure-app/src/import_dialog.rs:246
msgid "Subscription address: the servers will be downloaded and kept up to date."
msgstr "Adresa pretplate: poslužitelji će se preuzeti i održavati ažurnima."

#: crates/obscure-app/src/import_dialog.rs:256
msgid "%n server ready to add."
msgid_plural "%n servers ready to add."
