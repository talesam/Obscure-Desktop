msgid "Quit"
msgstr "Έξοδος"

#: crates/obscure-app/src/ui/preferences-dialog.blp:14
msgid "Behavior"
msgstr "Συμπεριφορά"

#: crates/obscure-app/src/ui/preferences-dialog.blp:17
msgid "Keep running in the background"
msgstr "Συνέχιση εκτέλεσης στο παρασκήνιο"

#: crates/obscure-app/src/ui/preferences-dialog.blp:18
msgid "Closing the window leaves Obscure in the tray, still connected."
msgstr "Το κλείσιμο του παραθύρου αφήνει το Obscure στη γραμμή συστήματος, ακόμη συνδεδεμένο."

#: crates/obscure-app/src/ui/preferences-dialog.blp:22
msgid "Start with the session"
msgstr "Έναρξη με τη συνεδρία"

#: crates/obscure-app/src/ui/preferences-dialog.blp:23
msgid "Obscure opens in the tray when you log in."
msgstr "Το Obscure ανοίγει στη γραμμή συστήματος κατά τη σύνδεση."

#: crates/obscure-app/src/ui/preferences-dialog.blp:27
msgid "Connect when Obscure starts"
msgstr "Σύνδεση όταν ξεκινά το Obscure"

#: crates/obscure-app/src/ui/preferences-dialog.blp:32
msgid "Connection"
msgstr "Σύνδεση"

#: crates/obscure-app/src/ui/preferences-dialog.blp:33
msgid "Changes apply the next time you connect. If you are connected now, Obscure reconnects."
msgstr "Οι αλλαγές ισχύουν από την επόμενη σύνδεση. Αν είστε συνδεδεμένοι τώρα, το Obscure επανασυνδέεται."

#: crates/obscure-app/src/ui/preferences-dialog.blp:36
msgid "Local port"
msgstr "Τοπική θύρα"

#: crates/obscure-app/src/ui/preferences-dialog.blp:37
msgid "Where programs on this computer reach the connection."
msgstr "Όπου τα προγράμματα αυτού του υπολογιστή βρίσκουν τη σύνδεση."

#: crates/obscure-app/src/ui/preferences-dialog.blp:49
msgid "DNS server (DNS over HTTPS)"
msgstr "Διακομιστής DNS (DNS μέσω HTTPS)"

#: crates/obscure-app/src/ui/preferences-dialog.blp:54
msgid "Try pre-release versions of the engine"
msgstr "Δοκιμή προεκδόσεων της μηχανής"

#: crates/obscure-app/src/ui/preferences-dialog.blp:55
msgid "Newer features, but less tested. Off is the safe choice."
msgstr "Νεότερες λειτουργίες, αλλά λιγότερο δοκιμασμένες. Ανενεργό είναι η ασφαλής επιλογή."

#: crates/obscure-app/src/ui/import-dialog.blp:17
#: crates/obscure-app/src/window.rs:541 crates/obscure-app/src/window.rs:570
#: crates/obscure-app/src/window.rs:662
msgid "Cancel"
msgstr "Ακύρωση"

#: crates/obscure-app/src/ui/import-dialog.blp:23
msgid "Add"
msgstr "Προσθήκη"

#: crates/obscure-app/src/ui/import-dialog.blp:42
msgid "Paste server links (one per line) or the address of your subscription."
msgstr "Επικολλήστε συνδέσμους διακομιστών (έναν ανά γραμμή) ή τη διεύθυνση της συνδρομής σας."

#: crates/obscure-app/src/ui/import-dialog.blp:79
msgid "Paste"
msgstr "Επικόλληση"

#: crates/obscure-app/src/ui/import-dialog.blp:84
msgid "Read a QR code from an image file"
msgstr "Ανάγνωση κωδικού QR από αρχείο εικόνας"

#: crates/obscure-app/src/ui/import-dialog.blp:89
msgid "QR from Image"
msgstr "QR από εικόνα"

#: crates/obscure-app/src/ui/import-dialog.blp:94
msgid "Take a screenshot and read the QR code in it"
msgstr "Λήψη στιγμιότυπου οθόνης και ανάγνωση του κωδικού QR σε αυτό"

#: crates/obscure-app/src/ui/import-dialog.blp:99
msgid "QR from Screen"
msgstr "QR από οθόνη"

#: crates/obscure-app/src/application.rs:96
msgid "The system proxy settings from a previous session were restored."
msgstr "Οι ρυθμίσεις proxy συστήματος από την προηγούμενη συνεδρία επαναφέρθηκαν."

#. Translators: replace with your name and, optionally, e-mail.
#: crates/obscure-app/src/application.rs:396
msgid "translator-credits"
msgstr ""

#: crates/obscure-app/src/application.rs:400
msgid "Obscure uses Xray-core, downloaded separately on first run."
msgstr "Το Obscure χρησιμοποιεί το Xray-core, που κατεβαίνει ξεχωριστά στην πρώτη εκτέλεση."

#: crates/obscure-app/src/application.rs:406
msgid "Project plan"
msgstr "Σχέδιο έργου"

#: crates/obscure-app/src/window.rs:221
msgid "The clipboard does not contain a server link."
msgstr "Το πρόχειρο δεν περιέχει σύνδεσμο διακομιστή."

#: crates/obscure-app/src/window.rs:243
msgid "Text files"
msgstr "Αρχεία κειμένου"

#: crates/obscure-app/src/window.rs:250
msgid "Import servers from a file"
msgstr "Εισαγωγή διακομιστών από αρχείο"

#: crates/obscure-app/src/window.rs:270
msgid "Could not read that file."
msgstr "Δεν ήταν δυνατή η ανάγνωση αυτού του αρχείου."

#: crates/obscure-app/src/window.rs:358
msgid "Environment variables copied. Paste them in a terminal."
msgstr "Οι μεταβλητές περιβάλλοντος αντιγράφηκαν. Επικολλήστε τις σε ένα τερματικό."

#: crates/obscure-app/src/window.rs:488
msgid "Update now"
msgstr "Ενημέρωση τώρα"

#: crates/obscure-app/src/window.rs:518
msgid "Remove subscription"
msgstr "Αφαίρεση συνδρομής"

#: crates/obscure-app/src/window.rs:535
msgid "Remove “%s” and all its servers?"
msgstr "Αφαίρεση του «%s» και όλων των διακομιστών του;"

#: crates/obscure-app/src/window.rs:537
msgid "You can add the subscription again later by pasting its address."
msgstr "Μπορείτε να προσθέσετε ξανά τη συνδρομή αργότερα επικολλώντας τη διεύθυνσή της."

#: crates/obscure-app/src/window.rs:542 crates/obscure-app/src/window.rs:663
#: crates/obscure-app/src/ui/server-dialog.blp:82
msgid "Remove"
msgstr "Αφαίρεση"

#: crates/obscure-app/src/window.rs:562 crates/obscure-app/src/tray.rs:81
msgid "Disconnect"
msgstr "Αποσύνδεση"

#: crates/obscure-app/src/window.rs:641
msgid "Server details"
msgstr "Λεπτομέρειες διακομιστή"

#: crates/obscure-app/src/window.rs:658
msgid "Remove “%s”?"
msgstr "Αφαίρεση του «%s»;"

#: crates/obscure-app/src/window.rs:659
msgid "You can add it again later by pasting its link."
msgstr "Μπορείτε να τον προσθέσετε ξανά αργότερα επικολλώντας τον σύνδεσμό του."

#: crates/obscure-app/src/window.rs:683
msgid "These servers were already added."
msgstr "Αυτοί οι διακομιστές είχαν ήδη προστεθεί."

#: crates/obscure-app/src/window.rs:685
msgid "%n server added."
msgid_plural "%n servers added."
msgstr[0] "Προστέθηκε %n διακομιστής."
msgstr[1] "Προστέθηκαν %n διακομιστές."

#: crates/obscure-app/src/window.rs:691
msgid "Downloading the subscription…"
msgstr "Λήψη της συνδρομής…"

#: crates/obscure-app/src/window.rs:696
msgid "Subscription updated: %n server."
msgid_plural "Subscription updated: %n servers."
msgstr[0] "Η συνδρομή ενημερώθηκε: %n διακομιστής."
msgstr[1] "Η συνδρομή ενημερώθηκε: %n διακομιστές."

#: crates/obscure-app/src/connection.rs:199
#: crates/obscure-app/src/connection.rs:855
msgid "Disconnected"
msgstr "Αποσυνδεδεμένο"

#: crates/obscure-app/src/connection.rs:694
msgid "Finding the fastest server…"
msgstr "Αναζήτηση του ταχύτερου διακομιστή…"

#: crates/obscure-app/src/connection.rs:720
msgid "Choose a server to connect"
msgstr "Επιλέξτε διακομιστή για σύνδεση"

#: crates/obscure-app/src/connection.rs:737
#: crates/obscure-app/src/connection.rs:827
msgid "Connecting…"
msgstr "Σύνδεση…"

#: crates/obscure-app/src/connection.rs:771
msgid "Disconnecting…"
msgstr "Αποσύνδεση…"

#: crates/obscure-app/src/connection.rs:794
msgid "Preparing the connection engine…"
msgstr "Προετοιμασία της μηχανής σύνδεσης…"

#: crates/obscure-app/src/connection.rs:805
msgid "Downloading the connection engine: %a of %b MB"
msgstr "Λήψη της μηχανής σύνδεσης: %a από %b MB"

#: crates/obscure-app/src/connection.rs:808
msgid "Downloading the connection engine: %a MB"
msgstr "Λήψη της μηχανής σύνδεσης: %a MB"

#: crates/obscure-app/src/connection.rs:813
msgid "Verifying the download…"
msgstr "Επαλήθευση της λήψης…"

#: crates/obscure-app/src/connection.rs:815
msgid "Installing the connection engine…"
msgstr "Εγκατάσταση της μηχανής σύνδεσης…"

#: crates/obscure-app/src/connection.rs:844
msgid "Connected · system proxy active"
msgstr "Συνδεδεμένο · proxy συστήματος ενεργός"

#: crates/obscure-app/src/connection.rs:845
msgid "Connected · local proxy only"
msgstr "Συνδεδεμένο · μόνο τοπικός proxy"

#: crates/obscure-app/src/connection.rs:846
#: crates/obscure-app/src/connection.rs:850
msgid "Connected"
msgstr "Συνδεδεμένο"

#: crates/obscure-app/src/connection.rs:867
msgid "Connection failed"
msgstr "Η σύνδεση απέτυχε"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "Αυτός ο τύπος συνδέσμου δεν υποστηρίζεται ακόμη: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "Ο σύνδεσμος φαίνεται ελλιπής ή μη έγκυρος."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "Η σύνδεση στο διαδίκτυο καθυστέρησε πολύ."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "Δεν ήταν δυνατή η πρόσβαση στο διαδίκτυο για τη λήψη της μηχανής σύνδεσης."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "Δεν ήταν δυνατή η λήψη της μηχανής σύνδεσης. Δοκιμάστε ξανά αργότερα."

#: crates/obscure-app/src/humanize.rs:20
msgid "The downloaded file is corrupted. It will be downloaded again on the next attempt."
msgstr "Το ληφθέν αρχείο είναι κατεστραμμένο. Θα ληφθεί ξανά στην επόμενη προσπάθεια."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "Δεν ήταν δυνατή η αποσυμπίεση της μηχανής σύνδεσης."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "Η μηχανή σύνδεσης δεν έχει ληφθεί ακόμη."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "Ελέγξτε το δημόσιο κλειδί του διακομιστή."

#: crates/obscure-app/src/humanize.rs:28
msgid "The server identifier is not valid."
msgstr "Το αναγνωριστικό του διακομιστή δεν είναι έγκυρο."

#: crates/obscure-app/src/humanize.rs:30
msgid "Check the server details."
msgstr "Ελέγξτε τα στοιχεία του διακομιστή."

#: crates/obscure-app/src/humanize.rs:34
msgid "This server has a configuration the engine did not accept."
msgstr "Αυτός ο διακομιστής έχει ρύθμιση που η μηχανή δεν αποδέχθηκε."

#: crates/obscure-app/src/humanize.rs:41
msgid "The local port is already in use by another program. Change it in Preferences."
msgstr "Η τοπική θύρα χρησιμοποιείται ήδη από άλλο πρόγραμμα. Αλλάξτε την στις Προτιμήσεις."

#: crates/obscure-app/src/humanize.rs:44
msgid "The connection engine stopped unexpectedly."
msgstr "Η μηχανή σύνδεσης σταμάτησε απροσδόκητα."

#: crates/obscure-app/src/humanize.rs:47
msgid "The connection engine did not respond in time."
msgstr "Η μηχανή σύνδεσης δεν απάντησε εγκαίρως."

#: crates/obscure-app/src/humanize.rs:49
msgid "Could not change the system proxy. The local connection is still available."
msgstr "Δεν ήταν δυνατή η αλλαγή του proxy συστήματος. Η τοπική σύνδεση παραμένει διαθέσιμη."

#: crates/obscure-app/src/humanize.rs:51
msgid "Could not notify the system about the new proxy."
msgstr "Δεν ήταν δυνατή η ενημέρωση του συστήματος για τον νέο proxy."

#: crates/obscure-app/src/humanize.rs:52
msgid "Could not read or write Obscure's files."
msgstr "Δεν ήταν δυνατή η ανάγνωση ή εγγραφή των αρχείων του Obscure."

#: crates/obscure-app/src/humanize.rs:53
msgid "Could not read traffic statistics."
msgstr "Δεν ήταν δυνατή η ανάγνωση των στατιστικών κίνησης."

#: crates/obscure-app/src/humanize.rs:54
msgid "The server did not respond to the latency test."
msgstr "Ο διακομιστής δεν απάντησε στη δοκιμή καθυστέρησης."

#: crates/obscure-app/src/humanize.rs:55
msgid "The subscription could not be read. Check the address."
msgstr "Δεν ήταν δυνατή η ανάγνωση της συνδρομής. Ελέγξτε τη διεύθυνση."

#: crates/obscure-app/src/humanize.rs:57
msgid "This subscription is in Clash format, which Obscure does not support yet."
msgstr "Αυτή η συνδρομή είναι σε μορφή Clash, που το Obscure δεν υποστηρίζει ακόμη."

