msgid "General"
msgstr "Γενικά"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:9 crates/obscure-app/src/ui/preferences-dialog.blp:5
msgid "Preferences"
msgstr "Προτιμήσεις"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:14
msgid "Keyboard Shortcuts"
msgstr "Συντομεύσεις πληκτρολογίου"

