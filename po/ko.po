#: data/io.github.talesam.Obscure.desktop.in.in:2
#: data/io.github.talesam.Obscure.metainfo.xml.in.in:7
#: crates/obscure-app/src/ui/window.blp:5
msgid "Obscure"
msgstr "Obscure"

#. Translators: short description shown next to the app name in menus
#: data/io.github.talesam.Obscure.desktop.in.in:4
msgid "Proxy Client"
msgstr "프록시 클라이언트"

#. Translators: the slogan of the app
#: data/io.github.talesam.Obscure.desktop.in.in:6
#: crates/obscure-app/src/ui/window.blp:38
#: crates/obscure-app/src/application.rs:399
msgid "Connect. That's it."
msgstr "연결하세요. 그게 다입니다."

#. Translators: search terms, keep the trailing semicolon and add local words
#: data/io.github.talesam.Obscure.desktop.in.in:16
msgid "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;wireguard;privacy;censorship;"
msgstr "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;wireguard;프라이버시;검열;연결;"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:8
msgid "Connect to your proxy with one button"
msgstr "버튼 하나로 프록시에 연결"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:10
msgid "Obscure is a simple client for the Xray-core engine. Paste a link or a subscription, tap Connect and you are done."
msgstr "Obscure는 Xray-core 엔진용 간단한 클라이언트입니다. 링크나 구독을 붙여 넣고 연결을 누르면 끝입니다."

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:14
msgid "Features:"
msgstr "기능:"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:16
msgid "One Connect button, no technical terms on the main screen"
msgstr "연결 버튼 하나, 메인 화면에 기술 용어 없음"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:17
msgid "Imports vless, vmess, trojan and shadowsocks links, as well as subscriptions"
msgstr "vless, vmess, trojan, shadowsocks 링크와 구독 가져오기"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:18
msgid "Applies the system proxy on GNOME and KDE, no root required"
msgstr "GNOME과 KDE에서 root 없이 시스템 프록시 적용"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:19
msgid "Downloads and updates Xray-core automatically, with integrity checks"
msgstr "무결성 검사와 함께 Xray-core 자동 다운로드 및 업데이트"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:49
msgid "Initial project skeleton."
msgstr "프로젝트의 초기 골격."

#: data/io.github.talesam.Obscure.gschema.xml.in:6
msgid "Window width"
msgstr "창 너비"

#: data/io.github.talesam.Obscure.gschema.xml.in:10
msgid "Window height"
msgstr "창 높이"

#: data/io.github.talesam.Obscure.gschema.xml.in:14
msgid "Whether the window is maximized"
msgstr "창이 최대화되었는지 여부"

#: data/io.github.talesam.Obscure.gschema.xml.in:18
msgid "Keep running in the tray when the window is closed"
msgstr "창을 닫을 때 트레이에서 계속 실행"

#: data/io.github.talesam.Obscure.gschema.xml.in:22
msgid "Start with the session (via the Background portal)"
msgstr "세션과 함께 시작 (Background 포털 사용)"

#: data/io.github.talesam.Obscure.gschema.xml.in:26
msgid "Connect automatically when the app starts"
msgstr "앱 시작 시 자동으로 연결"

#: crates/obscure-app/src/ui/window.blp:17
#: crates/obscure-app/src/ui/window.blp:51
#: crates/obscure-app/src/ui/import-dialog.blp:5
msgid "Add Server"
msgstr "서버 추가"

#: crates/obscure-app/src/ui/window.blp:24
msgid "Main Menu"
msgstr "메인 메뉴"

#: crates/obscure-app/src/ui/window.blp:39
msgid "Paste a link or a subscription to get started."
msgstr "시작하려면 링크나 구독을 붙여 넣으세요."

#: crates/obscure-app/src/ui/window.blp:137
#: crates/obscure-app/src/window.rs:578 crates/obscure-app/src/tray.rs:83
msgid "Connect"
msgstr "연결"

#: crates/obscure-app/src/ui/window.blp:149
msgid "How to apply"
msgstr "적용 방식"

#: crates/obscure-app/src/ui/window.blp:157
msgid "System proxy"
msgstr "시스템 프록시"

#: crates/obscure-app/src/ui/window.blp:158
msgid "Browsers and most apps use the connection. No administrator password needed."
msgstr "브라우저와 대부분의 앱이 이 연결을 사용합니다. 관리자 암호가 필요하지 않습니다."

#: crates/obscure-app/src/ui/window.blp:163
msgid "Local proxy only"
msgstr "로컬 프록시만"

#: crates/obscure-app/src/ui/window.blp:164
msgid "Nothing changes on the system. Point the programs you want at 127.0.0.1:2080."
msgstr "시스템은 아무것도 바뀌지 않습니다. 원하는 프로그램을 127.0.0.1:2080으로 설정하세요."

#: crates/obscure-app/src/ui/window.blp:169
msgid "Tunnel"
msgstr "터널"

#: crates/obscure-app/src/ui/window.blp:171
msgid "All traffic from this computer. Coming in a future version."
msgstr "이 컴퓨터의 모든 트래픽. 향후 버전에서 제공됩니다."

#: crates/obscure-app/src/ui/window.blp:177
msgid "What goes through the connection"
msgstr "연결을 통과하는 트래픽"

#: crates/obscure-app/src/ui/window.blp:185
msgid "Smart"
msgstr "스마트"

#: crates/obscure-app/src/ui/window.blp:186
msgid "Everything, except local network addresses. Ads are blocked."
msgstr "로컬 네트워크 주소를 제외한 모두. 광고는 차단됩니다."

#: crates/obscure-app/src/ui/window.blp:191
msgid "Everything"
msgstr "전체"

#: crates/obscure-app/src/ui/window.blp:192
msgid "All traffic goes through the connection, except local network addresses."
msgstr "로컬 네트워크 주소를 제외한 모든 트래픽이 연결을 통과합니다."

#: crates/obscure-app/src/ui/window.blp:198
msgid "Subscriptions"
msgstr "구독"

#: crates/obscure-app/src/ui/window.blp:211
msgid "Servers"
msgstr "서버"

#: crates/obscure-app/src/ui/window.blp:220
msgid "Automatic"
msgstr "자동"

#: crates/obscure-app/src/ui/window.blp:221
msgid "Tests all servers when you connect and picks the quickest one."
msgstr "연결할 때 모든 서버를 테스트하고 가장 빠른 서버를 선택합니다."

#: crates/obscure-app/src/ui/window.blp:231
msgid "Automatic: fastest server"
msgstr "자동: 가장 빠른 서버"

#: crates/obscure-app/src/ui/window.blp:237
msgid "Measure the response time of every server"
msgstr "모든 서버의 응답 시간 측정"

#: crates/obscure-app/src/ui/window.blp:242
msgid "Test All"
msgstr "모두 테스트"

#: crates/obscure-app/src/ui/window.blp:272
msgid "_Import from File…"
msgstr "파일에서 가져오기(_I)…"

#: crates/obscure-app/src/ui/window.blp:277
msgid "_Live Connections"
msgstr "실시간 연결(_L)"

#: crates/obscure-app/src/ui/window.blp:282
msgid "_Connection Log"
msgstr "연결 로그(_C)"

#: crates/obscure-app/src/ui/window.blp:287
msgid "_Copy Environment Variables"
msgstr "환경 변수 복사(_C)"

#: crates/obscure-app/src/ui/window.blp:294
msgid "_Preferences"
msgstr "기본 설정(_P)"

#: crates/obscure-app/src/ui/window.blp:299
msgid "_Keyboard Shortcuts"
msgstr "키보드 바로 가기(_K)"

#: crates/obscure-app/src/ui/window.blp:304
msgid "_About Obscure"
msgstr "Obscure 정보(_A)"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:6
#: crates/obscure-app/src/ui/preferences-dialog.blp:10
msgid "General"
msgstr "일반"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:9
#: crates/obscure-app/src/ui/preferences-dialog.blp:5
msgid "Preferences"
msgstr "기본 설정"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:14
msgid "Keyboard Shortcuts"
msgstr "키보드 바로 가기"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:19
#: crates/obscure-app/src/ui/connections-dialog.blp:5
msgid "Live Connections"
msgstr "실시간 연결"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:24
msgid "Close Window"
msgstr "창 닫기"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:29
#: crates/obscure-app/src/tray.rs:101
msgid "Quit"
msgstr "끝내기"

#: crates/obscure-app/src/ui/preferences-dialog.blp:14
msgid "Behavior"
msgstr "동작"

#: crates/obscure-app/src/ui/preferences-dialog.blp:17
msgid "Keep running in the background"
msgstr "백그라운드에서 계속 실행"

#: crates/obscure-app/src/ui/preferences-dialog.blp:18
msgid "Closing the window leaves Obscure in the tray, still connected."
msgstr "창을 닫아도 Obscure는 트레이에 남아 연결을 유지합니다."

#: crates/obscure-app/src/ui/preferences-dialog.blp:22
msgid "Start with the session"
msgstr "세션과 함께 시작"

#: crates/obscure-app/src/ui/preferences-dialog.blp:23
msgid "Obscure opens in the tray when you log in."
msgstr "로그인하면 Obscure가 트레이에서 열립니다."

#: crates/obscure-app/src/ui/preferences-dialog.blp:27
msgid "Connect when Obscure starts"
msgstr "Obscure 시작 시 연결"

#: crates/obscure-app/src/ui/preferences-dialog.blp:32
msgid "Connection"
msgstr "연결"

#: crates/obscure-app/src/ui/preferences-dialog.blp:33
msgid "Changes apply the next time you connect. If you are connected now, Obscure reconnects."
msgstr "변경 사항은 다음 연결 시 적용됩니다. 지금 연결되어 있다면 Obscure가 다시 연결합니다."

#: crates/obscure-app/src/ui/preferences-dialog.blp:36
msgid "Local port"
msgstr "로컬 포트"

#: crates/obscure-app/src/ui/preferences-dialog.blp:37
msgid "Where programs on this computer reach the connection."
msgstr "이 컴퓨터의 프로그램이 연결에 접근하는 포트입니다."

#: crates/obscure-app/src/ui/preferences-dialog.blp:49
msgid "DNS server (DNS over HTTPS)"
msgstr "DNS 서버 (DNS over HTTPS)"

#: crates/obscure-app/src/ui/preferences-dialog.blp:54
msgid "Try pre-release versions of the engine"
msgstr "엔진의 사전 릴리스 버전 사용해 보기"

#: crates/obscure-app/src/ui/preferences-dialog.blp:55
msgid "Newer features, but less tested. Off is the safe choice."
msgstr "새로운 기능이 있지만 덜 테스트되었습니다. 끄는 것이 안전한 선택입니다."

#: crates/obscure-app/src/ui/import-dialog.blp:17
#: crates/obscure-app/src/window.rs:541 crates/obscure-app/src/window.rs:570
#: crates/obscure-app/src/window.rs:662
msgid "Cancel"
msgstr "취소"

#: crates/obscure-app/src/ui/import-dialog.blp:23
msgid "Add"
msgstr "추가"

#: crates/obscure-app/src/ui/import-dialog.blp:42
msgid "Paste server links (one per line) or the address of your subscription."
msgstr "서버 링크(한 줄에 하나) 또는 구독 주소를 붙여 넣으세요."

#: crates/obscure-app/src/ui/import-dialog.blp:79
msgid "Paste"
msgstr "붙여 넣기"

#: crates/obscure-app/src/ui/import-dialog.blp:84
msgid "Read a QR code from an image file"
msgstr "이미지 파일에서 QR 코드 읽기"

#: crates/obscure-app/src/ui/import-dialog.blp:89
msgid "QR from Image"
msgstr "이미지에서 QR"

#: crates/obscure-app/src/ui/import-dialog.blp:94
msgid "Take a screenshot and read the QR code in it"
msgstr "스크린샷을 찍어 그 안의 QR 코드 읽기"

#: crates/obscure-app/src/ui/import-dialog.blp:99
msgid "QR from Screen"
msgstr "화면에서 QR"

#: crates/obscure-app/src/application.rs:96
msgid "The system proxy settings from a previous session were restored."
msgstr "이전 세션의 시스템 프록시 설정을 복원했습니다."

#. Translators: replace with your name and, optionally, e-mail.
#: crates/obscure-app/src/application.rs:396
msgid "translator-credits"
msgstr ""

#: crates/obscure-app/src/application.rs:400
msgid "Obscure uses Xray-core, downloaded separately on first run."
msgstr "Obscure는 첫 실행 시 별도로 다운로드되는 Xray-core를 사용합니다."

#: crates/obscure-app/src/application.rs:406
msgid "Project plan"
msgstr "프로젝트 계획"

#: crates/obscure-app/src/window.rs:221
msgid "The clipboard does not contain a server link."
msgstr "클립보드에 서버 링크가 없습니다."

#: crates/obscure-app/src/window.rs:243
msgid "Text files"
msgstr "텍스트 파일"

#: crates/obscure-app/src/window.rs:250
msgid "Import servers from a file"
msgstr "파일에서 서버 가져오기"

#: crates/obscure-app/src/window.rs:270
msgid "Could not read that file."
msgstr "해당 파일을 읽을 수 없습니다."

#: crates/obscure-app/src/window.rs:358
msgid "Environment variables copied. Paste them in a terminal."
msgstr "환경 변수를 복사했습니다. 터미널에 붙여 넣으세요."

#: crates/obscure-app/src/window.rs:488
msgid "Update now"
msgstr "지금 업데이트"

#: crates/obscure-app/src/window.rs:518
msgid "Remove subscription"
msgstr "구독 제거"

#: crates/obscure-app/src/window.rs:535
msgid "Remove “%s” and all its servers?"
msgstr "“%s”과(와) 그 모든 서버를 제거할까요?"

#: crates/obscure-app/src/window.rs:537
msgid "You can add the subscription again later by pasting its address."
msgstr "나중에 주소를 붙여 넣어 구독을 다시 추가할 수 있습니다."

#: crates/obscure-app/src/window.rs:542 crates/obscure-app/src/window.rs:663
#: crates/obscure-app/src/ui/server-dialog.blp:82
msgid "Remove"
msgstr "제거"

#: crates/obscure-app/src/window.rs:562 crates/obscure-app/src/tray.rs:81
msgid "Disconnect"
msgstr "연결 끊기"

#: crates/obscure-app/src/window.rs:641
msgid "Server details"
msgstr "서버 정보"

#: crates/obscure-app/src/window.rs:658
msgid "Remove “%s”?"
msgstr "“%s”을(를) 제거할까요?"

#: crates/obscure-app/src/window.rs:659
msgid "You can add it again later by pasting its link."
msgstr "나중에 링크를 붙여 넣어 다시 추가할 수 있습니다."

#: crates/obscure-app/src/window.rs:683
msgid "These servers were already added."
msgstr "이 서버들은 이미 추가되어 있습니다."

#: crates/obscure-app/src/window.rs:685
msgid "%n server added."
msgid_plural "%n servers added."
msgstr[0] "서버 %n개를 추가했습니다."

#: crates/obscure-app/src/window.rs:691
msgid "Downloading the subscription…"
msgstr "구독 다운로드 중…"

#: crates/obscure-app/src/window.rs:696
msgid "Subscription updated: %n server."
msgid_plural "Subscription updated: %n servers."
msgstr[0] "구독을 업데이트했습니다: 서버 %n개."

#: crates/obscure-app/src/connection.rs:199
#: crates/obscure-app/src/connection.rs:855
msgid "Disconnected"
msgstr "연결 끊김"

#: crates/obscure-app/src/connection.rs:694
msgid "Finding the fastest server…"
msgstr "가장 빠른 서버를 찾는 중…"

#: crates/obscure-app/src/connection.rs:720
msgid "Choose a server to connect"
msgstr "연결할 서버를 선택하세요"

#: crates/obscure-app/src/connection.rs:737
#: crates/obscure-app/src/connection.rs:827
msgid "Connecting…"
msgstr "연결 중…"

#: crates/obscure-app/src/connection.rs:771
msgid "Disconnecting…"
msgstr "연결 끊는 중…"

#: crates/obscure-app/src/connection.rs:794
msgid "Preparing the connection engine…"
msgstr "연결 엔진 준비 중…"

#: crates/obscure-app/src/connection.rs:805
msgid "Downloading the connection engine: %a of %b MB"
msgstr "연결 엔진 다운로드 중: %a / %b MB"

#: crates/obscure-app/src/connection.rs:808
msgid "Downloading the connection engine: %a MB"
msgstr "연결 엔진 다운로드 중: %a MB"

#: crates/obscure-app/src/connection.rs:813
msgid "Verifying the download…"
msgstr "다운로드 확인 중…"

#: crates/obscure-app/src/connection.rs:815
msgid "Installing the connection engine…"
msgstr "연결 엔진 설치 중…"

#: crates/obscure-app/src/connection.rs:844
msgid "Connected · system proxy active"
msgstr "연결됨 · 시스템 프록시 활성"

#: crates/obscure-app/src/connection.rs:845
msgid "Connected · local proxy only"
msgstr "연결됨 · 로컬 프록시만"

#: crates/obscure-app/src/connection.rs:846
#: crates/obscure-app/src/connection.rs:850
msgid "Connected"
msgstr "연결됨"

#: crates/obscure-app/src/connection.rs:867
msgid "Connection failed"
msgstr "연결 실패"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "이 종류의 링크는 아직 지원되지 않습니다: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "링크가 불완전하거나 잘못된 것 같습니다."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "인터넷 연결에 너무 오래 걸렸습니다."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "연결 엔진을 다운로드할 인터넷에 접근할 수 없습니다."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "연결 엔진을 다운로드할 수 없습니다. 나중에 다시 시도하세요."

#: crates/obscure-app/src/humanize.rs:20
msgid "The downloaded file is corrupted. It will be downloaded again on the next attempt."
msgstr "다운로드한 파일이 손상되었습니다. 다음 시도 때 다시 다운로드합니다."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "연결 엔진을 풀 수 없습니다."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "연결 엔진이 아직 다운로드되지 않았습니다."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "서버의 공개 키를 확인하세요."

