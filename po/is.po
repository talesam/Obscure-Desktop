#: crates/obscure-app/src/ui/preferences-dialog.blp:10
msgid "General"
msgstr "Almennt"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:9
#: crates/obscure-app/src/ui/preferences-dialog.blp:5
msgid "Preferences"
msgstr "Kjörstillingar"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:14
msgid "Keyboard Shortcuts"
msgstr "Flýtilyklar"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:19
msgid "Close Window"
msgstr "Loka glugga"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:24
#: crates/obscure-app/src/tray.rs:101
msgid "Quit"
msgstr "Hætta"

#: crates/obscure-app/src/ui/preferences-dialog.blp:14
msgid "Behavior"
msgstr "Hegðun"

#: crates/obscure-app/src/ui/preferences-dialog.blp:17
msgid "Keep running in the background"
msgstr "Halda áfram að keyra í bakgrunni"

#: crates/obscure-app/src/ui/preferences-dialog.blp:18
msgid "Closing the window leaves Obscure in the tray, still connected."
msgstr "Að loka glugganum skilur Obscure eftir í kerfisbakkanum, enn tengt."

#: crates/obscure-app/src/ui/preferences-dialog.blp:23
msgid "Connection"
msgstr "Tenging"

#: crates/obscure-app/src/ui/preferences-dialog.blp:24
msgid "Changes apply the next time you connect. If you are connected now, Obscure reconnects."
msgstr "Breytingar gilda við næstu tengingu. Ef þú ert tengd(ur) núna endurtengist Obscure."

#: crates/obscure-app/src/ui/preferences-dialog.blp:27
msgid "Local port"
msgstr "Staðbundin gátt"

#: crates/obscure-app/src/ui/preferences-dialog.blp:28
msgid "Where programs on this computer reach the connection."
msgstr "Þar sem forrit á þessari tölvu finna tenginguna."

#: crates/obscure-app/src/ui/preferences-dialog.blp:40
msgid "DNS server (DNS over HTTPS)"
msgstr "DNS-þjónn (DNS yfir HTTPS)"

#: crates/obscure-app/src/ui/preferences-dialog.blp:45
msgid "Try pre-release versions of the engine"
msgstr "Prófa forútgáfur af vélinni"

#: crates/obscure-app/src/ui/preferences-dialog.blp:46
msgid "Newer features, but less tested. Off is the safe choice."
msgstr "Nýrri eiginleikar en minna prófaðir. Slökkt er öruggi kosturinn."

#: crates/obscure-app/src/ui/import-dialog.blp:17
#: crates/obscure-app/src/window.rs:398 crates/obscure-app/src/window.rs:467
msgid "Cancel"
msgstr "Hætta við"

#: crates/obscure-app/src/ui/import-dialog.blp:23
msgid "Add"
msgstr "Bæta við"

#: crates/obscure-app/src/ui/import-dialog.blp:42
msgid "Paste the server link below, or the links from your subscription, one per line."
msgstr "Límdu tengil þjónsins hér fyrir neðan, eða tengla úr áskriftinni þinni, einn í hverri línu."

#: crates/obscure-app/src/ui/import-dialog.blp:75
msgid "Paste from Clipboard"
msgstr "Líma af klippispjaldi"

#: crates/obscure-app/src/application.rs:67
msgid "The system proxy settings from a previous session were restored."
msgstr "Kerfis-proxy stillingar frá fyrri setu voru endurheimtar."

#. Translators: replace with your name and, optionally, e-mail.
#: crates/obscure-app/src/application.rs:328
msgid "translator-credits"
msgstr ""

#: crates/obscure-app/src/application.rs:332
msgid "Obscure uses Xray-core, downloaded separately on first run."
msgstr "Obscure notar Xray-core, sem er sótt sérstaklega við fyrstu keyrslu."

#: crates/obscure-app/src/application.rs:338
msgid "Project plan"
msgstr "Verkáætlun"

#: crates/obscure-app/src/window.rs:198
msgid "The clipboard does not contain a server link."
msgstr "Klippispjaldið inniheldur ekki tengil á þjón."

#: crates/obscure-app/src/window.rs:216
msgid "Text files"
msgstr "Textaskrár"

#: crates/obscure-app/src/window.rs:223
msgid "Import servers from a file"
msgstr "Flytja inn þjóna úr skrá"

#: crates/obscure-app/src/window.rs:243
msgid "Could not read that file."
msgstr "Ekki tókst að lesa þá skrá."

#: crates/obscure-app/src/window.rs:309
msgid "Environment variables copied. Paste them in a terminal."
msgstr "Umhverfisbreytur afritaðar. Límdu þær í skjáhermi."

#: crates/obscure-app/src/window.rs:390 crates/obscure-app/src/tray.rs:81
msgid "Disconnect"
msgstr "Aftengjast"

#: crates/obscure-app/src/window.rs:446
msgid "Server details"
msgstr "Upplýsingar um þjón"

#: crates/obscure-app/src/window.rs:463
msgid "Remove “%s”?"
msgstr "Fjarlægja „%s“?"

#: crates/obscure-app/src/window.rs:464
msgid "You can add it again later by pasting its link."
msgstr "Þú getur bætt honum við aftur síðar með því að líma tengilinn."

#: crates/obscure-app/src/window.rs:468
#: crates/obscure-app/src/ui/server-dialog.blp:82
msgid "Remove"
msgstr "Fjarlægja"

#: crates/obscure-app/src/window.rs:488
msgid "These servers were already added."
msgstr "Þessum þjónum hafði þegar verið bætt við."

#: crates/obscure-app/src/window.rs:490
msgid "%n server added."
msgid_plural "%n servers added."
msgstr[0] "%n þjóni bætt við."
msgstr[1] "%n þjónum bætt við."

#: crates/obscure-app/src/connection.rs:161
#: crates/obscure-app/src/connection.rs:527
msgid "Disconnected"
msgstr "Ótengt"

#: crates/obscure-app/src/connection.rs:396
msgid "Choose a server to connect"
msgstr "Veldu þjón til að tengjast"

#: crates/obscure-app/src/connection.rs:413
#: crates/obscure-app/src/connection.rs:503
msgid "Connecting…"
msgstr "Tengist…"

#: crates/obscure-app/src/connection.rs:447
msgid "Disconnecting…"
msgstr "Aftengist…"

#: crates/obscure-app/src/connection.rs:470
msgid "Preparing the connection engine…"
msgstr "Undirbý tengivél…"

#: crates/obscure-app/src/connection.rs:481
msgid "Downloading the connection engine: %a of %b MB"
msgstr "Sæki tengivél: %a af %b MB"

#: crates/obscure-app/src/connection.rs:484
msgid "Downloading the connection engine: %a MB"
msgstr "Sæki tengivél: %a MB"

#: crates/obscure-app/src/connection.rs:489
msgid "Verifying the download…"
msgstr "Staðfesti niðurhal…"

#: crates/obscure-app/src/connection.rs:491
msgid "Installing the connection engine…"
msgstr "Set upp tengivél…"

#: crates/obscure-app/src/connection.rs:520
msgid "Connected · system proxy active"
msgstr "Tengt · kerfis-proxy virkur"

#: crates/obscure-app/src/connection.rs:521
msgid "Connected · local proxy only"
msgstr "Tengt · aðeins staðbundinn proxy"

#: crates/obscure-app/src/connection.rs:522
msgid "Connected"
msgstr "Tengt"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "Þessi gerð tengils er ekki studd ennþá: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "Tengillinn virðist ófullkominn eða ógildur."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "Nettengingin tók of langan tíma."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "Náði ekki tengingu við internetið til að sækja tengivélina."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "Ekki tókst að sækja tengivélina. Reyndu aftur síðar."

#: crates/obscure-app/src/humanize.rs:20
msgid "The downloaded file is corrupted. It will be downloaded again on the next attempt."
msgstr "Sótta skráin er skemmd. Hún verður sótt aftur í næstu tilraun."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "Ekki tókst að afþjappa tengivélina."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "Tengivélin hefur ekki verið sótt ennþá."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "Athugaðu dreifilykil þjónsins."

#: crates/obscure-app/src/humanize.rs:28
msgid "The server identifier is not valid."
msgstr "Auðkenni þjónsins er ekki gilt."

#: crates/obscure-app/src/humanize.rs:30
msgid "Check the server details."
msgstr "Athugaðu upplýsingar þjónsins."

#: crates/obscure-app/src/humanize.rs:34
msgid "This server has a configuration the engine did not accept."
msgstr "Þessi þjónn hefur uppsetningu sem vélin samþykkti ekki."

#: crates/obscure-app/src/humanize.rs:41
msgid "The local port is already in use by another program. Change it in Preferences."
msgstr "Staðbundna gáttin er þegar í notkun af öðru forriti. Breyttu henni í Kjörstillingum."

#: crates/obscure-app/src/humanize.rs:44
msgid "The connection engine stopped unexpectedly."
msgstr "Tengivélin stöðvaðist óvænt."

#: crates/obscure-app/src/humanize.rs:47
msgid "The connection engine did not respond in time."
msgstr "Tengivélin svaraði ekki í tíma."

#: crates/obscure-app/src/humanize.rs:49
msgid "Could not change the system proxy. The local connection is still available."
msgstr "Ekki tókst að breyta kerfis-proxy. Staðbundna tengingin er enn tiltæk."

#: crates/obscure-app/src/humanize.rs:51
msgid "Could not notify the system about the new proxy."
msgstr "Ekki tókst að láta kerfið vita af nýja proxy-þjóninum."

#: crates/obscure-app/src/humanize.rs:52
msgid "Could not read or write Obscure's files."
msgstr "Ekki tókst að lesa eða skrifa skrár Obscure."

#: crates/obscure-app/src/humanize.rs:53
msgid "Could not read traffic statistics."
msgstr "Ekki tókst að lesa umferðartölfræði."

#: crates/obscure-app/src/humanize.rs:54
msgid "The server did not respond to the latency test."
msgstr "Þjónninn svaraði ekki töfprófinu."

#: crates/obscure-app/src/humanize.rs:55
msgid "The subscription could not be read. Check the address."
msgstr "Ekki tókst að lesa áskriftina. Athugaðu vistfangið."

#: crates/obscure-app/src/humanize.rs:57
msgid "This subscription is in Clash format, which Obscure does not support yet."
msgstr "Þessi áskrift er á Clash-sniði sem Obscure styður ekki ennþá."

#: crates/obscure-app/src/import_dialog.rs:49
#: crates/obscure-app/src/import_dialog.rs:159
msgid "No valid link found."
msgstr "Enginn gildur tengill fannst."

#: crates/obscure-app/src/import_dialog.rs:162
msgid "%n server ready to add."
msgid_plural "%n servers ready to add."
msgstr[0] "%n þjónn tilbúinn til að bæta við."
msgstr[1] "%n þjónar tilbúnir til að bæta við."

#: crates/obscure-app/src/import_dialog.rs:172
msgid "%n link could not be read."
msgid_plural "%n links could not be read."
msgstr[0] "Ekki tókst að lesa %n tengil."
msgstr[1] "Ekki tókst að lesa %n tengla."

#: crates/obscure-app/src/tray.rs:87
msgid "Show Obscure"
msgstr "Sýna Obscure"

#: crates/obscure-app/src/ui/log-dialog.blp:5
msgid "Connection Log"
msgstr "Tengiskrá"

#: crates/obscure-app/src/ui/log-dialog.blp:15
msgid "Copy log"
msgstr "Afrita skrá"

#: crates/obscure-app/src/ui/log-dialog.blp:22
msgid "Clear log"
msgstr "Hreinsa skrá"

#: crates/obscure-app/src/ui/server-dialog.blp:5
msgid "Server"
msgstr "Þjónn"

#: crates/obscure-app/src/ui/server-dialog.blp:44
msgid "Name"
msgstr "Heiti"

#: crates/obscure-app/src/ui/server-dialog.blp:50
msgid "Address"
msgstr "Vistfang"

#: crates/obscure-app/src/ui/server-dialog.blp:69
msgid "Copy Link"
msgstr "Afrita tengil"

#: crates/obscure-app/src/log_dialog.rs:85
msgid "Nothing logged yet. Connect to see what the engine reports."
msgstr "Ekkert skráð ennþá. Tengstu til að sjá hvað vélin tilkynnir."

#: crates/obscure-app/src/server_dialog.rs:61
msgid "Link copied."
msgstr "Tengill afritaður."
