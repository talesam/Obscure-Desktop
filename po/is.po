msgstr "Flytja inn þjóna úr skrá"

#: crates/obscure-app/src/window.rs:272
msgid "Could not read that file."
msgstr "Ekki tókst að lesa þá skrá."

#: crates/obscure-app/src/window.rs:360
msgid "Environment variables copied. Paste them in a terminal."
msgstr "Umhverfisbreytur afritaðar. Límdu þær í skjáhermi."

#: crates/obscure-app/src/window.rs:497
msgid "Update now"
msgstr "Uppfæra núna"

#: crates/obscure-app/src/window.rs:527
msgid "Remove subscription"
msgstr "Fjarlægja áskrift"

#: crates/obscure-app/src/window.rs:544
msgid "Remove “%s” and all its servers?"
msgstr "Fjarlægja „%s“ og alla þjóna hennar?"

#: crates/obscure-app/src/window.rs:546
msgid "You can add the subscription again later by pasting its address."
msgstr "Þú getur bætt áskriftinni við aftur síðar með því að líma vistfangið."

#: crates/obscure-app/src/window.rs:551 crates/obscure-app/src/window.rs:692 crates/obscure-app/src/ui/server-dialog.blp:82
msgid "Remove"
msgstr "Fjarlægja"

#: crates/obscure-app/src/window.rs:571 crates/obscure-app/src/tray.rs:81
msgid "Disconnect"
msgstr "Aftengjast"

#: crates/obscure-app/src/window.rs:670
msgid "Server details"
msgstr "Upplýsingar um þjón"

#: crates/obscure-app/src/window.rs:687
msgid "Remove “%s”?"
msgstr "Fjarlægja „%s“?"

#: crates/obscure-app/src/window.rs:688
msgid "You can add it again later by pasting its link."
msgstr "Þú getur bætt honum við aftur síðar með því að líma tengilinn."

#: crates/obscure-app/src/window.rs:712
msgid "These servers were already added."
msgstr "Þessum þjónum hafði þegar verið bætt við."

#: crates/obscure-app/src/window.rs:714
msgid "%n server added."
msgid_plural "%n servers added."
msgstr[0] "%n þjóni bætt við."
msgstr[1] "%n þjónum bætt við."

#: crates/obscure-app/src/window.rs:720
msgid "Downloading the subscription…"
msgstr "Sæki áskriftina…"

#: crates/obscure-app/src/window.rs:725
msgid "Subscription updated: %n server."
msgid_plural "Subscription updated: %n servers."
msgstr[0] "Áskrift uppfærð: %n þjónn."
msgstr[1] "Áskrift uppfærð: %n þjónar."

#: crates/obscure-app/src/connection.rs:206 crates/obscure-app/src/connection.rs:994
msgid "Disconnected"
msgstr "Ótengt"

#: crates/obscure-app/src/connection.rs:820
msgid "Finding the fastest server…"
msgstr "Leita að hraðasta þjóninum…"

#: crates/obscure-app/src/connection.rs:846
msgid "Choose a server to connect"
msgstr "Veldu þjón til að tengjast"

#: crates/obscure-app/src/connection.rs:874 crates/obscure-app/src/connection.rs:966
msgid "Connecting…"
msgstr "Tengist…"

#: crates/obscure-app/src/connection.rs:910
msgid "Disconnecting…"
msgstr "Aftengist…"

#: crates/obscure-app/src/connection.rs:933
msgid "Preparing the connection engine…"
msgstr "Undirbý tengivél…"

#: crates/obscure-app/src/connection.rs:944
msgid "Downloading the connection engine: %a of %b MB"
msgstr "Sæki tengivél: %a af %b MB"

#: crates/obscure-app/src/connection.rs:947
msgid "Downloading the connection engine: %a MB"
msgstr "Sæki tengivél: %a MB"

#: crates/obscure-app/src/connection.rs:952
msgid "Verifying the download…"
msgstr "Staðfesti niðurhal…"

#: crates/obscure-app/src/connection.rs:954
msgid "Installing the connection engine…"
msgstr "Set upp tengivél…"

#: crates/obscure-app/src/connection.rs:983
msgid "Connected · system proxy active"
msgstr "Tengt · kerfis-proxy virkur"

#: crates/obscure-app/src/connection.rs:984
msgid "Connected · local proxy only"
msgstr "Tengt · aðeins staðbundinn proxy"

#: crates/obscure-app/src/connection.rs:985
msgid "Connected · all traffic through the tunnel"
msgstr "Tengt · öll umferð um tunnelinn"

#: crates/obscure-app/src/connection.rs:989
msgid "Connected"
msgstr "Tengt"

#: crates/obscure-app/src/connection.rs:1006
msgid "Connection failed"
msgstr "Tenging mistókst"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "Þessi gerð tengils er ekki studd ennþá: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "Tengillinn virðist ófullkominn eða ógildur."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "Nettengingin tók of langan tíma."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "Náði ekki tengingu við internetið til að sækja tengivélina."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "Ekki tókst að sækja tengivélina. Reyndu aftur síðar."

#: crates/obscure-app/src/humanize.rs:20
msgid "The downloaded file is corrupted. It will be downloaded again on the next attempt."
msgstr "Sótta skráin er skemmd. Hún verður sótt aftur í næstu tilraun."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "Ekki tókst að afþjappa tengivélina."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "Tengivélin hefur ekki verið sótt ennþá."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "Athugaðu dreifilykil þjónsins."

#: crates/obscure-app/src/humanize.rs:28
msgid "The server identifier is not valid."
msgstr "Auðkenni þjónsins er ekki gilt."

#: crates/obscure-app/src/humanize.rs:30
msgid "Check the server details."
msgstr "Athugaðu upplýsingar þjónsins."

#: crates/obscure-app/src/humanize.rs:34
msgid "This server has a configuration the engine did not accept."
msgstr "Þessi þjónn hefur uppsetningu sem vélin samþykkti ekki."

#: crates/obscure-app/src/humanize.rs:41
msgid "The local port is already in use by another program. Change it in Preferences."
msgstr "Staðbundna gáttin er þegar í notkun af öðru forriti. Breyttu henni í Kjörstillingum."

#: crates/obscure-app/src/humanize.rs:44
msgid "The connection engine stopped unexpectedly."
msgstr "Tengivélin stöðvaðist óvænt."

#: crates/obscure-app/src/humanize.rs:47
