#: data/io.github.talesam.Obscure.metainfo.xml.in.in:7
#: crates/obscure-app/src/ui/window.blp:5
msgid "Obscure"
msgstr "Obscure"

#. Translators: the slogan of the app
#: data/io.github.talesam.Obscure.desktop.in.in:4
#: crates/obscure-app/src/ui/window.blp:38
#: crates/obscure-app/src/application.rs:331
msgid "Connect. That's it."
msgstr "Tengstu. Það er allt."

#: data/io.github.talesam.Obscure.desktop.in.in:5
msgid "Proxy Client"
msgstr "Proxy-biðlari"

#. Translators: search terms, keep the trailing semicolon
#: data/io.github.talesam.Obscure.desktop.in.in:13
msgid "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;"
msgstr "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:8
msgid "Connect to your proxy with one button"
msgstr "Tengstu við proxy-þjóninn þinn með einum hnappi"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:10
msgid "Obscure is a simple client for the Xray-core engine. Paste a link or a subscription, tap Connect and you are done."
msgstr "Obscure er einfaldur biðlari fyrir Xray-core vélina. Límdu tengil eða áskrift, ýttu á Tengjast og þá er þetta komið."

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:14
msgid "Features:"
msgstr "Eiginleikar:"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:16
msgid "One Connect button, no technical terms on the main screen"
msgstr "Einn Tengjast-hnappur, engin tækniorð á aðalskjánum"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:17
msgid "Imports vless, vmess, trojan and shadowsocks links, as well as subscriptions"
msgstr "Flytur inn vless-, vmess-, trojan- og shadowsocks-tengla ásamt áskriftum"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:18
msgid "Applies the system proxy on GNOME and KDE, no root required"
msgstr "Setur kerfis-proxy í GNOME og KDE án root-réttinda"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:19
msgid "Downloads and updates Xray-core automatically, with integrity checks"
msgstr "Sækir og uppfærir Xray-core sjálfkrafa með heilleikaprófun"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:49
msgid "Initial project skeleton."
msgstr "Fyrsta beinagrind verkefnisins."

#: data/io.github.talesam.Obscure.gschema.xml.in:6
msgid "Window width"
msgstr "Breidd glugga"

#: data/io.github.talesam.Obscure.gschema.xml.in:10
msgid "Window height"
msgstr "Hæð glugga"

#: data/io.github.talesam.Obscure.gschema.xml.in:14
msgid "Whether the window is maximized"
msgstr "Hvort gluggi sé hámarkaður"

#: data/io.github.talesam.Obscure.gschema.xml.in:18
msgid "Keep running in the tray when the window is closed"
msgstr "Halda áfram í kerfisbakka þegar glugganum er lokað"

#: crates/obscure-app/src/ui/window.blp:17
#: crates/obscure-app/src/ui/window.blp:51
#: crates/obscure-app/src/ui/import-dialog.blp:5
msgid "Add Server"
msgstr "Bæta við þjóni"

#: crates/obscure-app/src/ui/window.blp:24
msgid "Main Menu"
msgstr "Aðalvalmynd"

#: crates/obscure-app/src/ui/window.blp:39
msgid "Paste a link or a subscription to get started."
msgstr "Límdu tengil eða áskrift til að byrja."

#: crates/obscure-app/src/ui/window.blp:137
#: crates/obscure-app/src/window.rs:406 crates/obscure-app/src/tray.rs:83
msgid "Connect"
msgstr "Tengjast"

#: crates/obscure-app/src/ui/window.blp:149
msgid "How to apply"
msgstr "Hvernig skal beita"

#: crates/obscure-app/src/ui/window.blp:157
msgid "System proxy"
msgstr "Kerfis-proxy"

#: crates/obscure-app/src/ui/window.blp:158
msgid "Browsers and most apps use the connection. No administrator password needed."
msgstr "Vafrar og flest forrit nota tenginguna. Ekkert lykilorð stjórnanda þarf."

#: crates/obscure-app/src/ui/window.blp:163
msgid "Local proxy only"
msgstr "Aðeins staðbundinn proxy"

#: crates/obscure-app/src/ui/window.blp:164
msgid "Nothing changes on the system. Point the programs you want at 127.0.0.1:2080."
msgstr "Engu er breytt í kerfinu. Beindu þeim forritum sem þú vilt á 127.0.0.1:2080."

#: crates/obscure-app/src/ui/window.blp:169
msgid "Tunnel"
msgstr "Tunnel"

#: crates/obscure-app/src/ui/window.blp:171
msgid "All traffic from this computer. Coming in a future version."
msgstr "Öll umferð frá þessari tölvu. Kemur í framtíðarútgáfu."

#: crates/obscure-app/src/ui/window.blp:177
msgid "What goes through the connection"
msgstr "Hvað fer um tenginguna"

#: crates/obscure-app/src/ui/window.blp:185
msgid "Smart"
msgstr "Snjallt"

#: crates/obscure-app/src/ui/window.blp:186
msgid "Everything, except local network addresses. Ads are blocked."
msgstr "Allt nema vistföng á staðarneti. Auglýsingar eru lokaðar."

#: crates/obscure-app/src/ui/window.blp:191
msgid "Everything"
msgstr "Allt"

#: crates/obscure-app/src/ui/window.blp:192
msgid "All traffic goes through the connection, except local network addresses."
msgstr "Öll umferð fer um tenginguna, nema vistföng á staðarneti."

#: crates/obscure-app/src/ui/window.blp:198
msgid "Servers"
msgstr "Þjónar"

#: crates/obscure-app/src/ui/window.blp:221
msgid "_Import from File…"
msgstr "_Flytja inn úr skrá…"

#: crates/obscure-app/src/ui/window.blp:226
msgid "_Connection Log"
msgstr "_Tengiskrá"

#: crates/obscure-app/src/ui/window.blp:231
