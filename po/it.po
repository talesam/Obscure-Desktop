msgid "Keyboard Shortcuts"
msgstr "Scorciatoie da tastiera"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:19
msgid "Close Window"
msgstr "Chiudi finestra"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:24
msgid "Quit"
msgstr "Esci"

#: crates/obscure-app/src/ui/preferences-dialog.blp:14
msgid "Connection"
msgstr "Connessione"

#: crates/obscure-app/src/ui/preferences-dialog.blp:15
msgid "Connection options will be available in the next stage of the project."
msgstr "Le opzioni di connessione saranno disponibili nella prossima fase del progetto."

#: crates/obscure-app/src/ui/import-dialog.blp:17
#: crates/obscure-app/src/window.rs:302 crates/obscure-app/src/window.rs:372
msgid "Cancel"
msgstr "Annulla"

#: crates/obscure-app/src/ui/import-dialog.blp:23
msgid "Add"
msgstr "Aggiungi"

#: crates/obscure-app/src/ui/import-dialog.blp:42
msgid "Paste the server link below, or the links from your subscription, one per line."
msgstr "Incolla qui sotto il link del server, o i link del tuo abbonamento, uno per riga."

#: crates/obscure-app/src/ui/import-dialog.blp:75
msgid "Paste from Clipboard"
msgstr "Incolla dagli appunti"

#: crates/obscure-app/src/application.rs:57
msgid "The system proxy settings from a previous session were restored."
msgstr "Le impostazioni del proxy di sistema della sessione precedente sono state ripristinate."

#. Translators: replace with your name and, optionally, e-mail.
#: crates/obscure-app/src/application.rs:207
msgid "translator-credits"
msgstr ""

#: crates/obscure-app/src/application.rs:211
msgid "Obscure uses Xray-core, downloaded separately on first run."
msgstr "Obscure usa Xray-core, scaricato separatamente al primo avvio."

#: crates/obscure-app/src/application.rs:217
msgid "Project plan"
msgstr "Piano del progetto"

#: crates/obscure-app/src/window.rs:185
msgid "The clipboard does not contain a server link."
msgstr "Gli appunti non contengono un link di server."

#: crates/obscure-app/src/window.rs:216
msgid "Environment variables copied. Paste them in a terminal."
msgstr "Variabili d'ambiente copiate. Incollale in un terminale."

#: crates/obscure-app/src/window.rs:294
msgid "Disconnect"
msgstr "Disconnetti"

#: crates/obscure-app/src/window.rs:350
msgid "Remove server"
msgstr "Rimuovi server"

#: crates/obscure-app/src/window.rs:368
msgid "Remove “%s”?"
msgstr "Rimuovere «%s»?"

#: crates/obscure-app/src/window.rs:369
msgid "You can add it again later by pasting its link."
msgstr "Potrai aggiungerlo di nuovo più tardi incollando il suo link."

#: crates/obscure-app/src/window.rs:373
msgid "Remove"
msgstr "Rimuovi"

#: crates/obscure-app/src/window.rs:393
msgid "These servers were already added."
msgstr "Questi server erano già stati aggiunti."

#: crates/obscure-app/src/window.rs:395
msgid "%n server added."
msgid_plural "%n servers added."
msgstr[0] "%n server aggiunto."
msgstr[1] "%n server aggiunti."

#: crates/obscure-app/src/connection.rs:147
#: crates/obscure-app/src/connection.rs:441
msgid "Disconnected"
msgstr "Disconnesso"

#: crates/obscure-app/src/connection.rs:314
msgid "Choose a server to connect"
msgstr "Scegli un server per connetterti"

#: crates/obscure-app/src/connection.rs:329
#: crates/obscure-app/src/connection.rs:417
msgid "Connecting…"
msgstr "Connessione…"

#: crates/obscure-app/src/connection.rs:361
msgid "Disconnecting…"
msgstr "Disconnessione…"

#: crates/obscure-app/src/connection.rs:384
msgid "Preparing the connection engine…"
msgstr "Preparazione del motore di connessione…"

#: crates/obscure-app/src/connection.rs:395
msgid "Downloading the connection engine: %a of %b MB"
msgstr "Download del motore di connessione: %a di %b MB"

#: crates/obscure-app/src/connection.rs:398
msgid "Downloading the connection engine: %a MB"
msgstr "Download del motore di connessione: %a MB"

#: crates/obscure-app/src/connection.rs:403
msgid "Verifying the download…"
msgstr "Verifica del download…"

#: crates/obscure-app/src/connection.rs:405
msgid "Installing the connection engine…"
msgstr "Installazione del motore di connessione…"

#: crates/obscure-app/src/connection.rs:434
msgid "Connected · system proxy active"
msgstr "Connesso · proxy di sistema attivo"

#: crates/obscure-app/src/connection.rs:435
msgid "Connected · local proxy only"
msgstr "Connesso · solo proxy locale"

#: crates/obscure-app/src/connection.rs:436
msgid "Connected"
msgstr "Connesso"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "Questo tipo di link non è ancora supportato: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "Il link sembra incompleto o non valido."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "La connessione a Internet ha impiegato troppo tempo."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "Impossibile raggiungere Internet per scaricare il motore di connessione."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "Impossibile scaricare il motore di connessione. Riprova più tardi."

#: crates/obscure-app/src/humanize.rs:20
msgid "The downloaded file is corrupted. It will be downloaded again on the next attempt."
msgstr "Il file scaricato è danneggiato. Verrà scaricato di nuovo al prossimo tentativo."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "Impossibile estrarre il motore di connessione."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "Il motore di connessione non è ancora stato scaricato."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "Controlla la chiave pubblica del server."

#: crates/obscure-app/src/humanize.rs:28
msgid "The server identifier is not valid."
msgstr "L'identificatore del server non è valido."

#: crates/obscure-app/src/humanize.rs:30
msgid "Check the server details."
msgstr "Controlla i dati del server."

#: crates/obscure-app/src/humanize.rs:34
msgid "This server has a configuration the engine did not accept."
msgstr "Questo server ha una configurazione che il motore non ha accettato."

#: crates/obscure-app/src/humanize.rs:41
msgid "The local port is already in use by another program. Change it in Preferences."
msgstr "La porta locale è già usata da un altro programma. Cambiala nelle Preferenze."

#: crates/obscure-app/src/humanize.rs:44
msgid "The connection engine stopped unexpectedly."
msgstr "Il motore di connessione si è arrestato inaspettatamente."

#: crates/obscure-app/src/humanize.rs:47
msgid "The connection engine did not respond in time."
msgstr "Il motore di connessione non ha risposto in tempo."

#: crates/obscure-app/src/humanize.rs:49
msgid "Could not change the system proxy. The local connection is still available."
msgstr "Impossibile modificare il proxy di sistema. La connessione locale resta disponibile."

#: crates/obscure-app/src/humanize.rs:51
msgid "Could not notify the system about the new proxy."
msgstr "Impossibile avvisare il sistema del nuovo proxy."

#: crates/obscure-app/src/humanize.rs:52
msgid "Could not read or write Obscure's files."
msgstr "Impossibile leggere o scrivere i file di Obscure."

#: crates/obscure-app/src/humanize.rs:53
msgid "Could not read traffic statistics."
msgstr "Impossibile leggere le statistiche del traffico."

#: crates/obscure-app/src/humanize.rs:54
msgid "The server did not respond to the latency test."
msgstr "Il server non ha risposto al test di latenza."

#: crates/obscure-app/src/humanize.rs:55
msgid "The subscription could not be read. Check the address."
msgstr "Impossibile leggere l'abbonamento. Controlla l'indirizzo."

#: crates/obscure-app/src/humanize.rs:57
msgid "This subscription is in Clash format, which Obscure does not support yet."
msgstr "Questo abbonamento è in formato Clash, non ancora supportato da Obscure."

#: crates/obscure-app/src/import_dialog.rs:49
#: crates/obscure-app/src/import_dialog.rs:159
msgid "No valid link found."
msgstr "Nessun link valido trovato."

#: crates/obscure-app/src/import_dialog.rs:162
msgid "%n server ready to add."
msgid_plural "%n servers ready to add."
msgstr[0] "%n server pronto da aggiungere."
msgstr[1] "%n server pronti da aggiungere."

#: crates/obscure-app/src/import_dialog.rs:172
msgid "%n link could not be read."
msgid_plural "%n links could not be read."
msgstr[0] "%n link non è stato letto."
msgstr[1] "%n link non sono stati letti."
