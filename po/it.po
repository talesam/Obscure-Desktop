msgstr "Incolla link di server (uno per riga) o l'indirizzo del tuo abbonamento."

#: crates/obscure-app/src/ui/import-dialog.blp:79
msgid "Paste"
msgstr "Incolla"

#: crates/obscure-app/src/ui/import-dialog.blp:84
