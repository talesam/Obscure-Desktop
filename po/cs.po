msgstr "Chování"

#: crates/obscure-app/src/ui/preferences-dialog.blp:17
msgid "Keep running in the background"
msgstr "Nechat běžet na pozadí"

#: crates/obscure-app/src/ui/preferences-dialog.blp:18
msgid "Closing the window leaves Obscure in the tray, still connected."
msgstr "Zavření okna ponechá Obscure v oznamovací oblasti, stále připojený."

#: crates/obscure-app/src/ui/preferences-dialog.blp:22
msgid "Start with the session"
msgstr "Spouštět se sezením"

#: crates/obscure-app/src/ui/preferences-dialog.blp:23
