msgstr "Vložte odkazy na servery (jeden na řádek) nebo adresu předplatného."

#: crates/obscure-app/src/ui/import-dialog.blp:79
msgid "Paste"
msgstr "Vložit"

#: crates/obscure-app/src/ui/import-dialog.blp:84
