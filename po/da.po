msgstr "Indsæt serverlinket nedenfor, eller linkene fra dit abonnement, ét pr. linje."

#: crates/obscure-app/src/ui/import-dialog.blp:75
msgid "Paste from Clipboard"
msgstr "Indsæt fra udklipsholderen"

#: crates/obscure-app/src/application.rs:67
