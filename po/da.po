msgstr "Luk vindue"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:29 crates/obscure-app/src/tray.rs:101
msgid "Quit"
msgstr "Afslut"

#: crates/obscure-app/src/ui/preferences-dialog.blp:14
msgid "Behavior"
msgstr "Adfærd"

#: crates/obscure-app/src/ui/preferences-dialog.blp:17
msgid "Keep running in the background"
msgstr "Fortsæt med at køre i baggrunden"

#: crates/obscure-app/src/ui/preferences-dialog.blp:18
msgid "Closing the window leaves Obscure in the tray, still connected."
msgstr "Når vinduet lukkes, bliver Obscure i bakken og forbliver forbundet."

#: crates/obscure-app/src/ui/preferences-dialog.blp:22
msgid "Start with the session"
msgstr "Start med sessionen"

#: crates/obscure-app/src/ui/preferences-dialog.blp:23
msgid "Obscure opens in the tray when you log in."
msgstr "Obscure åbner i bakken, når du logger ind."

#: crates/obscure-app/src/ui/preferences-dialog.blp:27
msgid "Connect when Obscure starts"
msgstr "Forbind, når Obscure starter"

#: crates/obscure-app/src/ui/preferences-dialog.blp:32
msgid "Connection"
msgstr "Forbindelse"

#: crates/obscure-app/src/ui/preferences-dialog.blp:33
msgid "Changes apply the next time you connect. If you are connected now, Obscure reconnects."
msgstr "Ændringer gælder fra næste forbindelse. Er du forbundet nu, forbinder Obscure igen."

#: crates/obscure-app/src/ui/preferences-dialog.blp:36
msgid "Local port"
msgstr "Lokal port"

#: crates/obscure-app/src/ui/preferences-dialog.blp:37
msgid "Where programs on this computer reach the connection."
msgstr "Hvor programmer på denne computer finder forbindelsen."

#: crates/obscure-app/src/ui/preferences-dialog.blp:49
msgid "DNS server (DNS over HTTPS)"
msgstr "DNS-server (DNS over HTTPS)"

#: crates/obscure-app/src/ui/preferences-dialog.blp:54
msgid "Try pre-release versions of the engine"
msgstr "Prøv forhåndsversioner af motoren"

#: crates/obscure-app/src/ui/preferences-dialog.blp:55
msgid "Newer features, but less tested. Off is the safe choice."
msgstr "Nyere funktioner, men mindre testet. Fra er det sikre valg."

#: crates/obscure-app/src/ui/preferences-dialog.blp:61
msgid "Advanced"
msgstr "Avanceret"

#: crates/obscure-app/src/ui/preferences-dialog.blp:65
msgid "Shortcut"
msgstr "Genvej"

#: crates/obscure-app/src/ui/preferences-dialog.blp:68
msgid "System-wide shortcut to connect or disconnect"
msgstr "Systemgenvej til at forbinde eller afbryde"

#: crates/obscure-app/src/ui/preferences-dialog.blp:69
msgid "Works even when Obscure is hidden. The system lets you choose the keys."
msgstr "Virker også, når Obscure er skjult. Systemet lader dig vælge tasterne."

#: crates/obscure-app/src/ui/preferences-dialog.blp:74
msgid "Route rules"
msgstr "Ruteregler"

#: crates/obscure-app/src/ui/preferences-dialog.blp:75
msgid "Your rules win over the preset. Use a domain (example.com), an address (10.0.0.0/8) or a category (geosite:netflix)."
msgstr "Dine regler vinder over forudindstillingen. Brug et domæne (example.com), en adresse (10.0.0.0/8) eller en kategori (geosite:netflix)."

#: crates/obscure-app/src/ui/preferences-dialog.blp:80
msgid "Add rule"
msgstr "Tilføj regel"

#: crates/obscure-app/src/ui/preferences-dialog.blp:99
msgid "Engine configuration"
msgstr "Motorkonfiguration"

#: crates/obscure-app/src/ui/preferences-dialog.blp:102
msgid "Edit the engine configuration"
msgstr "Redigér motorkonfigurationen"

#: crates/obscure-app/src/ui/preferences-dialog.blp:103
msgid "See or replace the JSON that Obscure sends to Xray."
msgstr "Se eller erstat den JSON, Obscure sender til Xray."

#: crates/obscure-app/src/ui/import-dialog.blp:17 crates/obscure-app/src/window.rs:550 crates/obscure-app/src/window.rs:579 crates/obscure-app/src/window.rs:691 crates/obscure-app/src/preferences_dialog.rs:242
msgid "Cancel"
msgstr "Annullér"

#: crates/obscure-app/src/ui/import-dialog.blp:23 crates/obscure-app/src/preferences_dialog.rs:242
msgid "Add"
msgstr "Tilføj"

#: crates/obscure-app/src/ui/import-dialog.blp:42
msgid "Paste server links (one per line) or the address of your subscription."
msgstr "Indsæt serverlinks (ét pr. linje) eller adressen på dit abonnement."

#: crates/obscure-app/src/ui/import-dialog.blp:79
msgid "Paste"
msgstr "Indsæt"

#: crates/obscure-app/src/ui/import-dialog.blp:84
msgid "Read a QR code from an image file"
msgstr "Læs en QR-kode fra en billedfil"

#: crates/obscure-app/src/ui/import-dialog.blp:89
msgid "QR from Image"
msgstr "QR fra billede"

#: crates/obscure-app/src/ui/import-dialog.blp:94
msgid "Take a screenshot and read the QR code in it"
msgstr "Tag et skærmbillede, og læs QR-koden i det"

#: crates/obscure-app/src/ui/import-dialog.blp:99
msgid "QR from Screen"
msgstr "QR fra skærm"

#: crates/obscure-app/src/application.rs:98
msgid "The system proxy settings from a previous session were restored."
msgstr "Systemproxy-indstillingerne fra en tidligere session blev gendannet."

#. Translators: replace with your name and, optionally, e-mail.
#: crates/obscure-app/src/application.rs:432
msgid "translator-credits"
msgstr ""

#: crates/obscure-app/src/application.rs:436
msgid "Obscure uses Xray-core, downloaded separately on first run."
msgstr "Obscure bruger Xray-core, som downloades separat ved første start."

#: crates/obscure-app/src/application.rs:442
msgid "Project plan"
msgstr "Projektplan"

#: crates/obscure-app/src/window.rs:223
msgid "The clipboard does not contain a server link."
msgstr "Udklipsholderen indeholder ikke et serverlink."

#: crates/obscure-app/src/window.rs:245
msgid "Text files"
msgstr "Tekstfiler"

#: crates/obscure-app/src/window.rs:252
msgid "Import servers from a file"
msgstr "Importér servere fra en fil"

#: crates/obscure-app/src/window.rs:272
msgid "Could not read that file."
msgstr "Kunne ikke læse den fil."

#: crates/obscure-app/src/window.rs:360
msgid "Environment variables copied. Paste them in a terminal."
msgstr "Miljøvariabler kopieret. Indsæt dem i en terminal."

#: crates/obscure-app/src/window.rs:497
msgid "Update now"
msgstr "Opdatér nu"

#: crates/obscure-app/src/window.rs:527
msgid "Remove subscription"
msgstr "Fjern abonnement"

#: crates/obscure-app/src/window.rs:544
msgid "Remove “%s” and all its servers?"
msgstr "Fjern “%s” og alle dets servere?"

#: crates/obscure-app/src/window.rs:546
msgid "You can add the subscription again later by pasting its address."
msgstr "Du kan tilføje abonnementet igen senere ved at indsætte dets adresse."

#: crates/obscure-app/src/window.rs:551 crates/obscure-app/src/window.rs:692 crates/obscure-app/src/ui/server-dialog.blp:82
msgid "Remove"
msgstr "Fjern"

#: crates/obscure-app/src/window.rs:571 crates/obscure-app/src/tray.rs:81
msgid "Disconnect"
msgstr "Afbryd"

#: crates/obscure-app/src/window.rs:670
msgid "Server details"
msgstr "Serverdetaljer"

#: crates/obscure-app/src/window.rs:687
msgid "Remove “%s”?"
msgstr "Fjern “%s”?"

#: crates/obscure-app/src/window.rs:688
msgid "You can add it again later by pasting its link."
msgstr "Du kan tilføje den igen senere ved at indsætte dens link."

#: crates/obscure-app/src/window.rs:712
msgid "These servers were already added."
msgstr "Disse servere var allerede tilføjet."

#: crates/obscure-app/src/window.rs:714
msgid "%n server added."
msgid_plural "%n servers added."
msgstr[0] "%n server tilføjet."
msgstr[1] "%n servere tilføjet."

#: crates/obscure-app/src/window.rs:720
msgid "Downloading the subscription…"
msgstr "Downloader abonnementet…"

#: crates/obscure-app/src/window.rs:725
msgid "Subscription updated: %n server."
msgid_plural "Subscription updated: %n servers."
msgstr[0] "Abonnement opdateret: %n server."
msgstr[1] "Abonnement opdateret: %n servere."

#: crates/obscure-app/src/connection.rs:206 crates/obscure-app/src/connection.rs:994
msgid "Disconnected"
msgstr "Ikke forbundet"

#: crates/obscure-app/src/connection.rs:820
msgid "Finding the fastest server…"
msgstr "Finder den hurtigste server…"

#: crates/obscure-app/src/connection.rs:846
msgid "Choose a server to connect"
msgstr "Vælg en server at forbinde til"

#: crates/obscure-app/src/connection.rs:874 crates/obscure-app/src/connection.rs:966
msgid "Connecting…"
msgstr "Forbinder…"

#: crates/obscure-app/src/connection.rs:910
msgid "Disconnecting…"
msgstr "Afbryder…"

#: crates/obscure-app/src/connection.rs:933
msgid "Preparing the connection engine…"
msgstr "Forbereder forbindelsesmotoren…"

#: crates/obscure-app/src/connection.rs:944
msgid "Downloading the connection engine: %a of %b MB"
msgstr "Downloader forbindelsesmotoren: %a af %b MB"

#: crates/obscure-app/src/connection.rs:947
msgid "Downloading the connection engine: %a MB"
msgstr "Downloader forbindelsesmotoren: %a MB"

#: crates/obscure-app/src/connection.rs:952
msgid "Verifying the download…"
msgstr "Kontrollerer downloadet…"

#: crates/obscure-app/src/connection.rs:954
msgid "Installing the connection engine…"
msgstr "Installerer forbindelsesmotoren…"

#: crates/obscure-app/src/connection.rs:983
msgid "Connected · system proxy active"
msgstr "Forbundet · systemproxy aktiv"

#: crates/obscure-app/src/connection.rs:984
msgid "Connected · local proxy only"
msgstr "Forbundet · kun lokal proxy"

#: crates/obscure-app/src/connection.rs:985
msgid "Connected · all traffic through the tunnel"
msgstr "Forbundet · al trafik gennem tunnelen"

#: crates/obscure-app/src/connection.rs:989
msgid "Connected"
msgstr "Forbundet"

#: crates/obscure-app/src/connection.rs:1006
msgid "Connection failed"
msgstr "Forbindelsen mislykkedes"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "Denne type link understøttes endnu ikke: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "Linket ser ufuldstændigt eller ugyldigt ud."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "Internetforbindelsen tog for lang tid."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "Kunne ikke nå internettet for at downloade forbindelsesmotoren."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "Kunne ikke downloade forbindelsesmotoren. Prøv igen senere."

#: crates/obscure-app/src/humanize.rs:20
msgid "The downloaded file is corrupted. It will be downloaded again on the next attempt."
msgstr "Den downloadede fil er beskadiget. Den downloades igen ved næste forsøg."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "Kunne ikke udpakke forbindelsesmotoren."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "Forbindelsesmotoren er endnu ikke downloadet."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "Kontrollér serverens offentlige nøgle."

#: crates/obscure-app/src/humanize.rs:28
msgid "The server identifier is not valid."
msgstr "Serverens id er ikke gyldigt."

#: crates/obscure-app/src/humanize.rs:30
msgid "Check the server details."
msgstr "Kontrollér serveroplysningerne."

#: crates/obscure-app/src/humanize.rs:34
msgid "This server has a configuration the engine did not accept."
msgstr "Denne server har en konfiguration, som motoren ikke accepterede."

#: crates/obscure-app/src/humanize.rs:41
msgid "The local port is already in use by another program. Change it in Preferences."
msgstr "Den lokale port bruges allerede af et andet program. Skift den under Indstillinger."

#: crates/obscure-app/src/humanize.rs:44
msgid "The connection engine stopped unexpectedly."
msgstr "Forbindelsesmotoren stoppede uventet."

#: crates/obscure-app/src/humanize.rs:47
msgid "The connection engine did not respond in time."
msgstr "Forbindelsesmotoren svarede ikke i tide."

#: crates/obscure-app/src/humanize.rs:49
msgid "Could not change the system proxy. The local connection is still available."
msgstr "Kunne ikke ændre systemproxyen. Den lokale forbindelse er stadig tilgængelig."

#: crates/obscure-app/src/humanize.rs:51
msgid "Could not notify the system about the new proxy."
msgstr "Kunne ikke informere systemet om den nye proxy."

#: crates/obscure-app/src/humanize.rs:52
msgid "Could not read or write Obscure's files."
msgstr "Kunne ikke læse eller skrive Obscures filer."

#: crates/obscure-app/src/humanize.rs:53
msgid "Could not read traffic statistics."
msgstr "Kunne ikke læse trafikstatistik."

#: crates/obscure-app/src/humanize.rs:54
msgid "The server did not respond to the latency test."
msgstr "Serveren svarede ikke på latenstesten."

#: crates/obscure-app/src/humanize.rs:55
msgid "The subscription could not be read. Check the address."
msgstr "Abonnementet kunne ikke læses. Kontrollér adressen."

#: crates/obscure-app/src/humanize.rs:57
msgid "This subscription is in Clash format, which Obscure does not support yet."
msgstr "Dette abonnement er i Clash-format, som Obscure endnu ikke understøtter."

#: crates/obscure-app/src/humanize.rs:60
msgid "Tunnel mode is not possible here: the engine is stored on a filesystem that ignores permissions (nosuid)."
msgstr "Tunneltilstand er ikke mulig her: motoren ligger på et filsystem, der ignorerer rettigheder (nosuid)."

