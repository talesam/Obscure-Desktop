msgstr "Se descarcă abonamentul…"

#: crates/obscure-app/src/connection.rs:186
#: crates/obscure-app/src/connection.rs:828
msgid "Disconnected"
msgstr "Deconectat"

#: crates/obscure-app/src/connection.rs:667
msgid "Finding the fastest server…"
msgstr "Se caută cel mai rapid server…"

#: crates/obscure-app/src/connection.rs:693
