#: data/io.github.talesam.Obscure.desktop.in.in:2 data/io.github.talesam.Obscure.metainfo.xml.in.in:7 crates/obscure-app/src/ui/window.blp:5
msgid "Obscure"
msgstr "Obscure"

#. Translators: short description shown next to the app name in menus
#: data/io.github.talesam.Obscure.desktop.in.in:4
msgid "Proxy Client"
msgstr "Client proxy"

#. Translators: the slogan of the app
#: data/io.github.talesam.Obscure.desktop.in.in:6 crates/obscure-app/src/ui/window.blp:38 crates/obscure-app/src/application.rs:460
msgid "Connect. That's it."
msgstr "Conectează-te. Atât."

#. Translators: search terms, keep the trailing semicolon and add local words
#: data/io.github.talesam.Obscure.desktop.in.in:16
msgid "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;wireguard;privacy;censorship;"
msgstr "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;wireguard;confidențialitate;cenzură;conexiune;"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:8
msgid "Connect to your proxy with one button"
msgstr "Conectează-te la proxy-ul tău cu un buton"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:10
msgid "Obscure is a simple client for the Xray-core engine. Paste a link or a subscription, tap Connect and you are done."
msgstr "Obscure este un client simplu pentru motorul Xray-core. Lipește un link sau un abonament, apasă Conectare și gata."

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:14
msgid "Features:"
msgstr "Funcționalități:"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:16
msgid "One Connect button, no technical terms on the main screen"
msgstr "Un singur buton Conectare, fără termeni tehnici pe ecranul principal"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:17
msgid "Imports vless, vmess, trojan and shadowsocks links, as well as subscriptions"
msgstr "Importă linkuri vless, vmess, trojan și shadowsocks, precum și abonamente"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:18
msgid "Applies the system proxy on GNOME and KDE, no root required"
msgstr "Aplică proxy-ul de sistem în GNOME și KDE, fără root"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:19
msgid "Downloads and updates Xray-core automatically, with integrity checks"
msgstr "Descarcă și actualizează Xray-core automat, cu verificarea integrității"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:49
msgid "Initial project skeleton."
msgstr "Scheletul inițial al proiectului."

#: data/io.github.talesam.Obscure.gschema.xml.in:6
msgid "Window width"
msgstr "Lățimea ferestrei"

#: data/io.github.talesam.Obscure.gschema.xml.in:10
msgid "Window height"
msgstr "Înălțimea ferestrei"

#: data/io.github.talesam.Obscure.gschema.xml.in:14
msgid "Whether the window is maximized"
msgstr "Dacă fereastra este maximizată"

#: data/io.github.talesam.Obscure.gschema.xml.in:18
msgid "Keep running in the tray when the window is closed"
msgstr "Rămâne în bara de sistem la închiderea ferestrei"

#: data/io.github.talesam.Obscure.gschema.xml.in:22
msgid "Start with the session (via the Background portal)"
msgstr "Pornește cu sesiunea (prin portalul Background)"

#: data/io.github.talesam.Obscure.gschema.xml.in:26
msgid "Register a system-wide shortcut through the GlobalShortcuts portal"
msgstr "Înregistrează o scurtătură la nivel de sistem prin portalul GlobalShortcuts"

#: data/io.github.talesam.Obscure.gschema.xml.in:30
msgid "Connect automatically when the app starts"
msgstr "Conectează automat la pornirea aplicației"

#: crates/obscure-app/src/ui/window.blp:17 crates/obscure-app/src/ui/window.blp:51 crates/obscure-app/src/ui/import-dialog.blp:5
msgid "Add Server"
msgstr "Adaugă server"

#: crates/obscure-app/src/ui/window.blp:24
msgid "Main Menu"
msgstr "Meniu principal"

#: crates/obscure-app/src/ui/window.blp:39
msgid "Paste a link or a subscription to get started."
msgstr "Lipește un link sau un abonament pentru a începe."

#: crates/obscure-app/src/ui/window.blp:152 crates/obscure-app/src/window.rs:587 crates/obscure-app/src/tray.rs:83
msgid "Connect"
msgstr "Conectare"

#: crates/obscure-app/src/ui/window.blp:164
msgid "How to apply"
msgstr "Mod de aplicare"

#: crates/obscure-app/src/ui/window.blp:172
msgid "System proxy"
msgstr "Proxy de sistem"

#: crates/obscure-app/src/ui/window.blp:173
msgid "Browsers and most apps use the connection. No administrator password needed."
msgstr "Browserele și majoritatea aplicațiilor vor folosi conexiunea. Nu este nevoie de parola de administrator."

#: crates/obscure-app/src/ui/window.blp:178
msgid "Local proxy only"
msgstr "Doar proxy local"

#: crates/obscure-app/src/ui/window.blp:179
msgid "Nothing changes on the system. Point the programs you want at 127.0.0.1:2080."
msgstr "Nimic nu se schimbă în sistem. Configurează programele dorite către 127.0.0.1:2080."

#: crates/obscure-app/src/ui/window.blp:184
msgid "Tunnel"
msgstr "Tunel"

#: crates/obscure-app/src/ui/window.blp:185
msgid "All traffic from this computer, every app. Asks for your password once."
msgstr "Tot traficul acestui computer, fiecare aplicație. Cere parola o singură dată."

#: crates/obscure-app/src/ui/window.blp:191
msgid "What goes through the connection"
msgstr "Ce trece prin conexiune"

#: crates/obscure-app/src/ui/window.blp:199
msgid "Smart"
msgstr "Inteligent"

#: crates/obscure-app/src/ui/window.blp:200
msgid "Everything, except local network addresses. Ads are blocked."
msgstr "Tot, cu excepția adreselor din rețeaua locală. Reclamele sunt blocate."

#: crates/obscure-app/src/ui/window.blp:205
msgid "Everything"
msgstr "Tot"

#: crates/obscure-app/src/ui/window.blp:206
msgid "All traffic goes through the connection, except local network addresses."
msgstr "Tot traficul trece prin conexiune, cu excepția adreselor din rețeaua locală."

#: crates/obscure-app/src/ui/window.blp:212
msgid "Subscriptions"
msgstr "Abonamente"

#: crates/obscure-app/src/ui/window.blp:225
msgid "Servers"
msgstr "Servere"

#: crates/obscure-app/src/ui/window.blp:234
msgid "Automatic"
msgstr "Automat"

#: crates/obscure-app/src/ui/window.blp:235
msgid "Tests all servers when you connect and picks the quickest one."
msgstr "Testează toate serverele la conectare și alege cel mai rapid."

#: crates/obscure-app/src/ui/window.blp:245
msgid "Automatic: fastest server"
msgstr "Automat: cel mai rapid server"

#: crates/obscure-app/src/ui/window.blp:251
msgid "Measure the response time of every server"
msgstr "Măsoară timpul de răspuns al fiecărui server"

#: crates/obscure-app/src/ui/window.blp:256
msgid "Test All"
msgstr "Testează tot"

#: crates/obscure-app/src/ui/window.blp:286
msgid "_Import from File…"
msgstr "_Importă din fișier…"

#: crates/obscure-app/src/ui/window.blp:291
msgid "_Live Connections"
msgstr "Conexiuni în _direct"

#: crates/obscure-app/src/ui/window.blp:296
msgid "_Connection Log"
msgstr "_Jurnalul conexiunii"

#: crates/obscure-app/src/ui/window.blp:301
msgid "_Copy Environment Variables"
msgstr "_Copiază variabilele de mediu"

#: crates/obscure-app/src/ui/window.blp:308
msgid "_Preferences"
msgstr "_Preferințe"

#: crates/obscure-app/src/ui/window.blp:313
