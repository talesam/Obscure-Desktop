msgstr "Ligado · só proxy local"

#: crates/obscure-app/src/connection.rs:846
#: crates/obscure-app/src/connection.rs:850
msgid "Connected"
msgstr "Ligado"

#: crates/obscure-app/src/connection.rs:867
msgid "Connection failed"
msgstr "Falha na ligação"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "Este tipo de ligação ainda não é suportado: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "A ligação parece incompleta ou inválida."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "A ligação à Internet demorou demasiado."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "Não foi possível aceder à Internet para descarregar o motor de ligação."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "Não foi possível descarregar o motor de ligação. Tente novamente mais tarde."

#: crates/obscure-app/src/humanize.rs:20
msgid "The downloaded file is corrupted. It will be downloaded again on the next attempt."
msgstr "O ficheiro descarregado está corrompido. Será descarregado de novo na próxima tentativa."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "Não foi possível extrair o motor de ligação."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "O motor de ligação ainda não foi descarregado."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "Verifique a chave pública do servidor."

#: crates/obscure-app/src/humanize.rs:28
msgid "The server identifier is not valid."
msgstr "O identificador do servidor não é válido."

#: crates/obscure-app/src/humanize.rs:30
msgid "Check the server details."
msgstr "Verifique os dados do servidor."

#: crates/obscure-app/src/humanize.rs:34
msgid "This server has a configuration the engine did not accept."
msgstr "Este servidor tem uma configuração que o motor não aceitou."

#: crates/obscure-app/src/humanize.rs:41
msgid "The local port is already in use by another program. Change it in Preferences."
msgstr "A porta local já está a ser usada por outro programa. Altere-a nas Preferências."

#: crates/obscure-app/src/humanize.rs:44
msgid "The connection engine stopped unexpectedly."
msgstr "O motor de ligação terminou inesperadamente."

#: crates/obscure-app/src/humanize.rs:47
msgid "The connection engine did not respond in time."
msgstr "O motor de ligação não respondeu a tempo."

#: crates/obscure-app/src/humanize.rs:49
msgid "Could not change the system proxy. The local connection is still available."
msgstr "Não foi possível alterar o proxy do sistema. A ligação local continua disponível."

#: crates/obscure-app/src/humanize.rs:51
msgid "Could not notify the system about the new proxy."
msgstr "Não foi possível notificar o sistema sobre o novo proxy."

#: crates/obscure-app/src/humanize.rs:52
msgid "Could not read or write Obscure's files."
msgstr "Não foi possível ler ou escrever os ficheiros do Obscure."

#: crates/obscure-app/src/humanize.rs:53
msgid "Could not read traffic statistics."
msgstr "Não foi possível ler as estatísticas de tráfego."

#: crates/obscure-app/src/humanize.rs:54
msgid "The server did not respond to the latency test."
msgstr "O servidor não respondeu ao teste de latência."

#: crates/obscure-app/src/humanize.rs:55
msgid "The subscription could not be read. Check the address."
msgstr "Não foi possível ler a subscrição. Verifique o endereço."

#: crates/obscure-app/src/humanize.rs:57
msgid "This subscription is in Clash format, which Obscure does not support yet."
msgstr "Esta subscrição está no formato Clash, que o Obscure ainda não suporta."

#: crates/obscure-app/src/import_dialog.rs:60
