#: data/io.github.talesam.Obscure.desktop.in.in:2
#: data/io.github.talesam.Obscure.metainfo.xml.in.in:7
#: crates/obscure-app/src/ui/window.blp:5
msgid "Obscure"
msgstr "Obscure"

#. Translators: short description shown next to the app name in menus
#: data/io.github.talesam.Obscure.desktop.in.in:4
msgid "Proxy Client"
msgstr "Проксі-клієнт"

#. Translators: the slogan of the app
#: data/io.github.talesam.Obscure.desktop.in.in:6
#: crates/obscure-app/src/ui/window.blp:38
#: crates/obscure-app/src/application.rs:460
msgid "Connect. That's it."
msgstr "Підключайтеся. І все."

#. Translators: search terms, keep the trailing semicolon and add local words
#: data/io.github.talesam.Obscure.desktop.in.in:16
msgid "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;wireguard;privacy;censorship;"
msgstr ""
"proxy;vpn;xray;vless;vmess;trojan;shadowsocks;wireguard;приватність;цензура;підключення;обхід "
"блокувань;"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:8
msgid "Connect to your proxy with one button"
msgstr "Підключіться до свого проксі однією кнопкою"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:10
msgid ""
"Obscure is a simple client for the Xray-core engine. Paste a link or a "
"subscription, tap Connect and you are done."
msgstr ""
"Obscure — простий клієнт для рушія Xray-core. Вставте посилання або "
"підписку, натисніть «Підключитися» — і готово."

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:14
msgid "Features:"
msgstr "Можливості:"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:16
msgid "One Connect button, no technical terms on the main screen"
msgstr "Одна кнопка «Підключитися», без технічних термінів на головному екрані"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:17
msgid ""
"Imports vless, vmess, trojan and shadowsocks links, as well as subscriptions"
msgstr "Імпорт посилань vless, vmess, trojan і shadowsocks, а також підписок"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:18
msgid "Applies the system proxy on GNOME and KDE, no root required"
msgstr "Налаштування системного проксі в GNOME і KDE без прав root"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:19
msgid "Downloads and updates Xray-core automatically, with integrity checks"
msgstr "Автоматичне завантаження й оновлення Xray-core з перевіркою цілісності"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:49
msgid "Initial project skeleton."
msgstr "Початковий каркас проєкту."

#: data/io.github.talesam.Obscure.gschema.xml.in:6
msgid "Window width"
msgstr "Ширина вікна"

#: data/io.github.talesam.Obscure.gschema.xml.in:10
msgid "Window height"
msgstr "Висота вікна"

#: data/io.github.talesam.Obscure.gschema.xml.in:14
msgid "Whether the window is maximized"
msgstr "Чи розгорнуте вікно"

#: data/io.github.talesam.Obscure.gschema.xml.in:18
msgid "Keep running in the tray when the window is closed"
msgstr "Залишатися в треї після закриття вікна"

#: data/io.github.talesam.Obscure.gschema.xml.in:22
msgid "Start with the session (via the Background portal)"
msgstr "Запускати разом із сеансом (через портал Background)"

#: data/io.github.talesam.Obscure.gschema.xml.in:26
msgid "Register a system-wide shortcut through the GlobalShortcuts portal"
msgstr "Зареєструвати глобальну комбінацію клавіш через портал GlobalShortcuts"

#: data/io.github.talesam.Obscure.gschema.xml.in:30
msgid "Connect automatically when the app starts"
msgstr "Підключатися автоматично під час запуску програми"

#: crates/obscure-app/src/ui/window.blp:17
#: crates/obscure-app/src/ui/window.blp:51
#: crates/obscure-app/src/ui/import-dialog.blp:5
msgid "Add Server"
msgstr "Додати сервер"

#: crates/obscure-app/src/ui/window.blp:24
msgid "Main Menu"
msgstr "Головне меню"

#: crates/obscure-app/src/ui/window.blp:39
msgid "Paste a link or a subscription to get started."
msgstr "Вставте посилання або підписку, щоб почати."

#: crates/obscure-app/src/ui/window.blp:152
#: crates/obscure-app/src/window.rs:587 crates/obscure-app/src/tray.rs:83
msgid "Connect"
msgstr "Підключитися"

#: crates/obscure-app/src/ui/window.blp:164
msgid "How to apply"
msgstr "Спосіб застосування"

#: crates/obscure-app/src/ui/window.blp:172
msgid "System proxy"
msgstr "Системний проксі"

#: crates/obscure-app/src/ui/window.blp:173
msgid ""
"Browsers and most apps use the connection. No administrator password needed."
msgstr ""
"Браузери та більшість програм використовуватимуть підключення. Пароль "
"адміністратора не потрібен."

#: crates/obscure-app/src/ui/window.blp:178
msgid "Local proxy only"
msgstr "Лише локальний проксі"

#: crates/obscure-app/src/ui/window.blp:179
msgid ""
"Nothing changes on the system. Point the programs you want at 127.0.0.1:2080."
msgstr ""
"У системі нічого не змінюється. Вкажіть потрібним програмам адресу "
"127.0.0.1:2080."

#: crates/obscure-app/src/ui/window.blp:184
msgid "Tunnel"
msgstr "Тунель"

#: crates/obscure-app/src/ui/window.blp:185
msgid "All traffic from this computer, every app. Asks for your password once."
msgstr "Увесь трафік цього комп'ютера, усі програми. Один раз запитає пароль."

#: crates/obscure-app/src/ui/window.blp:191
msgid "What goes through the connection"
msgstr "Що йде через підключення"

#: crates/obscure-app/src/ui/window.blp:199
msgid "Smart"
msgstr "Розумний режим"

#: crates/obscure-app/src/ui/window.blp:200
msgid "Everything, except local network addresses. Ads are blocked."
msgstr "Усе, крім адрес локальної мережі. Реклама блокується."

#: crates/obscure-app/src/ui/window.blp:205
msgid "Everything"
msgstr "Усе"

#: crates/obscure-app/src/ui/window.blp:206
msgid ""
"All traffic goes through the connection, except local network addresses."
msgstr "Увесь трафік іде через підключення, крім адрес локальної мережі."

#: crates/obscure-app/src/ui/window.blp:212
msgid "Subscriptions"
msgstr "Підписки"

#: crates/obscure-app/src/ui/window.blp:225
msgid "Servers"
msgstr "Сервери"

#: crates/obscure-app/src/ui/window.blp:234
msgid "Automatic"
msgstr "Автоматично"

#: crates/obscure-app/src/ui/window.blp:235
msgid "Tests all servers when you connect and picks the quickest one."
msgstr "Під час підключення перевіряє всі сервери й обирає найшвидший."

#: crates/obscure-app/src/ui/window.blp:245
msgid "Automatic: fastest server"
msgstr "Автоматично: найшвидший сервер"

#: crates/obscure-app/src/ui/window.blp:251
msgid "Measure the response time of every server"
msgstr "Виміряти час відповіді всіх серверів"

#: crates/obscure-app/src/ui/window.blp:256
msgid "Test All"
msgstr "Перевірити всі"

#: crates/obscure-app/src/ui/window.blp:286
msgid "_Import from File…"
msgstr "_Імпортувати з файлу…"

#: crates/obscure-app/src/ui/window.blp:291
msgid "_Live Connections"
msgstr "_Підключення наживо"

#: crates/obscure-app/src/ui/window.blp:296
msgid "_Connection Log"
msgstr "_Журнал підключення"

#: crates/obscure-app/src/ui/window.blp:301
msgid "_Copy Environment Variables"
msgstr "_Копіювати змінні середовища"

#: crates/obscure-app/src/ui/window.blp:308
msgid "_Preferences"
msgstr "_Параметри"

#: crates/obscure-app/src/ui/window.blp:313
msgid "_Keyboard Shortcuts"
msgstr "_Клавіатурні скорочення"

#: crates/obscure-app/src/ui/window.blp:318
msgid "_About Obscure"
msgstr "_Про Obscure"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:6
#: crates/obscure-app/src/ui/preferences-dialog.blp:10
msgid "General"
msgstr "Загальні"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:9
#: crates/obscure-app/src/ui/preferences-dialog.blp:5
msgid "Preferences"
msgstr "Параметри"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:14
msgid "Keyboard Shortcuts"
msgstr "Клавіатурні скорочення"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:19
#: crates/obscure-app/src/ui/connections-dialog.blp:5
msgid "Live Connections"
msgstr "Підключення наживо"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:24
msgid "Close Window"
msgstr "Закрити вікно"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:29
#: crates/obscure-app/src/tray.rs:101
msgid "Quit"
msgstr "Вийти"

#: crates/obscure-app/src/ui/preferences-dialog.blp:14
msgid "Behavior"
msgstr "Поведінка"

#: crates/obscure-app/src/ui/preferences-dialog.blp:17
msgid "Keep running in the background"
msgstr "Продовжувати роботу у фоні"

#: crates/obscure-app/src/ui/preferences-dialog.blp:18
msgid "Closing the window leaves Obscure in the tray, still connected."
msgstr "Після закриття вікна Obscure залишається в треї, усе ще підключений."

#: crates/obscure-app/src/ui/preferences-dialog.blp:22
msgid "Start with the session"
msgstr "Запускати разом із сеансом"

#: crates/obscure-app/src/ui/preferences-dialog.blp:23
msgid "Obscure opens in the tray when you log in."
msgstr "Obscure відкривається в треї після входу в систему."

#: crates/obscure-app/src/ui/preferences-dialog.blp:27
msgid "Connect when Obscure starts"
msgstr "Підключатися під час запуску Obscure"

#: crates/obscure-app/src/ui/preferences-dialog.blp:32
msgid "Connection"
msgstr "Підключення"

#: crates/obscure-app/src/ui/preferences-dialog.blp:33
msgid ""
"Changes apply the next time you connect. If you are connected now, Obscure "
"reconnects."
msgstr ""
"Зміни набудуть чинності під час наступного підключення. Якщо ви підключені "
"зараз, Obscure перепідключиться."

#: crates/obscure-app/src/ui/preferences-dialog.blp:36
msgid "Local port"
msgstr "Локальний порт"

#: crates/obscure-app/src/ui/preferences-dialog.blp:37
msgid "Where programs on this computer reach the connection."
msgstr "Де програми на цьому комп'ютері знаходять підключення."

#: crates/obscure-app/src/ui/preferences-dialog.blp:49
msgid "DNS server (DNS over HTTPS)"
msgstr "DNS-сервер (DNS через HTTPS)"

#: crates/obscure-app/src/ui/preferences-dialog.blp:56
msgid "Advanced"
msgstr "Додатково"

#: crates/obscure-app/src/ui/preferences-dialog.blp:60
msgid "Shortcut"
msgstr "Комбінація клавіш"

#: crates/obscure-app/src/ui/preferences-dialog.blp:63
msgid "System-wide shortcut to connect or disconnect"
msgstr "Глобальна комбінація клавіш для підключення й відключення"

#: crates/obscure-app/src/ui/preferences-dialog.blp:64
msgid "Works even when Obscure is hidden. The system lets you choose the keys."
msgstr "Працює, навіть коли Obscure приховано. Клавіші обираються в системі."

#: crates/obscure-app/src/ui/preferences-dialog.blp:69
msgid "Route rules"
msgstr "Правила маршрутизації"

#: crates/obscure-app/src/ui/preferences-dialog.blp:70
msgid ""
"Your rules win over the preset. Use a domain (example.com), an address "
"(10.0.0.0/8) or a category (geosite:netflix)."
msgstr ""
"Ваші правила важливіші за пресет. Вкажіть домен (example.com), адресу "
"(10.0.0.0/8) або категорію (geosite:netflix)."

#: crates/obscure-app/src/ui/preferences-dialog.blp:75
msgid "Add rule"
msgstr "Додати правило"

#: crates/obscure-app/src/ui/preferences-dialog.blp:94
msgid "Engine configuration"
msgstr "Конфігурація рушія"

#: crates/obscure-app/src/ui/preferences-dialog.blp:97
msgid "Edit the engine configuration"
msgstr "Змінити конфігурацію рушія"

#: crates/obscure-app/src/ui/preferences-dialog.blp:98
msgid "See or replace the JSON that Obscure sends to Xray."
msgstr "Переглянути або замінити JSON, який Obscure передає Xray."

#: crates/obscure-app/src/ui/import-dialog.blp:17
#: crates/obscure-app/src/window.rs:550 crates/obscure-app/src/window.rs:579
#: crates/obscure-app/src/window.rs:691
#: crates/obscure-app/src/preferences_dialog.rs:234
msgid "Cancel"
msgstr "Скасувати"

#: crates/obscure-app/src/ui/import-dialog.blp:23
#: crates/obscure-app/src/preferences_dialog.rs:234
msgid "Add"
msgstr "Додати"

#: crates/obscure-app/src/ui/import-dialog.blp:42
msgid "Paste server links (one per line) or the address of your subscription."
msgstr "Вставте посилання на сервери (по одному в рядку) або адресу підписки."

#: crates/obscure-app/src/ui/import-dialog.blp:79
msgid "Paste"
msgstr "Вставити"

#: crates/obscure-app/src/ui/import-dialog.blp:84
msgid "Read a QR code from an image file"
msgstr "Прочитати QR-код із файлу зображення"

#: crates/obscure-app/src/ui/import-dialog.blp:89
msgid "QR from Image"
msgstr "QR із зображення"

#: crates/obscure-app/src/ui/import-dialog.blp:94
msgid "Take a screenshot and read the QR code in it"
msgstr "Зробити знімок екрана й прочитати QR-код на ньому"

#: crates/obscure-app/src/ui/import-dialog.blp:99
msgid "QR from Screen"
msgstr "QR з екрана"

#: crates/obscure-app/src/application.rs:111
msgid "The system proxy settings from a previous session were restored."
msgstr "Налаштування системного проксі з попереднього сеансу відновлено."

#. Translators: replace with your name and, optionally, e-mail.
#: crates/obscure-app/src/application.rs:457
msgid "translator-credits"
msgstr ""

#: crates/obscure-app/src/application.rs:461
msgid "Obscure uses Xray-core, downloaded separately on first run."
msgstr ""
"Obscure використовує Xray-core, який завантажується окремо під час першого "
"запуску."

#: crates/obscure-app/src/application.rs:467
msgid "Project plan"
msgstr "План проєкту"

#: crates/obscure-app/src/window.rs:223
msgid "The clipboard does not contain a server link."
msgstr "У буфері обміну немає посилання на сервер."

#: crates/obscure-app/src/window.rs:245
msgid "Text files"
msgstr "Текстові файли"

#: crates/obscure-app/src/window.rs:252
msgid "Import servers from a file"
msgstr "Імпортувати сервери з файлу"

#: crates/obscure-app/src/window.rs:272
msgid "Could not read that file."
msgstr "Не вдалося прочитати цей файл."

#: crates/obscure-app/src/window.rs:360
msgid "Environment variables copied. Paste them in a terminal."
msgstr "Змінні середовища скопійовано. Вставте їх у термінал."

#: crates/obscure-app/src/window.rs:497
msgid "Update now"
msgstr "Оновити зараз"

#: crates/obscure-app/src/window.rs:527
msgid "Remove subscription"
msgstr "Видалити підписку"

#: crates/obscure-app/src/window.rs:544
msgid "Remove “%s” and all its servers?"
msgstr "Видалити «%s» і всі її сервери?"

#: crates/obscure-app/src/window.rs:546
msgid "You can add the subscription again later by pasting its address."
msgstr "Пізніше підписку можна додати знову, вставивши її адресу."

#: crates/obscure-app/src/window.rs:551 crates/obscure-app/src/window.rs:692
#: crates/obscure-app/src/ui/server-dialog.blp:82
msgid "Remove"
msgstr "Видалити"

#: crates/obscure-app/src/window.rs:571 crates/obscure-app/src/tray.rs:81
msgid "Disconnect"
msgstr "Відключитися"

#: crates/obscure-app/src/window.rs:670
msgid "Server details"
msgstr "Відомості про сервер"

#: crates/obscure-app/src/window.rs:687
msgid "Remove “%s”?"
msgstr "Видалити «%s»?"

#: crates/obscure-app/src/window.rs:688
msgid "You can add it again later by pasting its link."
msgstr "Пізніше його можна додати знову, вставивши посилання."

#: crates/obscure-app/src/window.rs:712
msgid "These servers were already added."
msgstr "Ці сервери вже були додані."

#: crates/obscure-app/src/window.rs:714
msgid "%n server added."
msgid_plural "%n servers added."
msgstr[0] "Додано %n сервер."
msgstr[1] "Додано %n сервери."
msgstr[2] "Додано %n серверів."

#: crates/obscure-app/src/window.rs:720
msgid "Downloading the subscription…"
msgstr "Завантаження підписки…"

#: crates/obscure-app/src/window.rs:725
msgid "Subscription updated: %n server."
msgid_plural "Subscription updated: %n servers."
msgstr[0] "Підписку оновлено: %n сервер."
msgstr[1] "Підписку оновлено: %n сервери."
msgstr[2] "Підписку оновлено: %n серверів."

#: crates/obscure-app/src/connection.rs:212
#: crates/obscure-app/src/connection.rs:833
#: crates/obscure-app/src/connection.rs:1007
msgid "Disconnected"
msgstr "Відключено"

#: crates/obscure-app/src/connection.rs:826
msgid "Finding the fastest server…"
msgstr "Пошук найшвидшого сервера…"

#: crates/obscure-app/src/connection.rs:856
msgid "Choose a server to connect"
msgstr "Виберіть сервер для підключення"

#: crates/obscure-app/src/connection.rs:874
#: crates/obscure-app/src/connection.rs:979
msgid "Connecting…"
msgstr "Підключення…"

#: crates/obscure-app/src/connection.rs:923
msgid "Disconnecting…"
msgstr "Відключення…"

#: crates/obscure-app/src/connection.rs:946
msgid "Preparing the connection engine…"
msgstr "Підготовка рушія підключення…"

#: crates/obscure-app/src/connection.rs:957
msgid "Downloading the connection engine: %a of %b MB"
msgstr "Завантаження рушія підключення: %a з %b МБ"

#: crates/obscure-app/src/connection.rs:960
msgid "Downloading the connection engine: %a MB"
msgstr "Завантаження рушія підключення: %a МБ"

#: crates/obscure-app/src/connection.rs:965
msgid "Verifying the download…"
msgstr "Перевірка завантаження…"

#: crates/obscure-app/src/connection.rs:967
msgid "Installing the connection engine…"
msgstr "Встановлення рушія підключення…"

#: crates/obscure-app/src/connection.rs:996
msgid "Connected · system proxy active"
msgstr "Підключено · системний проксі активний"

#: crates/obscure-app/src/connection.rs:997
msgid "Connected · local proxy only"
msgstr "Підключено · лише локальний проксі"

#: crates/obscure-app/src/connection.rs:998
msgid "Connected · all traffic through the tunnel"
msgstr "Підключено · увесь трафік через тунель"

#: crates/obscure-app/src/connection.rs:1002
msgid "Connected"
msgstr "Підключено"

#: crates/obscure-app/src/connection.rs:1019
msgid "Connection failed"
msgstr "Не вдалося підключитися"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "Такий тип посилання ще не підтримується: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "Посилання виглядає неповним або недійсним."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "Підключення до інтернету тривало надто довго."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "Не вдалося вийти в інтернет, щоб завантажити рушій підключення."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "Не вдалося завантажити рушій підключення. Повторіть спробу пізніше."

#: crates/obscure-app/src/humanize.rs:20
msgid ""
"The downloaded file is corrupted. It will be downloaded again on the next "
"attempt."
msgstr ""
"Завантажений файл пошкоджено. Його буде завантажено знову під час наступної "
"спроби."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "Не вдалося розпакувати рушій підключення."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "Рушій підключення ще не завантажено."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "Перевірте відкритий ключ сервера."

#: crates/obscure-app/src/humanize.rs:28
msgid "The server identifier is not valid."
msgstr "Ідентифікатор сервера недійсний."

#: crates/obscure-app/src/humanize.rs:30
msgid "Check the server details."
msgstr "Перевірте дані сервера."

#: crates/obscure-app/src/humanize.rs:34
msgid "This server has a configuration the engine did not accept."
msgstr "У цього сервера конфігурація, яку рушій не прийняв."

#: crates/obscure-app/src/humanize.rs:41
msgid ""
"The local port is already in use by another program. Change it in "
"Preferences."
msgstr ""
"Локальний порт уже зайнятий іншою програмою. Змініть його в Параметрах."

#: crates/obscure-app/src/humanize.rs:44
msgid "The connection engine stopped unexpectedly."
msgstr "Рушій підключення несподівано завершив роботу."

#: crates/obscure-app/src/humanize.rs:47
msgid "The connection engine did not respond in time."
msgstr "Рушій підключення не відповів вчасно."

#: crates/obscure-app/src/humanize.rs:49
msgid ""
"Could not change the system proxy. The local connection is still available."
msgstr ""
"Не вдалося змінити системний проксі. Локальне підключення й далі доступне."

#: crates/obscure-app/src/humanize.rs:51
msgid "Could not notify the system about the new proxy."
msgstr "Не вдалося повідомити систему про новий проксі."

#: crates/obscure-app/src/humanize.rs:52
msgid "Could not read or write Obscure's files."
msgstr "Не вдалося прочитати або записати файли Obscure."

#: crates/obscure-app/src/humanize.rs:53
msgid "Could not read traffic statistics."
msgstr "Не вдалося прочитати статистику трафіку."

#: crates/obscure-app/src/humanize.rs:54
msgid "The server did not respond to the latency test."
msgstr "Сервер не відповів на перевірку затримки."

#: crates/obscure-app/src/humanize.rs:55
msgid "The subscription could not be read. Check the address."
msgstr "Не вдалося прочитати підписку. Перевірте адресу."

#: crates/obscure-app/src/humanize.rs:57
msgid ""
"This subscription is in Clash format, which Obscure does not support yet."
msgstr "Ця підписка у форматі Clash, який Obscure ще не підтримує."

#: crates/obscure-app/src/humanize.rs:60
msgid ""
"Tunnel mode is not possible here: the engine is stored on a filesystem that "
"ignores permissions (nosuid)."
msgstr ""
"Режим тунелю тут неможливий: рушій розміщено на файловій системі, що ігнорує "
"права (nosuid)."

#: crates/obscure-app/src/humanize.rs:62
msgid "Could not get permission for tunnel mode."
msgstr "Не вдалося отримати дозвіл для режиму тунелю."

#: crates/obscure-app/src/humanize.rs:63
msgid "Tunnel mode needs your permission to route all traffic."
msgstr "Режиму тунелю потрібен ваш дозвіл, щоб спрямовувати увесь трафік."

#: crates/obscure-app/src/humanize.rs:64
msgid "The custom configuration is not valid JSON."
msgstr "Власна конфігурація — не коректний JSON."

#: crates/obscure-app/src/import_dialog.rs:60
