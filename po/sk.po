msgstr ""

#: crates/obscure-app/src/application.rs:461
msgid "Obscure uses Xray-core, downloaded separately on first run."
msgstr "Obscure používa Xray-core, ktorý sa stiahne zvlášť pri prvom spustení."

#: crates/obscure-app/src/application.rs:467
msgid "Project plan"
msgstr "Plán projektu"

#: crates/obscure-app/src/window.rs:223
msgid "The clipboard does not contain a server link."
msgstr "Schránka neobsahuje odkaz na server."

#: crates/obscure-app/src/window.rs:245
msgid "Text files"
msgstr "Textové súbory"

#: crates/obscure-app/src/window.rs:252
msgid "Import servers from a file"
msgstr "Importovať servery zo súboru"

#: crates/obscure-app/src/window.rs:272
msgid "Could not read that file."
msgstr "Tento súbor sa nedá prečítať."

#: crates/obscure-app/src/window.rs:360
msgid "Environment variables copied. Paste them in a terminal."
msgstr "Premenné prostredia skopírované. Vložte ich do terminálu."

#: crates/obscure-app/src/window.rs:497
msgid "Update now"
msgstr "Aktualizovať teraz"

#: crates/obscure-app/src/window.rs:527
msgid "Remove subscription"
msgstr "Odstrániť predplatné"

#: crates/obscure-app/src/window.rs:544
msgid "Remove “%s” and all its servers?"
msgstr "Odstrániť „%s“ a všetky jeho servery?"

#: crates/obscure-app/src/window.rs:546
msgid "You can add the subscription again later by pasting its address."
msgstr "Predplatné môžete neskôr znova pridať vložením jeho adresy."

#: crates/obscure-app/src/window.rs:551 crates/obscure-app/src/window.rs:692 crates/obscure-app/src/ui/server-dialog.blp:82
msgid "Remove"
msgstr "Odstrániť"

#: crates/obscure-app/src/window.rs:571 crates/obscure-app/src/tray.rs:81
msgid "Disconnect"
msgstr "Odpojiť"

#: crates/obscure-app/src/window.rs:670
msgid "Server details"
msgstr "Podrobnosti servera"

#: crates/obscure-app/src/window.rs:687
msgid "Remove “%s”?"
msgstr "Odstrániť „%s“?"

#: crates/obscure-app/src/window.rs:688
msgid "You can add it again later by pasting its link."
msgstr "Neskôr ho môžete znova pridať vložením odkazu."

#: crates/obscure-app/src/window.rs:712
msgid "These servers were already added."
msgstr "Tieto servery už boli pridané."

#: crates/obscure-app/src/window.rs:714
msgid "%n server added."
msgid_plural "%n servers added."
msgstr[0] "Pridaný %n server."
msgstr[1] "Pridané %n servery."
msgstr[2] "Pridaných %n serverov."

#: crates/obscure-app/src/window.rs:720
msgid "Downloading the subscription…"
msgstr "Sťahuje sa predplatné…"

#: crates/obscure-app/src/window.rs:725
msgid "Subscription updated: %n server."
msgid_plural "Subscription updated: %n servers."
msgstr[0] "Predplatné aktualizované: %n server."
msgstr[1] "Predplatné aktualizované: %n servery."
msgstr[2] "Predplatné aktualizované: %n serverov."

#: crates/obscure-app/src/connection.rs:212 crates/obscure-app/src/connection.rs:833 crates/obscure-app/src/connection.rs:1007
msgid "Disconnected"
msgstr "Odpojené"

#: crates/obscure-app/src/connection.rs:826
msgid "Finding the fastest server…"
msgstr "Hľadá sa najrýchlejší server…"

#: crates/obscure-app/src/connection.rs:856
msgid "Choose a server to connect"
msgstr "Vyberte server na pripojenie"

#: crates/obscure-app/src/connection.rs:874 crates/obscure-app/src/connection.rs:979
msgid "Connecting…"
msgstr "Pripája sa…"

#: crates/obscure-app/src/connection.rs:923
msgid "Disconnecting…"
msgstr "Odpája sa…"

#: crates/obscure-app/src/connection.rs:946
msgid "Preparing the connection engine…"
msgstr "Pripravuje sa jadro pripojenia…"

#: crates/obscure-app/src/connection.rs:957
msgid "Downloading the connection engine: %a of %b MB"
msgstr "Sťahuje sa jadro pripojenia: %a z %b MB"

#: crates/obscure-app/src/connection.rs:960
msgid "Downloading the connection engine: %a MB"
msgstr "Sťahuje sa jadro pripojenia: %a MB"

#: crates/obscure-app/src/connection.rs:965
msgid "Verifying the download…"
msgstr "Overuje sa stiahnutý súbor…"

#: crates/obscure-app/src/connection.rs:967
msgid "Installing the connection engine…"
msgstr "Inštaluje sa jadro pripojenia…"

#: crates/obscure-app/src/connection.rs:996
msgid "Connected · system proxy active"
msgstr "Pripojené · systémová proxy aktívna"

#: crates/obscure-app/src/connection.rs:997
msgid "Connected · local proxy only"
msgstr "Pripojené · iba miestna proxy"

#: crates/obscure-app/src/connection.rs:998
msgid "Connected · all traffic through the tunnel"
msgstr "Pripojené · všetka prevádzka tunelom"

#: crates/obscure-app/src/connection.rs:1002
msgid "Connected"
msgstr "Pripojené"

#: crates/obscure-app/src/connection.rs:1019
msgid "Connection failed"
msgstr "Pripojenie zlyhalo"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "Tento typ odkazu ešte nie je podporovaný: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "Odkaz vyzerá neúplne alebo neplatne."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "Pripojenie k internetu trvalo príliš dlho."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "Nepodarilo sa pripojiť k internetu a stiahnuť jadro pripojenia."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "Jadro pripojenia sa nepodarilo stiahnuť. Skúste to neskôr."

#: crates/obscure-app/src/humanize.rs:20
msgid "The downloaded file is corrupted. It will be downloaded again on the next attempt."
msgstr "Stiahnutý súbor je poškodený. Pri ďalšom pokuse sa stiahne znova."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "Jadro pripojenia sa nepodarilo rozbaliť."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "Jadro pripojenia ešte nebolo stiahnuté."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "Skontrolujte verejný kľúč servera."

#: crates/obscure-app/src/humanize.rs:28
msgid "The server identifier is not valid."
msgstr "Identifikátor servera nie je platný."

#: crates/obscure-app/src/humanize.rs:30
msgid "Check the server details."
msgstr "Skontrolujte údaje servera."

#: crates/obscure-app/src/humanize.rs:34
msgid "This server has a configuration the engine did not accept."
msgstr "Tento server má konfiguráciu, ktorú jadro neprijalo."

#: crates/obscure-app/src/humanize.rs:41
msgid "The local port is already in use by another program. Change it in Preferences."
msgstr "Miestny port už používa iný program. Zmeňte ho v Predvoľbách."

#: crates/obscure-app/src/humanize.rs:44
msgid "The connection engine stopped unexpectedly."
msgstr "Jadro pripojenia sa neočakávane ukončilo."

#: crates/obscure-app/src/humanize.rs:48
msgid "The tunnel came up but no traffic passes through it. Check the connection log."
msgstr "Tunel beží, ale neprechádza ním žiadna prevádzka. Skontrolujte protokol pripojenia."

#: crates/obscure-app/src/humanize.rs:50
msgid "The connection engine did not respond in time."
msgstr "Jadro pripojenia neodpovedalo včas."

#: crates/obscure-app/src/humanize.rs:52
msgid "Could not change the system proxy. The local connection is still available."
msgstr "Systémovú proxy nemožno zmeniť. Miestne pripojenie je stále dostupné."

#: crates/obscure-app/src/humanize.rs:54
msgid "Could not notify the system about the new proxy."
msgstr "Systém nemožno informovať o novej proxy."

#: crates/obscure-app/src/humanize.rs:55
msgid "Could not read or write Obscure's files."
msgstr "Súbory Obscure nemožno čítať ani zapisovať."

#: crates/obscure-app/src/humanize.rs:56
msgid "Could not read traffic statistics."
msgstr "Štatistiku prevádzky nemožno načítať."

