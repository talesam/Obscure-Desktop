msgstr[0] "Abonnement bijgewerkt: %n server."
msgstr[1] "Abonnement bijgewerkt: %n servers."

#: crates/obscure-app/src/connection.rs:212 crates/obscure-app/src/connection.rs:833 crates/obscure-app/src/connection.rs:1007
msgid "Disconnected"
msgstr "Niet verbonden"

#: crates/obscure-app/src/connection.rs:826
msgid "Finding the fastest server…"
msgstr "Snelste server zoeken…"

#: crates/obscure-app/src/connection.rs:856
msgid "Choose a server to connect"
msgstr "Kies een server om te verbinden"

#: crates/obscure-app/src/connection.rs:874 crates/obscure-app/src/connection.rs:979
msgid "Connecting…"
msgstr "Verbinden…"

#: crates/obscure-app/src/connection.rs:923
msgid "Disconnecting…"
msgstr "Verbinding verbreken…"

#: crates/obscure-app/src/connection.rs:946
msgid "Preparing the connection engine…"
msgstr "Verbindingsengine voorbereiden…"

#: crates/obscure-app/src/connection.rs:957
msgid "Downloading the connection engine: %a of %b MB"
msgstr "Verbindingsengine downloaden: %a van %b MB"

#: crates/obscure-app/src/connection.rs:960
msgid "Downloading the connection engine: %a MB"
msgstr "Verbindingsengine downloaden: %a MB"

#: crates/obscure-app/src/connection.rs:965
msgid "Verifying the download…"
msgstr "Download controleren…"

#: crates/obscure-app/src/connection.rs:967
msgid "Installing the connection engine…"
msgstr "Verbindingsengine installeren…"

#: crates/obscure-app/src/connection.rs:996
msgid "Connected · system proxy active"
msgstr "Verbonden · systeemproxy actief"

#: crates/obscure-app/src/connection.rs:997
msgid "Connected · local proxy only"
msgstr "Verbonden · alleen lokale proxy"

#: crates/obscure-app/src/connection.rs:998
msgid "Connected · all traffic through the tunnel"
msgstr "Verbonden · al het verkeer door de tunnel"

#: crates/obscure-app/src/connection.rs:1002
msgid "Connected"
msgstr "Verbonden"

#: crates/obscure-app/src/connection.rs:1019
msgid "Connection failed"
msgstr "Verbinding mislukt"

#: crates/obscure-app/src/humanize.rs:9
msgid "This kind of link is not supported yet: %s"
msgstr "Dit soort link wordt nog niet ondersteund: %s"

#: crates/obscure-app/src/humanize.rs:11
msgid "The link looks incomplete or invalid."
msgstr "De link lijkt onvolledig of ongeldig."

#: crates/obscure-app/src/humanize.rs:12
msgid "The internet connection took too long."
msgstr "De internetverbinding duurde te lang."

#: crates/obscure-app/src/humanize.rs:14
msgid "Could not reach the internet to download the connection engine."
msgstr "Kon geen internetverbinding maken om de verbindingsengine te downloaden."

#: crates/obscure-app/src/humanize.rs:17
msgid "Could not download the connection engine. Try again later."
msgstr "Kon de verbindingsengine niet downloaden. Probeer het later opnieuw."

#: crates/obscure-app/src/humanize.rs:20
msgid "The downloaded file is corrupted. It will be downloaded again on the next attempt."
msgstr "Het gedownloade bestand is beschadigd. Het wordt bij de volgende poging opnieuw gedownload."

#: crates/obscure-app/src/humanize.rs:22
msgid "Could not extract the connection engine."
msgstr "Kon de verbindingsengine niet uitpakken."

#: crates/obscure-app/src/humanize.rs:23
msgid "The connection engine has not been downloaded yet."
msgstr "De verbindingsengine is nog niet gedownload."

#: crates/obscure-app/src/humanize.rs:26
msgid "Check the server's public key."
msgstr "Controleer de publieke sleutel van de server."

#: crates/obscure-app/src/humanize.rs:28
msgid "The server identifier is not valid."
msgstr "De server-identificatie is ongeldig."

#: crates/obscure-app/src/humanize.rs:30
msgid "Check the server details."
msgstr "Controleer de servergegevens."

#: crates/obscure-app/src/humanize.rs:34
msgid "This server has a configuration the engine did not accept."
msgstr "Deze server heeft een configuratie die de engine niet accepteerde."

#: crates/obscure-app/src/humanize.rs:41
msgid "The local port is already in use by another program. Change it in Preferences."
msgstr "De lokale poort is al in gebruik door een ander programma. Wijzig hem in Voorkeuren."

#: crates/obscure-app/src/humanize.rs:44
msgid "The connection engine stopped unexpectedly."
msgstr "De verbindingsengine is onverwacht gestopt."

#: crates/obscure-app/src/humanize.rs:48
msgid "The tunnel came up but no traffic passes through it. Check the connection log."
msgstr "De tunnel is actief, maar er gaat geen verkeer doorheen. Bekijk het verbindingslogboek."

#: crates/obscure-app/src/humanize.rs:50
msgid "The connection engine did not respond in time."
msgstr "De verbindingsengine reageerde niet op tijd."

#: crates/obscure-app/src/humanize.rs:52
msgid "Could not change the system proxy. The local connection is still available."
msgstr "Kon de systeemproxy niet wijzigen. De lokale verbinding blijft beschikbaar."

#: crates/obscure-app/src/humanize.rs:54
msgid "Could not notify the system about the new proxy."
msgstr "Kon het systeem niet informeren over de nieuwe proxy."

#: crates/obscure-app/src/humanize.rs:55
msgid "Could not read or write Obscure's files."
msgstr "Kon de bestanden van Obscure niet lezen of schrijven."

#: crates/obscure-app/src/humanize.rs:56
msgid "Could not read traffic statistics."
msgstr "Kon de verkeersstatistieken niet lezen."

#: crates/obscure-app/src/humanize.rs:57
msgid "The server did not respond to the latency test."
msgstr "De server reageerde niet op de latentietest."

#: crates/obscure-app/src/humanize.rs:58
msgid "The subscription could not be read. Check the address."
msgstr "Het abonnement kon niet worden gelezen. Controleer het adres."

#: crates/obscure-app/src/humanize.rs:60
msgid "This subscription is in Clash format, which Obscure does not support yet."
msgstr "Dit abonnement is in Clash-indeling, die Obscure nog niet ondersteunt."

#: crates/obscure-app/src/humanize.rs:63
msgid "Tunnel mode is not possible here: the engine is stored on a filesystem that ignores permissions (nosuid)."
