#: data/io.github.talesam.Obscure.desktop.in.in:2
#: data/io.github.talesam.Obscure.metainfo.xml.in.in:7
#: crates/obscure-app/src/ui/window.blp:5
msgid "Obscure"
msgstr "Obscure"

#. Translators: short description shown next to the app name in menus
#: data/io.github.talesam.Obscure.desktop.in.in:4
msgid "Proxy Client"
msgstr "Прокси-клиент"

#. Translators: the slogan of the app
#: data/io.github.talesam.Obscure.desktop.in.in:6
#: crates/obscure-app/src/ui/window.blp:38
#: crates/obscure-app/src/application.rs:460
msgid "Connect. That's it."
msgstr "Подключайтесь. И всё."

#. Translators: search terms, keep the trailing semicolon and add local words
#: data/io.github.talesam.Obscure.desktop.in.in:16
msgid "proxy;vpn;xray;vless;vmess;trojan;shadowsocks;wireguard;privacy;censorship;"
msgstr ""
"proxy;vpn;xray;vless;vmess;trojan;shadowsocks;wireguard;приватность;цензура;подключение;обход "
"блокировок;"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:8
msgid "Connect to your proxy with one button"
msgstr "Подключитесь к своему прокси одной кнопкой"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:10
msgid ""
"Obscure is a simple client for the Xray-core engine. Paste a link or a "
"subscription, tap Connect and you are done."
msgstr ""
"Obscure — простой клиент для движка Xray-core. Вставьте ссылку или подписку, "
"нажмите «Подключиться» — и готово."

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:14
msgid "Features:"
msgstr "Возможности:"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:16
msgid "One Connect button, no technical terms on the main screen"
msgstr "Одна кнопка «Подключиться», без технических терминов на главном экране"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:17
msgid ""
"Imports vless, vmess, trojan and shadowsocks links, as well as subscriptions"
msgstr "Импорт ссылок vless, vmess, trojan и shadowsocks, а также подписок"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:18
msgid "Applies the system proxy on GNOME and KDE, no root required"
msgstr "Настройка системного прокси в GNOME и KDE без прав root"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:19
msgid "Downloads and updates Xray-core automatically, with integrity checks"
msgstr "Автоматическая загрузка и обновление Xray-core с проверкой целостности"

#: data/io.github.talesam.Obscure.metainfo.xml.in.in:49
msgid "Initial project skeleton."
msgstr "Начальный каркас проекта."

#: data/io.github.talesam.Obscure.gschema.xml.in:6
msgid "Window width"
msgstr "Ширина окна"

#: data/io.github.talesam.Obscure.gschema.xml.in:10
msgid "Window height"
msgstr "Высота окна"

#: data/io.github.talesam.Obscure.gschema.xml.in:14
msgid "Whether the window is maximized"
msgstr "Развёрнуто ли окно"

#: data/io.github.talesam.Obscure.gschema.xml.in:18
msgid "Keep running in the tray when the window is closed"
msgstr "Оставаться в трее при закрытии окна"

#: data/io.github.talesam.Obscure.gschema.xml.in:22
msgid "Start with the session (via the Background portal)"
msgstr "Запускать вместе с сеансом (через портал Background)"

#: data/io.github.talesam.Obscure.gschema.xml.in:26
msgid "Register a system-wide shortcut through the GlobalShortcuts portal"
msgstr ""
"Зарегистрировать глобальную комбинацию клавиш через портал GlobalShortcuts"

#: data/io.github.talesam.Obscure.gschema.xml.in:30
msgid "Connect automatically when the app starts"
msgstr "Подключаться автоматически при запуске приложения"

#: crates/obscure-app/src/ui/window.blp:17
#: crates/obscure-app/src/ui/window.blp:51
#: crates/obscure-app/src/ui/import-dialog.blp:5
msgid "Add Server"
msgstr "Добавить сервер"

#: crates/obscure-app/src/ui/window.blp:24
msgid "Main Menu"
msgstr "Главное меню"

#: crates/obscure-app/src/ui/window.blp:39
msgid "Paste a link or a subscription to get started."
msgstr "Вставьте ссылку или подписку, чтобы начать."

#: crates/obscure-app/src/ui/window.blp:152
#: crates/obscure-app/src/window.rs:587 crates/obscure-app/src/tray.rs:83
msgid "Connect"
msgstr "Подключиться"

#: crates/obscure-app/src/ui/window.blp:164
msgid "How to apply"
msgstr "Способ применения"

#: crates/obscure-app/src/ui/window.blp:172
msgid "System proxy"
msgstr "Системный прокси"

#: crates/obscure-app/src/ui/window.blp:173
msgid ""
"Browsers and most apps use the connection. No administrator password needed."
msgstr ""
"Браузеры и большинство приложений будут использовать подключение. Пароль "
"администратора не нужен."

#: crates/obscure-app/src/ui/window.blp:178
msgid "Local proxy only"
msgstr "Только локальный прокси"

#: crates/obscure-app/src/ui/window.blp:179
msgid ""
"Nothing changes on the system. Point the programs you want at 127.0.0.1:2080."
msgstr ""
"В системе ничего не меняется. Укажите нужным программам адрес 127.0.0.1:2080."

#: crates/obscure-app/src/ui/window.blp:184
msgid "Tunnel"
msgstr "Туннель"

#: crates/obscure-app/src/ui/window.blp:185
msgid "All traffic from this computer, every app. Asks for your password once."
msgstr "Весь трафик этого компьютера, все приложения. Один раз спросит пароль."

#: crates/obscure-app/src/ui/window.blp:191
msgid "What goes through the connection"
msgstr "Что идёт через подключение"

#: crates/obscure-app/src/ui/window.blp:199
msgid "Smart"
msgstr "Умный режим"

#: crates/obscure-app/src/ui/window.blp:200
msgid "Everything, except local network addresses. Ads are blocked."
msgstr "Всё, кроме адресов локальной сети. Реклама блокируется."

#: crates/obscure-app/src/ui/window.blp:205
msgid "Everything"
msgstr "Всё"

#: crates/obscure-app/src/ui/window.blp:206
msgid ""
"All traffic goes through the connection, except local network addresses."
msgstr "Весь трафик идёт через подключение, кроме адресов локальной сети."

#: crates/obscure-app/src/ui/window.blp:212
msgid "Subscriptions"
msgstr "Подписки"

#: crates/obscure-app/src/ui/window.blp:225
msgid "Servers"
msgstr "Серверы"

#: crates/obscure-app/src/ui/window.blp:234
msgid "Automatic"
msgstr "Автоматически"

#: crates/obscure-app/src/ui/window.blp:235
msgid "Tests all servers when you connect and picks the quickest one."
msgstr "При подключении проверяет все серверы и выбирает самый быстрый."

#: crates/obscure-app/src/ui/window.blp:245
msgid "Automatic: fastest server"
msgstr "Автоматически: самый быстрый сервер"

#: crates/obscure-app/src/ui/window.blp:251
msgid "Measure the response time of every server"
msgstr "Измерить время отклика всех серверов"

#: crates/obscure-app/src/ui/window.blp:256
msgid "Test All"
msgstr "Проверить все"

#: crates/obscure-app/src/ui/window.blp:286
msgid "_Import from File…"
msgstr "_Импортировать из файла…"

#: crates/obscure-app/src/ui/window.blp:291
msgid "_Live Connections"
msgstr "_Подключения в реальном времени"

#: crates/obscure-app/src/ui/window.blp:296
msgid "_Connection Log"
msgstr "_Журнал подключения"

#: crates/obscure-app/src/ui/window.blp:301
msgid "_Copy Environment Variables"
msgstr "_Копировать переменные окружения"

#: crates/obscure-app/src/ui/window.blp:308
msgid "_Preferences"
msgstr "_Параметры"

#: crates/obscure-app/src/ui/window.blp:313
msgid "_Keyboard Shortcuts"
msgstr "_Комбинации клавиш"

#: crates/obscure-app/src/ui/window.blp:318
msgid "_About Obscure"
msgstr "_О приложении Obscure"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:6
#: crates/obscure-app/src/ui/preferences-dialog.blp:10
msgid "General"
msgstr "Общие"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:9
#: crates/obscure-app/src/ui/preferences-dialog.blp:5
msgid "Preferences"
msgstr "Параметры"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:14
msgid "Keyboard Shortcuts"
msgstr "Комбинации клавиш"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:19
#: crates/obscure-app/src/ui/connections-dialog.blp:5
msgid "Live Connections"
msgstr "Подключения в реальном времени"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:24
msgid "Close Window"
msgstr "Закрыть окно"

#: crates/obscure-app/src/ui/shortcuts-dialog.blp:29
#: crates/obscure-app/src/tray.rs:101
msgid "Quit"
msgstr "Выйти"

#: crates/obscure-app/src/ui/preferences-dialog.blp:14
msgid "Behavior"
msgstr "Поведение"

#: crates/obscure-app/src/ui/preferences-dialog.blp:17
msgid "Keep running in the background"
msgstr "Продолжать работу в фоне"

#: crates/obscure-app/src/ui/preferences-dialog.blp:18
msgid "Closing the window leaves Obscure in the tray, still connected."
msgstr "При закрытии окна Obscure остаётся в трее и продолжает работать."

#: crates/obscure-app/src/ui/preferences-dialog.blp:22
msgid "Start with the session"
msgstr "Запускать вместе с сеансом"

#: crates/obscure-app/src/ui/preferences-dialog.blp:23
msgid "Obscure opens in the tray when you log in."
msgstr "Obscure открывается в трее при входе в систему."

#: crates/obscure-app/src/ui/preferences-dialog.blp:27
msgid "Connect when Obscure starts"
msgstr "Подключаться при запуске Obscure"

#: crates/obscure-app/src/ui/preferences-dialog.blp:32
msgid "Connection"
msgstr "Подключение"

#: crates/obscure-app/src/ui/preferences-dialog.blp:33
msgid ""
"Changes apply the next time you connect. If you are connected now, Obscure "
"reconnects."
msgstr ""
"Изменения вступят в силу при следующем подключении. Если вы подключены "
"сейчас, Obscure переподключится."

#: crates/obscure-app/src/ui/preferences-dialog.blp:36
msgid "Local port"
msgstr "Локальный порт"

#: crates/obscure-app/src/ui/preferences-dialog.blp:37
msgid "Where programs on this computer reach the connection."
msgstr "Где программы на этом компьютере находят подключение."

#: crates/obscure-app/src/ui/preferences-dialog.blp:49
msgid "DNS server (DNS over HTTPS)"
msgstr "DNS-сервер (DNS через HTTPS)"

#: crates/obscure-app/src/ui/preferences-dialog.blp:56
msgid "Advanced"
msgstr "Дополнительно"

#: crates/obscure-app/src/ui/preferences-dialog.blp:60
msgid "Shortcut"
msgstr "Комбинация клавиш"

#: crates/obscure-app/src/ui/preferences-dialog.blp:63
msgid "System-wide shortcut to connect or disconnect"
msgstr "Глобальная комбинация клавиш для подключения и отключения"

#: crates/obscure-app/src/ui/preferences-dialog.blp:64
msgid "Works even when Obscure is hidden. The system lets you choose the keys."
msgstr "Работает, даже когда Obscure скрыт. Клавиши выбираются в системе."

#: crates/obscure-app/src/ui/preferences-dialog.blp:69
msgid "Route rules"
msgstr "Правила маршрутизации"

#: crates/obscure-app/src/ui/preferences-dialog.blp:70
msgid ""
"Your rules win over the preset. Use a domain (example.com), an address "
"(10.0.0.0/8) or a category (geosite:netflix)."
msgstr ""
"Ваши правила важнее предустановки. Укажите домен (example.com), адрес "
"(10.0.0.0/8) или категорию (geosite:netflix)."

#: crates/obscure-app/src/ui/preferences-dialog.blp:75
msgid "Add rule"
msgstr "Добавить правило"

#: crates/obscure-app/src/ui/preferences-dialog.blp:94
msgid "Engine configuration"
msgstr "Конфигурация движка"

#: crates/obscure-app/src/ui/preferences-dialog.blp:97
msgid "Edit the engine configuration"
msgstr "Изменить конфигурацию движка"

#: crates/obscure-app/src/ui/preferences-dialog.blp:98
msgid "See or replace the JSON that Obscure sends to Xray."
msgstr "Посмотреть или заменить JSON, который Obscure передаёт Xray."

#: crates/obscure-app/src/ui/import-dialog.blp:17
#: crates/obscure-app/src/window.rs:550 crates/obscure-app/src/window.rs:579
#: crates/obscure-app/src/window.rs:691
#: crates/obscure-app/src/preferences_dialog.rs:234
msgid "Cancel"
msgstr "Отмена"

#: crates/obscure-app/src/ui/import-dialog.blp:23
#: crates/obscure-app/src/preferences_dialog.rs:234
msgid "Add"
msgstr "Добавить"

#: crates/obscure-app/src/ui/import-dialog.blp:42
msgid "Paste server links (one per line) or the address of your subscription."
msgstr "Вставьте ссылки на серверы (по одной в строке) или адрес подписки."

#: crates/obscure-app/src/ui/import-dialog.blp:79
msgid "Paste"
msgstr "Вставить"

#: crates/obscure-app/src/ui/import-dialog.blp:84
msgid "Read a QR code from an image file"
msgstr "Прочитать QR-код из файла изображения"

#: crates/obscure-app/src/ui/import-dialog.blp:89
msgid "QR from Image"
msgstr "QR из изображения"

#: crates/obscure-app/src/ui/import-dialog.blp:94
msgid "Take a screenshot and read the QR code in it"
msgstr "Сделать снимок экрана и прочитать QR-код на нём"

#: crates/obscure-app/src/ui/import-dialog.blp:99
msgid "QR from Screen"
msgstr "QR с экрана"

#: crates/obscure-app/src/application.rs:111
msgid "The system proxy settings from a previous session were restored."
msgstr "Настройки системного прокси из предыдущего сеанса восстановлены."

#. Translators: replace with your name and, optionally, e-mail.
#: crates/obscure-app/src/application.rs:457
msgid "translator-credits"
msgstr ""

#: crates/obscure-app/src/application.rs:461
